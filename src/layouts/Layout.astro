---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  preloadImage?: string;
}

const {
  title = 'Mukesh Weds Puja | Wedding Invitation',
  description = 'With divine blessings and ancestral grace, you are cordially invited to the Royal Wedding of Mukesh Ojha & Puja on 11th December 2026 at Ojhadih.',
  image = '/og-image.jpg',
  preloadImage,
} = Astro.props;

const siteUrl = 'https://mukeshwedspuja.com';
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FAF6F0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Mukesh Weds Puja, Mukesh Ojha Wedding, Royal Indian Wedding, Wedding Invitation, Bokaro Wedding, MukeshWedsPuja" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Mukesh Weds Puja" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${image}`} />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Event",
        "name": "Royal Wedding of Mukesh Ojha & Puja",
        "startDate": "2026-12-11T19:00:00+05:30",
        "endDate": "2026-12-12T02:00:00+05:30",
        "location": {
          "@type": "Place",
          "name": "Grand Rajwada Mandap, Ojhadih",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Ojhadih",
            "addressLocality": "Bokaro",
            "addressRegion": "Jharkhand",
            "postalCode": "828404",
            "addressCountry": "IN"
          }
        },
        "description": "The Royal Wedding of Mukesh Ojha & Puja",
        "hashtag": "#MukeshWedsPuja"
      }
    </script>

    <!-- Lean & Optimized Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500;600&family=Noto+Serif+Devanagari:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <slot name="head" />
  </head>
  <body class="film-grain vignette bg-[#FAF6F0] text-[#2C221A] min-h-screen overflow-x-hidden">
    <!-- Custom Cursor (Desktop fine-pointer only) -->
    <div id="cursor-dot"></div>
    <div id="cursor-ring"></div>

    <!-- Scroll Progress Bar -->
    <div id="scroll-progress" style="width: 0%"></div>

    <slot />

    <!-- Global Scripts -->
    <script>
      import { royalAudio } from '../lib/audio';

      const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      // Custom Cursor - ONLY activated on fine-pointer devices (no mobile waste)
      if (isFinePointer) {
        const dot = document.getElementById('cursor-dot');
        const ring = document.getElementById('cursor-ring');
        let mouseX = -100, mouseY = -100;
        let ringX = -100, ringY = -100;
        let ringRafId: number | null = null;
        let isCursorActive = true;

        document.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
          if (dot) {
            dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0) translate(-50%, -50%)`;
          }
        }, { passive: true });

        // Smooth ring follow with requestAnimationFrame using transform3d
        function animateRing() {
          if (!isCursorActive) return;
          ringX += (mouseX - ringX) * 0.16;
          ringY += (mouseY - ringY) * 0.16;
          if (ring) {
            ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0) translate(-50%, -50%)`;
          }
          ringRafId = requestAnimationFrame(animateRing);
        }
        ringRafId = requestAnimationFrame(animateRing);

        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            isCursorActive = false;
            if (ringRafId) cancelAnimationFrame(ringRafId);
          } else {
            isCursorActive = true;
            ringRafId = requestAnimationFrame(animateRing);
          }
        });

        // Expand cursor on interactive hover
        const interactiveElements = 'a, button, input, textarea, select, .event-card, .couple-card, .flip-clock-card, .ritual-card';
        document.querySelectorAll(interactiveElements).forEach(el => {
          el.addEventListener('mouseenter', () => {
            if (ring) {
              ring.style.width = '54px';
              ring.style.height = '54px';
              ring.style.borderColor = '#C59437';
              ring.style.backgroundColor = 'rgba(197, 148, 55, 0.12)';
              ring.style.boxShadow = '0 0 25px rgba(197, 148, 55, 0.35)';
            }
          }, { passive: true });
          el.addEventListener('mouseleave', () => {
            if (ring) {
              ring.style.width = '36px';
              ring.style.height = '36px';
              ring.style.borderColor = 'rgba(197, 148, 55, 0.5)';
              ring.style.backgroundColor = 'transparent';
              ring.style.boxShadow = 'none';
            }
          }, { passive: true });
        });
      }

      // Scroll Progress - throttled to rAF, passive listener
      const progressBar = document.getElementById('scroll-progress');
      if (progressBar) {
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(() => {
              const scrollTop = window.scrollY;
              const docHeight = document.documentElement.scrollHeight - window.innerHeight;
              if (docHeight > 0) {
                const pct = Math.min(100, Math.max(0, (scrollTop / docHeight) * 100));
                progressBar.style.width = pct + '%';
              }
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });
      }

      // Ripple effect on buttons + golden chime sound
      document.querySelectorAll('.ripple-btn, button, .magnetic-btn').forEach(btn => {
        btn.addEventListener('click', function(e: Event) {
          royalAudio.playClickSound();

          const mouseEvent = e as MouseEvent;
          const el = this as HTMLElement;
          const ripple = document.createElement('span');
          const rect = el.getBoundingClientRect();
          const size = Math.max(rect.width, rect.height);
          ripple.style.cssText = `
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,0.28);
            width: ${size}px;
            height: ${size}px;
            left: ${mouseEvent.clientX - rect.left - size/2}px;
            top: ${mouseEvent.clientY - rect.top - size/2}px;
            transform: scale(0);
            animation: ripple 0.6s linear;
            pointer-events: none;
          `;
          el.appendChild(ripple);
          setTimeout(() => ripple.remove(), 700);
        });
      });

      // Magnetic buttons - fine pointer only with rAF throttle
      if (isFinePointer) {
        document.querySelectorAll('.magnetic-btn').forEach(el => {
          const htmlEl = el as HTMLElement;
          let magRaf: number | null = null;
          htmlEl.addEventListener('mousemove', (e: Event) => {
            const mouseEvent = e as MouseEvent;
            if (magRaf) cancelAnimationFrame(magRaf);
            magRaf = requestAnimationFrame(() => {
              const rect = htmlEl.getBoundingClientRect();
              const x = mouseEvent.clientX - rect.left - rect.width / 2;
              const y = mouseEvent.clientY - rect.top - rect.height / 2;
              htmlEl.style.transform = `translate(${x * 0.25}px, ${y * 0.25}px)`;
            });
          }, { passive: true });
          htmlEl.addEventListener('mouseleave', () => {
            if (magRaf) cancelAnimationFrame(magRaf);
            htmlEl.style.transform = '';
          });
        });
      }
    </script>
  </body>
</html>
