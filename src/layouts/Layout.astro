---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  preloadImage?: string;
}

const {
  title = 'Mukesh Weds Puja | Wedding Invitation',
  description = 'With divine blessings and ancestral grace, you are cordially invited to the Royal Wedding of Mukesh Ojha & Puja.',
  image = 'https://invifestx16.vercel.app/invitation.jpg',
  preloadImage,
} = Astro.props;

const siteUrl = 'https://invifestx16.vercel.app';
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        var isTouch = window.matchMedia('(max-width: 768px)').matches || ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
        if (isTouch) document.documentElement.classList.add('mobile-touch');
        // Only enable lite mode on truly low-end devices where values are explicitly reported low
        var hc = navigator.hardwareConcurrency;
        var dm = navigator.deviceMemory;
        if ((hc && hc <= 2) || (dm && dm <= 1)) {
          document.documentElement.classList.add('lite');
        }
      } catch (e) {}
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FAF6F0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Mukesh Weds Puja, Mukesh Ojha Wedding, Royal Indian Wedding, Wedding Invitation, Bokaro Wedding, MukeshWedsPuja" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://invifestx16.vercel.app" />
    <meta property="og:title" content="Mukesh Weds Puja | Wedding Invitation" />
    <meta property="og:description" content="With divine blessings and ancestral grace, you are cordially invited to the Royal Wedding of Mukesh Ojha & Puja." />
    <meta property="og:image" content="https://invifestx16.vercel.app/invitation.jpg" />
    <meta property="og:image:secure_url" content="https://invifestx16.vercel.app/invitation.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="864" />
    <meta property="og:image:height" content="1152" />
    <meta property="og:image:alt" content="Mukesh Weds Puja Wedding Invitation" />
    <meta property="og:site_name" content="Mukesh Weds Puja" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Mukesh Weds Puja | Wedding Invitation" />
    <meta name="twitter:description" content="With divine blessings and ancestral grace, you are cordially invited to the Royal Wedding of Mukesh Ojha & Puja." />
    <meta name="twitter:image" content="https://invifestx16.vercel.app/invitation.jpg" />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Event",
        "name": "Royal Wedding of Mukesh Ojha & Puja",
        "startDate": "2026-12-11T20:00:00+05:30",
        "endDate": "2026-12-12T02:00:00+05:30",
        "location": {
          "@type": "Place",
          "name": "Ojhadih, Bokaro",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Ojhadih",
            "addressLocality": "Bokaro",
            "addressRegion": "Jharkhand",
            "postalCode": "828404",
            "addressCountry": "IN"
          }
        },
        "description": "The Royal Wedding of Mukesh Ojha & Puja",
        "hashtag": "#MukeshWedsPuja"
      }
    </script>

    <!-- Self-Hosted Optimized Fonts (Zero external DNS / network blocking) -->
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="preload" href="/fonts/font_10.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/font_8.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/font_2.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <slot name="head" />
  </head>
  <body class="film-grain vignette bg-[#FAF6F0] text-[#2C221A] min-h-screen overflow-x-hidden">
    <!-- Scroll Progress Bar -->
    <div id="scroll-progress" style="width: 0%"></div>

    <slot />

    <!-- Global Scripts -->
    <script>
      const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      // Scroll Progress - throttled to rAF, cached height, scaleX transform (0 reflow)
      const progressBar = document.getElementById('scroll-progress');
      if (progressBar) {
        let ticking = false;
        let cachedDocHeight = document.documentElement.scrollHeight - window.innerHeight;

        const updateDocHeight = () => {
          cachedDocHeight = document.documentElement.scrollHeight - window.innerHeight;
        };
        window.addEventListener('resize', updateDocHeight, { passive: true });

        const updateProgress = () => {
          const scrollTop = window.scrollY || window.pageYOffset || 0;
          if (cachedDocHeight > 0) {
            const progress = Math.min(1, Math.max(0, scrollTop / cachedDocHeight));
            progressBar.style.transform = `scaleX(${progress})`;
          }
          ticking = false;
        };

        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(updateProgress);
            ticking = true;
          }
        }, { passive: true });
        updateProgress();
      }

      // Delegated Tap-Ripple & Press Feedback for buttons & CTAs
      document.body.addEventListener('pointerdown', (e: PointerEvent) => {
        const target = (e.target as HTMLElement).closest('button, .card-cta, .ripple-btn') as HTMLElement | null;
        if (!target) return;
        // Skip for rituals control bar & couple cards to maintain zero tap latency and clean gestures
        if (target.closest('.rituals-control-bar, .portrait-interactive-wrap, [data-couple-toggle]')) return;

        // Subtle press feedback
        target.classList.add('tap-pressed');
        const cleanupPress = () => {
          target.classList.remove('tap-pressed');
          window.removeEventListener('pointerup', cleanupPress);
          window.removeEventListener('pointercancel', cleanupPress);
        };
        window.addEventListener('pointerup', cleanupPress, { once: true });
        window.addEventListener('pointercancel', cleanupPress, { once: true });

        // Ripple spawn
        const rect = target.getBoundingClientRect();
        const size = Math.max(rect.width, rect.height) * 1.5;
        const x = e.clientX - rect.left - size / 2;
        const y = e.clientY - rect.top - size / 2;

        const ripple = document.createElement('span');
        ripple.className = 'touch-tap-ripple';
        ripple.style.width = `${size}px`;
        ripple.style.height = `${size}px`;
        ripple.style.left = `${x}px`;
        ripple.style.top = `${y}px`;
        target.appendChild(ripple);

        ripple.addEventListener('animationend', () => ripple.remove(), { once: true });
        setTimeout(() => ripple.remove(), 600);
      }, { passive: true });

      // Shared Scroll-Reveal Helper (data-reveal="up|left|right|zoom")
      const revealElements = document.querySelectorAll('[data-reveal]');
      if (revealElements.length > 0) {
        const revealObserver = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              const delay = el.getAttribute('data-delay') || '0';
              setTimeout(() => {
                el.classList.add('is-revealed');
              }, parseFloat(delay) * 1000);
              obs.unobserve(el);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

        revealElements.forEach(el => revealObserver.observe(el));
      }

      // ── SCROLL-TRIGGERED TEXT REVEAL HELPER ─────────────────────────
      function initTextReveal() {
        const textElements = document.querySelectorAll<HTMLElement>('[data-text-reveal]');
        if (!textElements.length) return;

        textElements.forEach((el) => {
          if (el.dataset.textRevealInit === 'true') return;
          el.dataset.textRevealInit = 'true';

          const originalText = el.textContent?.trim() || '';
          if (!el.getAttribute('aria-label')) {
            el.setAttribute('aria-label', originalText);
          }

          const baseDelay = parseFloat(el.getAttribute('data-text-delay') || '0');
          const stagger = parseFloat(el.getAttribute('data-text-stagger') || '0.045');

          let wordIndex = 0;
          function processNode(node: Node) {
            if (node.nodeType === Node.TEXT_NODE) {
              const text = node.textContent || '';
              if (!text.trim()) return;

              const chunks = text.split(/(\s+)/);
              const frag = document.createDocumentFragment();

              chunks.forEach((chunk) => {
                if (/^\s+$/.test(chunk)) {
                  frag.appendChild(document.createTextNode(chunk));
                } else if (chunk) {
                  const wordSpan = document.createElement('span');
                  wordSpan.className = 'reveal-word';
                  wordSpan.setAttribute('aria-hidden', 'true');

                  const innerSpan = document.createElement('span');
                  innerSpan.className = 'reveal-inner';
                  innerSpan.style.transitionDelay = `${(baseDelay + wordIndex * stagger).toFixed(3)}s`;
                  innerSpan.textContent = chunk;

                  wordSpan.appendChild(innerSpan);
                  frag.appendChild(wordSpan);
                  wordIndex++;
                }
              });

              node.parentNode?.replaceChild(frag, node);
            } else if (node.nodeType === Node.ELEMENT_NODE) {
              const childEl = node as HTMLElement;
              if (childEl.classList.contains('reveal-word') || childEl.classList.contains('reveal-inner')) return;
              Array.from(childEl.childNodes).forEach(processNode);
            }
          }

          Array.from(el.childNodes).forEach(processNode);
        });

        if ('IntersectionObserver' in window) {
          const textObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-text-revealed');
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });

          textElements.forEach((el) => textObserver.observe(el));
        } else {
          textElements.forEach((el) => el.classList.add('is-text-revealed'));
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTextReveal);
      } else {
        initTextReveal();
      }
      document.addEventListener('astro:page-load', initTextReveal);

      // Magnetic buttons - fine pointer only with cached rect on enter
      if (isFinePointer) {
        document.querySelectorAll('.magnetic-btn').forEach(el => {
          const htmlEl = el as HTMLElement;
          let magRaf: number | null = null;
          let cachedRect: DOMRect | null = null;

          htmlEl.addEventListener('mouseenter', () => {
            cachedRect = htmlEl.getBoundingClientRect();
          }, { passive: true });

          htmlEl.addEventListener('mousemove', (e: Event) => {
            const mouseEvent = e as MouseEvent;
            if (magRaf) cancelAnimationFrame(magRaf);
            magRaf = requestAnimationFrame(() => {
              const rect = cachedRect || htmlEl.getBoundingClientRect();
              const x = mouseEvent.clientX - rect.left - rect.width / 2;
              const y = mouseEvent.clientY - rect.top - rect.height / 2;
              htmlEl.style.transform = `translate(${x * 0.25}px, ${y * 0.25}px)`;
            });
          }, { passive: true });

          htmlEl.addEventListener('mouseleave', () => {
            if (magRaf) cancelAnimationFrame(magRaf);
            cachedRect = null;
            htmlEl.style.transform = '';
          });
        });
      }
    </script>
  </body>
</html>
