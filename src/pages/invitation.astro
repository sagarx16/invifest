---
// src/pages/invitation.astro
// Premium Gatefold Wedding Invitation Card for Mukesh Ojha & Puja
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <title>Mukesh & Puja — Royal Wedding Invitation</title>
    <meta name="description" content="You are cordially invited to celebrate the sacred union of Mukesh Ojha & Puja on 11th December 2026 at Dugda & Ojhadih, Bokaro." />
    
    <!-- Open Graph -->
    <meta property="og:title" content="Mukesh & Puja — Royal Wedding Invitation" />
    <meta property="og:description" content="Two souls, one journey. Join us to celebrate our wedding on 11th December 2026." />
    <meta property="og:image" content="/invitation/inside.jpg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://invifestx16.vercel.app/invitation" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Self-hosted local fonts stylesheet -->
    <link rel="stylesheet" href="/fonts/fonts.css" />

    <style>
      :root {
        --pearl-blush: #f4ded5;
        --pearl-blush-dark: #e5c3b6;
        --rose-gold-light: #f1bfae;
        --rose-gold: #c9826e;
        --rose-gold-dark: #9f5b49;
        --gold-foil: #c9a24b;
        --gold-foil-light: #ecd58a;
        --deep-maroon: #5a1a24;
        --cream-paper: #fffbf5;
        --cream-border: #f0e6d6;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        -webkit-tap-highlight-color: transparent;
      }

      body {
        min-height: 100vh;
        background: radial-gradient(circle at 50% 25%, #faf0ea 0%, #f4e2d8 50%, #e9cebe 100%);
        font-family: 'Montserrat', sans-serif;
        color: #3d2b24;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 24px 16px 120px;
        overflow-x: hidden;
      }

      /* Subtle paper grain texture */
      .paper-shimmer {
        background-image: 
          radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.4) 0%, transparent 40%),
          linear-gradient(135deg, rgba(255, 255, 255, 0.25) 0%, rgba(210, 160, 145, 0.15) 100%);
      }

      /* 3D Gatefold Card Container */
      .card-stage {
        perspective: 1600px;
        width: 100%;
        max-width: 480px;
        margin: 16px auto 0;
        position: relative;
      }

      .invitation-card {
        position: relative;
        width: 100%;
        min-height: 840px;
        background: var(--cream-paper);
        border-radius: 20px;
        box-shadow: 
          0 24px 60px -12px rgba(100, 50, 40, 0.22),
          0 8px 24px -4px rgba(100, 50, 40, 0.1),
          0 0 0 1px rgba(201, 162, 75, 0.2);
        transform-style: preserve-3d;
        overflow: visible;
        transition: box-shadow 0.6s ease;
      }

      /* INSIDE SPREAD */
      .inside-spread {
        position: relative;
        width: 100%;
        min-height: 840px;
        background: #fffbf5;
        border-radius: 20px;
        padding: 28px 22px 100px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        overflow: hidden;
        z-index: 1;
      }

      /* Floral frame border styling */
      .floral-frame-svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 0;
      }

      .spread-content {
        position: relative;
        z-index: 2;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      /* GATEFOLD FLAPS */
      .flap {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 53%;
        height: 100%;
        z-index: 20;
        transform-style: preserve-3d;
        transition: transform 1.35s cubic-bezier(0.22, 1, 0.36, 1);
        pointer-events: auto;
      }

      .flap-left {
        left: 0;
        transform-origin: left center;
        filter: drop-shadow(4px 4px 12px rgba(90, 40, 30, 0.18));
      }

      .flap-right {
        right: 0;
        transform-origin: right center;
        filter: drop-shadow(-4px 4px 12px rgba(90, 40, 30, 0.18));
      }

      /* Flap Face Texture */
      .flap-face {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #f7e6dc 0%, #ebd0c4 50%, #dfbeaf 100%);
        border: 1px solid rgba(255, 255, 255, 0.6);
        position: relative;
        overflow: hidden;
      }

      /* Petal Curves via SVG clipPath */
      .flap-left .flap-face {
        clip-path: url(#flap-left-clip);
        -webkit-clip-path: url(#flap-left-clip);
      }

      .flap-right .flap-face {
        clip-path: url(#flap-right-clip);
        -webkit-clip-path: url(#flap-right-clip);
      }

      /* Pearl Paper Foil Sheen */
      .pearl-sheen {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          45deg,
          transparent 0%,
          rgba(255, 255, 255, 0.4) 45%,
          rgba(255, 255, 255, 0.7) 50%,
          rgba(255, 255, 255, 0.4) 55%,
          transparent 100%
        );
        opacity: 0.6;
        pointer-events: none;
      }

      /* RIBBON & BOW WRAPPER */
      .ribbon-wrapper {
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        transform: translateY(-50%);
        z-index: 30;
        pointer-events: auto;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: opacity 0.8s ease, transform 0.8s ease;
      }

      .ribbon-bar-container {
        width: 100%;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .ribbon-band {
        width: 100%;
        height: 52px;
        background: linear-gradient(
          180deg,
          #e8b6a7 0%,
          #f8d2c4 22%,
          #c9826e 50%,
          #9c5442 80%,
          #b76e5a 100%
        );
        box-shadow: 
          0 8px 24px rgba(90, 30, 20, 0.35),
          inset 0 1.5px 2px rgba(255, 255, 255, 0.7),
          inset 0 -1.5px 2px rgba(0, 0, 0, 0.3);
        position: relative;
      }

      .ribbon-band::before,
      .ribbon-band::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        height: 1.5px;
        background: rgba(255, 255, 255, 0.55);
      }
      .ribbon-band::before { top: 2px; }
      .ribbon-band::after { bottom: 2px; }

      /* Satin Bow SVG */
      .bow-svg {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 270px;
        height: 210px;
        filter: drop-shadow(0 14px 22px rgba(70, 20, 15, 0.45));
        pointer-events: none;
      }

      /* Gold Monogram Seal on Bow */
      .bow-monogram-tag {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background: radial-gradient(circle at 35% 30%, #ffefa6 0%, #c9a24b 60%, #8c6720 100%);
        box-shadow: 
          0 4px 14px rgba(0, 0, 0, 0.35),
          inset 0 1px 3px rgba(255, 255, 255, 0.8),
          inset 0 -1px 2px rgba(0, 0, 0, 0.4);
        border: 1.5px solid rgba(255, 255, 255, 0.75);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Great Vibes', cursive;
        color: #4a1506;
        font-size: 21px;
        font-weight: bold;
        z-index: 35;
        pointer-events: none;
      }

      /* Tap to Open Pill */
      .tap-pill {
        margin-top: 100px;
        background: rgba(255, 251, 245, 0.95);
        border: 1px solid rgba(201, 162, 75, 0.5);
        color: #8c4a35;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        padding: 8px 20px;
        border-radius: 999px;
        box-shadow: 0 4px 16px rgba(100, 40, 30, 0.15);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        animation: pulsePill 2.2s infinite ease-in-out;
        pointer-events: auto;
      }

      @keyframes pulsePill {
        0%, 100% { transform: scale(1); box-shadow: 0 4px 16px rgba(100, 40, 30, 0.15); }
        50% { transform: scale(1.05); box-shadow: 0 6px 22px rgba(201, 162, 75, 0.35); }
      }

      /* OPEN STATE */
      .is-open .flap-left {
        transform: rotateY(-110deg);
        pointer-events: none;
      }

      .is-open .flap-right {
        transform: rotateY(110deg);
        pointer-events: none;
      }

      .is-open .ribbon-wrapper {
        opacity: 0;
        transform: translateY(-50%) scale(0.92);
        pointer-events: none;
      }

      /* Staggered Fade Up for Spread Elements */
      .stagger-item {
        opacity: 0;
        transform: translateY(14px);
        transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .is-open .stagger-item {
        opacity: 1;
        transform: translateY(0);
      }

      .is-open .stagger-1 { transition-delay: 0.25s; }
      .is-open .stagger-2 { transition-delay: 0.37s; }
      .is-open .stagger-3 { transition-delay: 0.49s; }
      .is-open .stagger-4 { transition-delay: 0.61s; }
      .is-open .stagger-5 { transition-delay: 0.73s; }
      .is-open .stagger-6 { transition-delay: 0.85s; }
      .is-open .stagger-7 { transition-delay: 0.97s; }
      .is-open .stagger-8 { transition-delay: 1.09s; }
      .is-open .stagger-9 { transition-delay: 1.21s; }

      /* PREFERS-REDUCED-MOTION */
      @media (prefers-reduced-motion: reduce) {
        .flap-left { transform: rotateY(-110deg) !important; }
        .flap-right { transform: rotateY(110deg) !important; }
        .ribbon-wrapper { display: none !important; }
        .stagger-item { opacity: 1 !important; transform: none !important; }
      }

      /* TYPOGRAPHY IN SPREAD */
      .ganesh-heading {
        font-family: 'Noto Serif Devanagari', 'Tiro Devanagari Hindi', serif;
        font-size: 15px;
        font-weight: 700;
        color: var(--gold-foil);
        letter-spacing: 0.08em;
        margin-bottom: 8px;
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.8);
      }

      .intro-quote {
        font-family: 'Playfair Display', serif;
        font-style: italic;
        font-size: 12.5px;
        line-height: 1.5;
        color: #7a584a;
        max-width: 320px;
        margin-bottom: 12px;
      }

      .wedding-of-badge {
        font-size: 9.5px;
        font-weight: 600;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: #8c6720;
        margin-bottom: 10px;
        padding: 4px 14px;
        border-top: 1px solid rgba(201, 162, 75, 0.4);
        border-bottom: 1px solid rgba(201, 162, 75, 0.4);
      }

      .couple-name {
        font-family: 'Great Vibes', cursive, serif;
        font-size: clamp(38px, 9vw, 48px);
        line-height: 1.15;
        color: var(--deep-maroon);
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.9);
      }

      .weds-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 4px 0;
      }

      .weds-divider::before,
      .weds-divider::after {
        content: '';
        width: 36px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #c9a24b, transparent);
      }

      .weds-text {
        font-family: 'Great Vibes', cursive;
        font-size: 24px;
        color: var(--gold-foil);
      }

      .parent-info {
        font-size: 11px;
        color: #6e4d41;
        letter-spacing: 0.04em;
        margin-top: 2px;
      }

      .date-block {
        margin: 18px 0 14px;
        padding: 10px 24px;
        background: rgba(247, 222, 213, 0.35);
        border: 1px solid rgba(201, 162, 75, 0.45);
        border-radius: 12px;
      }

      .date-big {
        font-family: 'Cinzel', 'Playfair Display', serif;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 0.22em;
        color: var(--deep-maroon);
      }

      .venue-text {
        font-size: 11.5px;
        font-weight: 500;
        letter-spacing: 0.12em;
        color: #7a503a;
        margin-top: 3px;
        text-transform: uppercase;
      }

      /* Mini Events List */
      .events-mini-card {
        width: 100%;
        max-width: 350px;
        margin: 10px 0 14px;
        padding: 12px 14px;
        background: rgba(255, 255, 255, 0.7);
        border: 1px dashed rgba(201, 162, 75, 0.55);
        border-radius: 12px;
        text-align: left;
      }

      .event-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-bottom: 8px;
      }

      .event-item:last-child {
        margin-bottom: 0;
        border-top: 1px solid rgba(201, 162, 75, 0.25);
        padding-top: 8px;
      }

      .event-title {
        font-family: 'Playfair Display', serif;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--deep-maroon);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .event-tag {
        font-size: 9px;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #8c6720;
        background: rgba(201, 162, 75, 0.12);
        padding: 2px 6px;
        border-radius: 4px;
      }

      .event-meta {
        font-size: 10.5px;
        color: #6a4c41;
        line-height: 1.4;
      }

      .hindi-blessing {
        font-family: 'Noto Serif Devanagari', 'Tiro Devanagari Hindi', serif;
        font-size: 11.5px;
        line-height: 1.6;
        color: #63362a;
        margin: 10px 0 6px;
        max-width: 330px;
      }

      /* QR CODE BLOCK */
      .qr-card-container {
        margin: 14px 0 10px;
        padding: 14px 16px;
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid rgba(201, 162, 75, 0.45);
        box-shadow: 0 4px 18px rgba(100, 40, 30, 0.08);
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .qr-callout-top {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #8c6720;
        margin-bottom: 8px;
      }

      .qr-image-wrap {
        width: 120px;
        height: 120px;
        background: #ffffff;
        padding: 6px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.05);
      }

      .qr-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        image-rendering: pixelated;
        image-rendering: -moz-crisp-edges;
        image-rendering: crisp-edges;
      }

      .qr-callout-bottom {
        font-size: 9.5px;
        font-weight: 500;
        letter-spacing: 0.12em;
        color: #7b594e;
        margin-top: 8px;
      }

      .closing-text {
        font-size: 11px;
        color: #5a382c;
        margin-top: 10px;
        line-height: 1.5;
      }

      .darshan-text {
        font-family: 'Noto Serif Devanagari', 'Tiro Devanagari Hindi', serif;
        font-size: 12px;
        color: #8c5338;
        font-weight: 600;
        margin-top: 4px;
      }

      /* FLOATING BOTTOM ACTION BAR */
      .action-dock {
        position: fixed;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 100;
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255, 251, 245, 0.94);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        padding: 8px 12px;
        border-radius: 999px;
        border: 1px solid rgba(201, 162, 75, 0.45);
        box-shadow: 0 12px 36px rgba(70, 20, 15, 0.25);
        width: max-content;
        max-width: 94vw;
      }

      .dock-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 16px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.25s ease;
        border: none;
        white-space: nowrap;
      }

      .dock-btn-pdf {
        background: linear-gradient(135deg, #c9a24b 0%, #b8860b 100%);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(184, 134, 11, 0.25);
      }
      .dock-btn-pdf:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(184, 134, 11, 0.35);
      }

      .dock-btn-wa {
        background: #25d366;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(37, 211, 102, 0.25);
      }
      .dock-btn-wa:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(37, 211, 102, 0.35);
      }

      .dock-btn-home {
        background: rgba(244, 222, 213, 0.7);
        color: #6e3e30;
        border: 1px solid rgba(201, 162, 75, 0.3);
      }
      .dock-btn-home:hover {
        background: rgba(244, 222, 213, 1);
        transform: translateY(-2px);
      }

      .fold-toggle-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        border: 1px solid rgba(201, 162, 75, 0.4);
        color: #8c6720;
        cursor: pointer;
        transition: transform 0.25s ease;
        font-size: 14px;
      }
      .fold-toggle-btn:hover {
        transform: scale(1.08);
      }

      @media (max-width: 480px) {
        .action-dock {
          gap: 6px;
          padding: 6px 8px;
          bottom: 12px;
          max-width: 96vw;
        }
        .dock-btn {
          padding: 7px 10px;
          font-size: 10px;
          gap: 4px;
        }
        .fold-toggle-btn {
          width: 32px;
          height: 32px;
          font-size: 12px;
        }
        .inside-spread {
          padding: 24px 16px 90px;
        }
        .date-block {
          padding: 8px 16px;
        }
      }
    </style>
  </head>
  <body>
    <!-- SVG Clip Path Definitions for Curved Petal Flaps -->
    <svg width="0" height="0" style="position:absolute; width:0; height:0; pointer-events:none;" aria-hidden="true">
      <defs>
        <clipPath id="flap-left-clip" clipPathUnits="objectBoundingBox">
          <path d="M 0 0 L 0.52 0 C 0.78 0.16, 0.98 0.33, 0.98 0.49 C 0.98 0.65, 0.78 0.82, 0.52 1 L 0 1 Z" />
        </clipPath>
        <clipPath id="flap-right-clip" clipPathUnits="objectBoundingBox">
          <path d="M 1 0 L 0.48 0 C 0.22 0.16, 0.02 0.33, 0.02 0.49 C 0.02 0.65, 0.22 0.82, 0.48 1 L 1 1 Z" />
        </clipPath>
      </defs>
    </svg>

    <!-- Top Breadcrumb / Title Pill -->
    <header style="margin-bottom: 12px; text-align: center;">
      <a href="/" style="text-decoration:none; display:inline-flex; align-items:center; gap:6px; font-size:11px; letter-spacing:0.18em; text-transform:uppercase; color:#8c5338; font-weight:600; background:rgba(255,255,255,0.7); padding:6px 16px; border-radius:999px; border:1px solid rgba(201,162,75,0.35);">
        <span>✦</span>
        <span>Mukesh & Puja · Wedding Invitation</span>
        <span>✦</span>
      </a>
    </header>

    <!-- 3D Gatefold Card Stage -->
    <main class="card-stage">
      <div id="invitation-card" class="invitation-card">
        
        <!-- ================= INSIDE SPREAD ================= -->
        <section class="inside-spread" aria-label="Inside Wedding Invitation Spread">
          
          <!-- Realistic Composed Floral Wreath SVG (Blush roses, white anemones, sage greenery, gold geometric frame) -->
          <svg class="floral-frame-svg" viewBox="0 0 460 840" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <!-- Gold foil gradients -->
              <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#EED58A" />
                <stop offset="50%" stop-color="#C9A24B" />
                <stop offset="100%" stop-color="#916B20" />
              </linearGradient>

              <!-- Botanical floral cluster definition (Blush cabbage rose, white anemone, eucalyptus leaves, gold berries) -->
              <g id="botanical-cluster">
                <!-- Eucalyptus leaves -->
                <path d="M 20 60 C 5 35 12 10 40 20 C 25 32 24 48 20 60 Z" fill="#889E84" opacity="0.85" />
                <path d="M 50 20 C 75 8 95 15 85 42 C 72 26 58 26 50 20 Z" fill="#9FB29B" opacity="0.85" />
                <path d="M 10 80 C -5 55 2 30 30 42 C 16 54 14 70 10 80 Z" fill="#B3C3AF" opacity="0.75" />
                <path d="M 5 90 C -12 65 -5 35 25 50" stroke="#C9A24B" stroke-width="1.2" stroke-linecap="round" fill="none" opacity="0.7" />
                <circle cx="28" cy="18" r="2.5" fill="#D4AF37" />
                <circle cx="78" cy="16" r="2.5" fill="#D4AF37" />
                <circle cx="6" cy="62" r="2.2" fill="#D4AF37" />

                <!-- Blush Garden Cabbage Rose -->
                <g transform="translate(42, 44)">
                  <path d="M -24 -10 C -30 10 -15 28 8 26 C 28 24 32 6 22 -14 C 12 -28 -14 -26 -24 -10 Z" fill="#F4CEC4" filter="drop-shadow(0 2px 5px rgba(90,30,20,0.18))" />
                  <path d="M -18 -8 C -22 6 -10 20 6 18 C 20 16 22 2 15 -10 C 8 -20 -10 -18 -18 -8 Z" fill="#ECAEA0" />
                  <path d="M -12 2 C -15 12 -4 16 8 12 C 16 8 14 -2 6 -8 C -4 -12 -10 -4 -12 2 Z" fill="#DE8B78" />
                  <path d="M -6 -2 C -8 4 0 8 5 5 C 9 2 8 -4 3 -5 C -2 -6 -5 -4 -6 -2 Z" fill="#C56A55" />
