    <!-- Interactive Gatefold Script -->
    <script is:inline>
      (function() {
        const card = document.getElementById('invitation-card');
        const ribbon = document.getElementById('ribbon-wrapper');
        const toggleBtn = document.getElementById('toggle-fold-btn');
        const foldIcon = document.getElementById('fold-icon');

        let isOpen = false;

        function openCard() {
          if (isOpen) return;
          isOpen = true;
          card.classList.add('is-open');
          if (foldIcon) foldIcon.textContent = '📖';
        }

        function closeCard() {
          if (!isOpen) return;
          isOpen = false;
          card.classList.remove('is-open');
          if (foldIcon) foldIcon.textContent = '✉️';
        }

        function toggleCard() {
          if (isOpen) {
            closeCard();
          } else {
            openCard();
          }
        }

        if (ribbon) {
          ribbon.addEventListener('click', openCard);
          ribbon.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              openCard();
            }
          });
        }

        if (toggleBtn) {
          toggleBtn.addEventListener('click', toggleCard);
        }

        // Auto open if URL has #open or ?open=1
        if (window.location.search.includes('open=1') || window.location.hash === '#open') {
          openCard();
        }
      })();
    </script>
