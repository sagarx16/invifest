  let wasPlayingBeforeHidden = false;
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      if (royalAudio.getIsPlaying()) {
        wasPlayingBeforeHidden = true;
        royalAudio.pauseSong((playing) => updateAudioUI(playing));
      }
    } else {
      let isMutedInStorage = false;
      try {
        isMutedInStorage = localStorage.getItem('musicMuted') === 'true';
      } catch (err) {}

      if (wasPlayingBeforeHidden && !userManuallyMuted && !isMutedInStorage) {
        royalAudio.playSong((playing) => updateAudioUI(playing));
      }
      wasPlayingBeforeHidden = false;
