          type="button"
          id="ritual-ctrl-autoplay"
          class="ritual-ctrl-pill inline-flex items-center justify-center gap-1.5 sm:gap-2 px-3.5 sm:px-4 h-11 sm:h-12 rounded-full cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D4AF37] focus-visible:ring-offset-2 select-none"
