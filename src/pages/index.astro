        <circle cx="100" cy="0" r="80" stroke-width="0.8" />
        <circle cx="100" cy="0" r="50" stroke-width="0.6" stroke-dasharray="2 2" />
        <path d="M 100,0 L 30,70 M 100,0 L 20,30 M 100,0 L 70,80" stroke-width="0.5" />
      </svg>
    </div>
    <div class="absolute bottom-4 left-4 w-32 h-32 pointer-events-none opacity-[0.14]" aria-hidden="true">
      <svg viewBox="0 0 100 100" fill="none" stroke="#D4AF37">
        <circle cx="0" cy="100" r="80" stroke-width="0.8" />
        <circle cx="0" cy="100" r="50" stroke-width="0.6" stroke-dasharray="2 2" />
        <path d="M 0,100 L 70,30 M 0,100 L 80,70 M 0,100 L 30,20" stroke-width="0.5" />
      </svg>
    </div>
    <div class="absolute bottom-4 right-4 w-32 h-32 pointer-events-none opacity-[0.14]" aria-hidden="true">
      <svg viewBox="0 0 100 100" fill="none" stroke="#D4AF37">
        <circle cx="100" cy="100" r="80" stroke-width="0.8" />
        <circle cx="100" cy="100" r="50" stroke-width="0.6" stroke-dasharray="2 2" />
        <path d="M 100,100 L 30,30 M 100,100 L 20,70 M 100,100 L 70,20" stroke-width="0.5" />
      </svg>
    </div>

    <!-- Floating Gold Dust Particles -->
    <div class="ritual-particles-layer absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="ritual-particle" style="top:14%;left:10%;animation-delay:0s;"></div>
      <div class="ritual-particle" style="top:26%;right:12%;animation-delay:1.3s;"></div>
      <div class="ritual-particle" style="top:58%;left:8%;animation-delay:2.5s;"></div>
      <div class="ritual-particle" style="top:74%;right:14%;animation-delay:0.7s;"></div>
      <div class="ritual-particle" style="top:42%;left:52%;animation-delay:3.2s;"></div>
      <div class="ritual-particle" style="top:84%;left:32%;animation-delay:1.8s;"></div>
    </div>

    <!-- Section Header -->
    <div class="max-w-7xl mx-auto relative z-10 text-center mb-8 sm:mb-12 px-4 sm:px-6">
