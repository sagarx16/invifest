---
import { Image, Picture, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

import heroImg from '../assets/images/hero.jpg';
import ganeshaImg from '../assets/images/ganesha.webp';

import groomImg from '../assets/images/couple/groom.jpg';
import groomDetailImg from '../assets/images/couple/groom_detail.jpg';
import brideImg from '../assets/images/couple/bride.jpg';
import brideDetailImg from '../assets/images/couple/bride_detail.jpg';

import haldiImg from '../assets/images/ceremonies/haldi.jpg';
import mehendiImg from '../assets/images/ceremonies/mehendi.jpg';
import sangeetImg from '../assets/images/ceremonies/sangeet.jpg';
import vivahImg from '../assets/images/ceremonies/vivah.jpg';
import receptionImg from '../assets/images/ceremonies/reception.jpg';

import ritual01 from '../assets/images/rituals/c888d80fe207447a5afadd5f379afe4e.jpg';
import ritual02 from '../assets/images/rituals/165b7b72155727b8c64401bbcb5faa88.jpg';
import ritual03 from '../assets/images/rituals/005e44603a92a4cf5982aceac2474629.jpg';
import ritual04 from '../assets/images/rituals/wed.jpg';
import ritual05 from '../assets/images/rituals/eb47fe994cdd0048dccb38042104a50c.jpg';
import ritual06 from '../assets/images/rituals/2363c9d13ae0d4c75da43bf00ae75179.jpg';
import ritual07 from '../assets/images/rituals/wedd.jpg';
import ritual08 from '../assets/images/rituals/wedding.jpg';
import ritual09 from '../assets/images/rituals/7b404c8d76c65a9103a995c42b05a430.jpg';
import ritual10 from '../assets/images/rituals/55bb27790893c4c7dc4499806a76d4d3.jpg';
import ritual11 from '../assets/images/rituals/268c82ee4b857fdee4525f5c0afeb094.jpg';

const WEDDING_DATE = "2026-12-11T00:00:00+05:30";

const sacredRituals = [
  {
    num: 'I',
    counter: '01',
    hindi: 'वधू आगमन',
    title: 'Vadhu Aagman',
    tagline: 'She arrives like a festival.',
    text: 'Beneath a canopy of twinkling lights held high by the people who love her, the bride steps forward, every sequin catching the glow. The whole mandap holds its breath. This is the moment everyone waited for: she arrives, and the evening becomes a celebration.',
    img: ritual01,
    alt: 'Bride walking under a canopy of fairy lights, Vadhu Aagman',
    objectPosition: 'center 35%',
    scaleFix: false
  },
  {
    num: 'II',
    counter: '02',
    hindi: 'जयमाला',
    title: 'Jaimala',
    tagline: 'Two garlands, one yes.',
    text: 'Garlands of roses and carnations rise, and each of them says yes to the other in front of everyone they love. The Jaimala is the first public promise, full of playful laughter, gentle respect and the joy of a welcome that lasts a lifetime.',
    img: ritual02,
    alt: 'Pink and white carnation garlands, hathphool and hand resting on groom arm, Jaimala',
    objectPosition: 'center 40%',
    scaleFix: false
  },
  {
    num: 'III',
    counter: '03',
    hindi: 'मंगल मिलन',
    title: 'Mangal Milan',
    tagline: 'Side by side, at last.',
    text: 'Wrapped in the fragrance of jasmine and blush carnations, they stand together, fingers quietly finding each other. No words are needed. Just the soft chime of bangles and the calm of two people who have found their home in each other.',
    img: ritual03,
    alt: 'Couple standing side by side with jasmine garlands and hands clasped, Mangal Milan',
    objectPosition: 'center 45%',
    scaleFix: false
  },
  {
    num: 'IV',
    counter: '04',
    hindi: 'कन्यादान',
    title: 'Kanyadaan',
    tagline: "A family's blessing, a family's trust.",
    text: 'With mauli on the wrist and sacred water in hand, the family places its most precious joy into new care. Kanyadaan is not a goodbye. It is an offering made with love and complete trust, a blessing the bride carries with her wherever she goes.',
    img: ritual04,
    alt: 'Henna-covered hand with sacred mauli thread on wrist, Kanyadaan',
    objectPosition: 'center 50%',
    scaleFix: false
  },
  {
    num: 'V',
    counter: '05',
    hindi: 'हस्त मिलाप',
    title: 'Hast Milap',
    tagline: 'Where two hands become one path.',
    text: 'A golden thread above, fingers entwined below. In the hush of the ceremony, two hands meet and a shared road begins: to walk together, to hold on through every season, and to never let go in the dark.',
    img: ritual05,
    alt: 'Two joined hands with thin gold thread arching across the frame, Hast Milap',
    objectPosition: 'center 45%',
    scaleFix: false
  },
  {
    num: 'VI',
    counter: '06',
    hindi: 'पाणिग्रहण',
    title: 'Pani Grahan',
    tagline: 'I take your hand, and I take your life with mine.',
    text: "Before the sacred fire, the groom accepts the bride's hand, her palm holding petals, her bangles ringing like temple bells. Pani Grahan is the vow of partnership: in joy and in struggle, and in all the beautiful ordinary days that come after.",
    img: ritual06,
    alt: 'Open palm holding red rose petal before sacred fire, Pani Grahan',
    objectPosition: 'center 50%',
    scaleFix: false
  },
  {
    num: 'VII',
    counter: '07',
    hindi: 'मौली बंधन',
    title: 'Mauli Bandhan',
    tagline: 'A thread of red and gold, a blessing that binds.',
    text: 'A sacred thread is wound around the couple and the holy space, guarding them with the prayers of generations. Simple, humble and powerful, it carries the blessings of those who came before, tied gently around those who are just beginning.',
    img: ritual07,
    alt: 'Sacred red and white thread crossing joined hands, Mauli Bandhan',
    objectPosition: 'center 40%',
    scaleFix: false
  },
  {
    num: 'VIII',
    counter: '08',
    hindi: 'गठबंधन',
    title: 'Gathbandhan',
    tagline: 'A knot that no distance can loosen.',
    text: "The bride's dupatta is tied to the groom's, silk and flowers drawn together in a single knot. It is the knot of destiny: two families, two lives, one promise, tied with love and carried into every step of the phere.",
    img: ritual08,
    alt: "Pink dupatta knotted to red net dupatta glowing in sunlight, Gathbandhan",
    objectPosition: 'center 40%',
    scaleFix: false
  },
  {
    num: 'IX',
    counter: '09',
    hindi: 'सात फेरे',
    title: 'Saat Phere',
    tagline: 'Seven steps, seven promises, one lifetime.',
    text: 'Bound together by the knot, they walk around the sacred fire. Each step carries a vow: nourishment, strength, prosperity, joy, family, harmony and lifelong friendship. With the first step they are two people in love. With the seventh, they are family.',
    img: ritual09,
    alt: 'Two hands held up with dupatta knot tassels against bright sky, Saat Phere',
    objectPosition: 'center 45%',
    scaleFix: false
  },
  {
    num: 'X',
    counter: '10',
    hindi: 'सिंदूर दान',
    title: 'Sindoor Daan',
    tagline: 'A thin red line, a lifetime of love.',
    text: 'With a steady hand and a gentle smile, the groom fills the parting of her hair with sindoor. A single touch, a single colour: red for love, for devotion, and for the start of a home built together.',
    img: ritual10,
    alt: "Groom applying vermilion sindoor in the bride's parting, Sindoor Daan",
    objectPosition: 'center 25%',
    scaleFix: false
  },
  {
    num: 'XI',
    counter: '11',
    hindi: 'गृह प्रवेश',
    title: 'Griha Pravesh',
    tagline: 'Rice, rose petals, and a new beginning.',
    text: 'At the threshold, the bride softly tips the kalash of rice with her foot, letting prosperity spill into her new home along with petals and blessings. Griha Pravesh welcomes her as the light of the household: its luck, its laughter and its warmth.',
    img: ritual11,
    alt: "Bride's henna-decorated foot tipping copper kalash of rice over rose petals, Griha Pravesh",
    objectPosition: 'center top',
    scaleFix: true
  }
];

const ceremonies = [
  {
    num: '01',
    label: '01 · HALDI UTSAV · 10 DEC',
    title: 'Auspicious Haldi Ceremony',
    desc: 'Anointing of pure turmeric, fragrant sandalwood paste, and blissful folk songs with family.',
    meta: [
      { type: 'calendar', text: 'Thu, 10th Dec 2026' },
      { type: 'time', text: '10:00 AM Onwards' },
      { type: 'venue', text: 'Dugda, Bokaro' }
    ],
    dressLabel: 'Sunny Yellow & Marigold',
    swatches: ['#F2C230', '#E8871E'],
    img: haldiImg,
    alt: 'Haldi Utsav',
    imgPos: 'center 55%',
    isVivah: false
  },
  {
    num: '02',
    label: '02 · MEHENDI · 10 DEC',
    title: 'Heena & Folk Rhythms',
    desc: 'Intricate henna designs, traditional dholak beats, and lively festive folk dances under canopies.',
    meta: [
      { type: 'calendar', text: 'Thu, 10th Dec 2026' },
      { type: 'time', text: '04:00 PM Onwards' },
      { type: 'venue', text: 'Dugda, Bokaro' }
    ],
    dressLabel: 'Emerald Green & Mint',
    swatches: ['#0F7A5A', '#A8E0C8'],
    img: mehendiImg,
    alt: 'Mehendi',
    imgPos: 'center 35%',
    isVivah: false
  },
  {
    num: '03',
    label: '03 · SANGEET · 10 DEC',
    title: 'Musical Night & Sangeet',
    desc: 'An unforgettable evening of high-voltage family performances, live Sufi melodies, and dance.',
    meta: [
      { type: 'calendar', text: 'Thu, 10th Dec 2026' },
      { type: 'time', text: '07:30 PM Onwards' },
      { type: 'venue', text: 'Dugda, Bokaro' }
    ],
    dressLabel: 'Royal Navy & Gold Sparkle',
    swatches: ['#14234F', '#D4AF37'],
    img: sangeetImg,
    alt: 'Sangeet',
    imgPos: 'center 60%',
    isVivah: false
  },
  {
    num: '04',
    label: '04 · THE AUSPICIOUS VIVAH · 11 DEC',
    title: 'The Royal Wedding: Saat Phere & Varmala',
    desc: 'The sacred Vedic marriage ceremony, royal Baraat procession, garland exchange, and holy circumambulation around the consecrated sacred fire.',
    meta: [
      { type: 'calendar', text: 'Friday, 11th December 2026' },
      { type: 'procession', text: 'Baraat Procession: 08:00 PM IST' },
      { type: 'venue', text: 'Ojhadih, Bokaro' }
    ],
    dressLabel: 'Traditional Silks & Royal Burgundy',
    swatches: ['#7A1F2E', '#C9A24B'],
    img: vivahImg,
    alt: 'Royal Baraat Procession',
    imgPos: 'center 35%',
    isVivah: true
  },
  {
    num: '05',
    label: '05 · RECEPTION · 14 DEC',
    title: 'Grand Reception & Gala',
    desc: 'An opulent royal feast celebrating the newlyweds with global cuisine, blessings, and photography.',
    meta: [
      { type: 'calendar', text: 'Mon, 14th Dec 2026' },
      { type: 'time', text: '08:00 PM Onwards' },
      { type: 'venue', text: 'Dugda, Bokaro' }
    ],
    dressLabel: 'Black Tie & Velvet Elegance',
    swatches: ['#111111', '#5A0F1F'],
    img: receptionImg,
    alt: 'Grand Reception',
    imgPos: 'center 55%',
    isVivah: false
  }
];
---

<Layout
  title="Mukesh Weds Puja | Wedding Invitation"
  description="With divine blessings and ancestral grace, you are cordially invited to the Royal Wedding of Mukesh Ojha & Puja."
>

  <!-- ========== GRAND OPENING ENVELOPE CINEMATIC (FULL WINDOW) ========== -->
  <div id="opening-cinematic" class="fixed inset-0 z-[10000] w-screen h-screen overflow-hidden select-none transition-all duration-1000 flex flex-col justify-between" style="background:#150D0A;">
    <!-- Ambient Blur Background Video Layer (fills widescreen behind) -->
    <video
      id="opening-video-ambient"
      playsinline
      muted
      loop
      preload="auto"
      poster="/images/video_thumb.jpg"
      class="hidden sm:block absolute inset-0 w-full h-full object-cover filter blur-3xl opacity-50 scale-110 pointer-events-none will-change-transform transform-gpu"
    >
      <source src="/videos/opening.mp4" type="video/mp4" />
    </video>

    <!-- Main Full-Window Video Container -->
    <div class="absolute inset-0 w-full h-full flex items-center justify-center cursor-pointer" id="video-card">
      <video
        id="opening-video"
        playsinline
        preload="auto"
        poster="/images/video_thumb.jpg"
        class="w-full h-full object-cover sm:object-contain md:object-cover pointer-events-auto"
      >
        <source src="/videos/opening.mp4" type="video/mp4" />
      </video>

      <!-- Luxury Golden Tap Prompt Badge centered over the wax seal -->
      <div
        id="envelope-tap-prompt"
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 pointer-events-none flex flex-col items-center gap-3 mt-14 sm:mt-16 text-center select-none"
      >
        <!-- Pulsing golden button -->
        <div
          class="px-6 py-2.5 sm:px-8 sm:py-3.5 rounded-full flex items-center gap-2.5 shadow-2xl backdrop-blur-md border border-[#D4AF37]/90 text-[#FFF7D6] font-['Cinzel'] text-xs sm:text-sm tracking-[0.25em] uppercase font-semibold transition-transform duration-300 animate-bounce"
          style="background: linear-gradient(135deg, rgba(35, 18, 12, 0.92) 0%, rgba(65, 35, 22, 0.88) 100%); box-shadow: 0 0 30px rgba(212, 175, 55, 0.6), 0 10px 35px rgba(0,0,0,0.7);"
        >
          <span class="text-[#D4AF37] text-xs">✦</span>
          <span>Tap To Open</span>
          <span class="text-[#D4AF37] text-xs">✦</span>
        </div>
        <span class="text-[10px] sm:text-[11px] font-['Montserrat'] font-medium tracking-[0.22em] uppercase text-[#F4E3B5]/90 drop-shadow-[0_2px_8px_rgba(0,0,0,0.85)]">
          Mukesh & Puja · Wedding Invitation
        </span>
      </div>
    </div>

  </div>


  <!-- ========== HERO SECTION ========== -->
  <section id="hero" class="relative min-h-screen flex flex-col items-center justify-center text-center px-4 sm:px-6 overflow-hidden py-12 sm:py-14 md:py-16">
    <!-- Hero Royal Background Image (Mukesh & Puja) - Clean & Vibrant with Picture component -->
    <div class="absolute inset-0 z-[1] overflow-hidden pointer-events-none">
      <Picture
        src={heroImg}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        alt="Mukesh & Puja Royal Portrait"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        widths={[400, 640, 800, 1200, 1920]}
        sizes="(max-width: 768px) 800px, 100vw"
        quality={82}
        class="hero-ken-burns w-full h-full object-cover object-[center_20%] sm:object-[center_28%] scale-100 transition-transform duration-1000"
      />
    </div>

    <!-- 8 Mobile & Desktop Ambient Gold Sparkles around Hero -->
    <div class="hero-sparkles-wrap absolute inset-0 pointer-events-none z-[6] overflow-hidden">
      <span class="hero-sparkle-dot" style="top:18%; left:12%; animation-delay:0s;">✦</span>
      <span class="hero-sparkle-dot" style="top:26%; right:14%; animation-delay:0.8s;">✦</span>
      <span class="hero-sparkle-dot" style="top:42%; left:8%; animation-delay:1.6s;">✦</span>
      <span class="hero-sparkle-dot" style="top:52%; right:10%; animation-delay:0.4s;">✦</span>
      <span class="hero-sparkle-dot" style="top:68%; left:18%; animation-delay:1.2s;">✦</span>
      <span class="hero-sparkle-dot" style="top:74%; right:16%; animation-delay:2s;">✦</span>
      <span class="hero-sparkle-dot" style="top:84%; left:25%; animation-delay:0.6s;">✦</span>
      <span class="hero-sparkle-dot" style="top:88%; right:22%; animation-delay:1.4s;">✦</span>
    </div>

    <!-- Optimized Hero Overlay: Single merged gradient combining center readability vignette and bottom page blend (Zero CSS blur filter) -->
    <div
      class="absolute inset-0 z-[2] pointer-events-none"
      style="background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(18, 9, 4, 0.48) 0%, rgba(18, 9, 4, 0.24) 45%, transparent 72%), linear-gradient(to top, #FAF6F0 0%, rgba(250, 246, 240, 0.88) 18%, rgba(250, 246, 240, 0) 38%);"
      aria-hidden="true"
    ></div>

    <!-- Content: Elegant Royal Typography Floating Over The Portrait -->
    <div class="relative z-[8] max-w-4xl mx-auto flex flex-col items-center -mt-3 sm:-mt-6">
      <!-- Auspicious Invocation Pill: Moved higher up with Aaj Sajeya Font & Color -->
      <div id="hero-tag" class="inline-flex items-center gap-2.5 px-5 py-1.5 sm:px-6 sm:py-2 rounded-full mb-2.5 sm:mb-3 opacity-0 shadow-sm" style="background:rgba(250,242,228,0.88);backdrop-filter:blur(16px);border:1px solid rgba(212,175,55,0.4);box-shadow:0 6px 20px rgba(160,120,70,0.12);">
        <span class="text-[#8C6219] text-xs">✦</span>
        <span class="font-['Montserrat'] text-[#8C6219] text-[10px] sm:text-xs tracking-widest uppercase font-semibold">Shri Ganeshaya Namah</span>
        <span class="text-[#8C6219] text-xs">✦</span>
      </div>

      <!-- Auspicious Lord Ganesha Emblem: Golden colour with 50% rounded sides (circle) -->
      <div id="hero-ganesha" class="opacity-0 mb-2.5 sm:mb-3.5 flex items-center justify-center">
        <div
          class="w-[68px] h-[68px] sm:w-[82px] sm:h-[82px] md:w-[90px] md:h-[90px] p-1 sm:p-1.5 flex items-center justify-center shadow-lg transition-transform duration-500 hover:scale-105"
          style="border-radius:50%;background:rgba(250,242,228,0.92);backdrop-filter:blur(16px);border:1.5px solid rgba(212,175,55,0.55);box-shadow:0 8px 24px rgba(160,120,70,0.2), 0 0 16px rgba(212,175,55,0.25);"
        >
          <Picture
            src={ganeshaImg}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            alt="Lord Ganesha"
            class="w-full h-full object-contain pointer-events-none select-none rounded-full"
            style="border-radius:50%;"
            width={90}
            height={90}
            loading="eager"
            decoding="async"
          />
        </div>
      </div>

      <!-- Subtitle Badge: Aaj Sajeya Font & Color with balanced bottom margin -->
      <div id="hero-subtitle" class="inline-flex items-center gap-2 px-5 py-1.5 rounded-full mb-5 sm:mb-7 md:mb-8 opacity-0 shadow-xs" style="background:rgba(250,242,228,0.85);backdrop-filter:blur(16px);border:1px solid rgba(212,175,55,0.4);box-shadow:0 4px 16px rgba(160,120,70,0.1);">
        <span class="font-['Montserrat'] text-[9px] sm:text-[10px] tracking-widest uppercase text-[#8C6219] font-semibold">The Auspicious Wedding Of</span>
      </div>

      <!-- 2 & 3. Royal Names: Generous Vertical Breathing Room, Twinkling Sparkles & Gold Shine Sweep -->
      <div id="hero-names-wrap" class="relative my-2 sm:my-4 text-center w-full max-w-3xl mx-auto">
        <!-- 6 Tiny Sparkle Stars Twinkling Near Calligraphy Letters -->
        <span class="name-sparkle text-[#FFE89E] text-xs sm:text-sm" style="top:2%; left:8%; animation-delay:0s;">✦</span>
        <span class="name-sparkle text-[#FFF4C7] text-sm sm:text-base" style="top:10%; right:10%; animation-delay:0.8s;">✦</span>
        <span class="name-sparkle text-[#FFE89E] text-[10px] sm:text-xs" style="top:44%; left:16%; animation-delay:1.5s;">✦</span>
        <span class="name-sparkle text-[#FFF4C7] text-[10px] sm:text-xs" style="top:46%; right:18%; animation-delay:0.4s;">✦</span>
        <span class="name-sparkle text-[#FFE89E] text-xs sm:text-sm" style="top:74%; left:12%; animation-delay:1.1s;">✦</span>
        <span class="name-sparkle text-[#FFF4C7] text-sm sm:text-base" style="top:88%; right:12%; animation-delay:1.9s;">✦</span>

        <!-- One-time bright flash burst on initial reveal -->
        <div class="hero-names-flash absolute inset-0 pointer-events-none rounded-full" style="background:radial-gradient(circle, rgba(255,255,255,0.8) 0%, rgba(245,210,108,0.5) 45%, transparent 70%); opacity:0; filter:blur(14px);"></div>

        <h1 id="hero-groom" class="opacity-0 leading-[1.1] tracking-[0.04em] sm:tracking-[0.06em] name-shine" style="font-family:'Great Vibes', cursive, serif; font-size:clamp(54px,11vw,116px);">
          Mukesh Ojha
        </h1>
        <div id="hero-amp" class="flex items-center justify-center gap-3 sm:gap-5 my-4 sm:my-6 md:my-7 opacity-0">
          <div class="h-px w-16 sm:w-28" style="background:linear-gradient(90deg,transparent,#D4AF37);"></div>
          <span class="px-5 py-1 rounded-full font-['Montserrat'] font-semibold text-[10px] sm:text-[11px] tracking-widest uppercase flex items-center gap-2 shadow-sm" style="background:rgba(250,242,228,0.85);border:1px solid rgba(212,175,55,0.4);color:#8C6219;">
            <span class="text-[9px] text-[#8C6219]">✦</span>
            <span>Weds</span>
            <span class="text-[9px] text-[#8C6219]">✦</span>
          </span>
          <div class="h-px w-16 sm:w-28" style="background:linear-gradient(270deg,transparent,#D4AF37);"></div>
        </div>
        <h1 id="hero-bride" class="opacity-0 leading-[1.1] tracking-[0.04em] sm:tracking-[0.06em] name-shine" style="font-family:'Great Vibes', cursive, serif; font-size:clamp(54px,11vw,116px);">
          Puja
        </h1>
      </div>

      <!-- Invitation Text: Floating Golden & Non-Bold with proper separation -->
      <div id="hero-invite" class="max-w-xl mx-auto mt-6 sm:mt-8 md:mt-10 mb-6 sm:mb-8 opacity-0 px-4 text-center">
        <p class="font-['Montserrat'] text-[#E5C158] leading-relaxed font-normal tracking-wide" style="font-size:clamp(13px,1.35vw,15.5px);text-shadow:0 1px 4px rgba(0,0,0,0.75), 0 2px 12px rgba(0,0,0,0.6);">
          Cordially invite you to celebrate our sacred union amidst palatial grace, ancestral rites, and celestial splendour.
        </p>
      </div>

      <!-- Single Grand Explore Celebrations CTA -->
      <div id="hero-ctas" class="flex items-center justify-center w-full opacity-0 mt-2 sm:mt-4">
        <a href="#save-the-date" class="group px-9 sm:px-12 py-4 sm:py-4.5 rounded-full font-['Cinzel'] text-xs sm:text-sm tracking-[0.25em] uppercase font-normal transition-all duration-500 ripple-btn shine-btn relative overflow-hidden magnetic-btn hover:scale-105 active:scale-95 shadow-[0_8px_30px_rgba(184,134,11,0.35)] flex items-center gap-3" style="background:linear-gradient(135deg, #DFB756 0%, #B8860B 50%, #8C6219 100%);color:#FFFFFF;border:1px solid rgba(255,255,255,0.4);">
          <span>Explore Celebrations</span>
          <span class="text-xs transition-transform duration-300 group-hover:translate-x-1">✦</span>
        </a>
      </div>
    </div>

    <!-- Scroll indicator with mobile gentle bounce -->
    <div id="scroll-indicator" class="scroll-cue-bounce absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-0 z-[8]">
      <span class="font-['Montserrat'] text-[9px] tracking-[0.25em] uppercase text-[#A07828] font-normal">Scroll</span>
      <div class="w-0.5 h-12 relative overflow-hidden" style="background:rgba(212,175,55,0.25);">
        <div class="w-full h-1/2 absolute top-0" style="background:#D4AF37;animation:scroll-pulse 1.5s ease-in-out infinite;"></div>
      </div>
    </div>
  </section>

  <!-- ========== SAVE THE DATE & LIVE COUNTDOWN SECTION ========== -->
