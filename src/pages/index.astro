  <!-- Audio element (muted by default) -->
  <audio id="bg-audio" loop preload="none">
    <!-- Add shehnai audio src here -->
  </audio>

  <!-- Scroll-to-top -->
  <a href="#hero" id="scroll-top-btn" class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-40 w-10 h-10 sm:w-11 sm:h-11 rounded-full flex items-center justify-center transition-all duration-300 opacity-0 magnetic-btn ripple-btn text-sm sm:text-base" style="background:rgba(11,10,26,0.85);border:1px solid rgba(224,184,79,0.4);color:#E0B84F;backdrop-filter:blur(12px);box-shadow:0 8px 32px rgba(0,0,0,0.6),0 0 18px rgba(224,184,79,0.2);" aria-label="Back to top">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
  </a>

  <!-- Music widget -->
  <div class="fixed bottom-4 left-4 sm:bottom-6 sm:left-6 z-40">
    <div id="music-widget" class="flex items-center gap-2 sm:gap-3 px-3 py-2 sm:px-4 sm:py-2.5 rounded-full" style="background:rgba(11,10,26,0.85);backdrop-filter:blur(20px);border:1px solid rgba(224,184,79,0.25);box-shadow:0 8px 32px rgba(0,0,0,0.6),0 0 16px rgba(224,184,79,0.1);">
      <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[#E0B84F] flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" style="animation:pulse 2s ease-in-out infinite;">
        <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
      </svg>
      <div class="flex flex-col">
        <span class="font-['Montserrat'] text-[9px] sm:text-[10px] text-[#E0B84F] tracking-widest uppercase leading-none">Raag Mangalam</span>
        <span class="font-['Montserrat'] text-[7px] sm:text-[8px] text-[#D1C5B1] uppercase tracking-widest leading-none mt-0.5 hidden xs:inline">Royal Shehnai</span>
      </div>
      <div class="flex items-center gap-0.5 ml-0.5 sm:ml-1">
        {[3,4,2].map(h => (
          <span class="w-0.5 bg-[#E0B84F] rounded-full" style={`height:${h*4}px;animation:music-bar 0.8s ease-in-out infinite alternate;`}></span>
        ))}
