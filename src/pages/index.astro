</Layout>

<style>
@keyframes scroll-pulse {
  0% { transform: translateY(-100%); opacity: 1; }
  100% { transform: translateY(200%); opacity: 0; }
}
@keyframes lantern-rise {
  0% { transform: translateY(0) scale(1); opacity: 0.3; }
  50% { transform: translateY(-40vh) scale(1.1) translateX(10px); opacity: 0.5; }
  100% { transform: translateY(-80vh) scale(0.8) translateX(-5px); opacity: 0; }
}
@keyframes music-bar {
  from { transform: scaleY(0.4); }
  to { transform: scaleY(1); }
}
</style>

<script>
  // ── GSAP + ScrollTrigger animations ──────────────────────────────
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';
  import { royalAudio } from '../lib/audio';

  gsap.registerPlugin(ScrollTrigger);

  // Lenis smooth scroll
  const lenis = new Lenis({ lerp: 0.08, smoothWheel: true });
  lenis.on('scroll', ScrollTrigger.update);
  gsap.ticker.add((time) => lenis.raf(time * 1000));
  gsap.ticker.lagSmoothing(0);

  // ── GRAND OPENING ENVELOPE CINEMATIC & HERO REVEAL ────────────────
  const openingCinematic = document.getElementById('opening-cinematic');
  const openingVideo = document.getElementById('opening-video') as HTMLVideoElement | null;
  const unmuteBtn = document.getElementById('cinematic-unmute-btn');
  const soundIcon = document.getElementById('cinematic-sound-icon');
  const soundText = document.getElementById('cinematic-sound-text');
  const unmuteBadge = document.getElementById('unmute-badge');
  const skipBtn = document.getElementById('cinematic-skip-btn');
  const enterBtn = document.getElementById('cinematic-enter-btn');
  const videoProgressFill = document.getElementById('video-progress-fill');
  const videoCard = document.getElementById('video-card');
  const replayEnvelopeBtn = document.getElementById('replay-envelope-btn');

  let heroRevealed = false;
  let introDismissed = false;

  function triggerRevealHero() {
    if (heroRevealed) return;
    heroRevealed = true;
    revealHero();
  }

  function dismissIntro() {
    if (introDismissed) return;
    introDismissed = true;

    if (openingVideo) {
      openingVideo.pause();
    }

    if (openingCinematic) {
      openingCinematic.style.transition = 'opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1)';
      openingCinematic.style.opacity = '0';
      openingCinematic.style.transform = 'scale(1.04)';
      openingCinematic.style.pointerEvents = 'none';
      setTimeout(() => {
        openingCinematic.style.display = 'none';
      }, 950);
    }

    // Play golden wedding chime
    royalAudio.playDoorOpenSound();

    // Trigger celebratory confetti burst
    try {
      import('canvas-confetti').then(mod => {
        const confetti = mod.default;
        confetti({ particleCount: 100, spread: 80, origin: { y: 0.6 }, colors: ['#E0B84F','#FED467','#FFB1C7','#FFF3A3'] });
      });
    } catch(e) {}

    triggerRevealHero();
  }

  const soundOnSvg = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>';
  const soundOffSvg = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>';

  function toggleVideoSound() {
    if (!openingVideo) return;
    openingVideo.muted = !openingVideo.muted;
    if (!openingVideo.muted) {
      openingVideo.volume = 1;
      openingVideo.play().catch(() => {});
      if (soundIcon) soundIcon.innerHTML = soundOnSvg;
      if (soundText) soundText.textContent = 'Mute';
      if (unmuteBadge) unmuteBadge.style.opacity = '0';
    } else {
      if (soundIcon) soundIcon.innerHTML = soundOffSvg;
      if (soundText) soundText.textContent = 'Unmute';
      if (unmuteBadge) unmuteBadge.style.opacity = '1';
    }
  }

  videoCard?.addEventListener('click', () => {
    if (openingVideo && openingVideo.muted) {
      toggleVideoSound();
    } else {
      dismissIntro();
    }
  });

  unmuteBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleVideoSound();
  });

  skipBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    dismissIntro();
  });

  enterBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    dismissIntro();
  });

  if (openingVideo) {
    openingVideo.addEventListener('timeupdate', () => {
      if (openingVideo.duration && videoProgressFill) {
        const pct = (openingVideo.currentTime / openingVideo.duration) * 100;
        videoProgressFill.style.width = pct + '%';
      }
    });

    openingVideo.addEventListener('ended', () => {
      setTimeout(() => {
        dismissIntro();
      }, 600);
    });

    // Auto-play muted video immediately
    openingVideo.play().catch(() => {});
  }

  // Replay envelope video from hero section
  replayEnvelopeBtn?.addEventListener('click', () => {
    if (!openingCinematic || !openingVideo) return;
    introDismissed = false;
    openingCinematic.style.display = 'flex';
    openingCinematic.style.pointerEvents = 'auto';
    openingVideo.currentTime = 0;
    openingVideo.muted = false; // with sound!
    if (soundIcon) soundIcon.innerHTML = soundOnSvg;
    if (soundText) soundText.textContent = 'Mute';
    if (unmuteBadge) unmuteBadge.style.opacity = '0';
    requestAnimationFrame(() => {
      openingCinematic.style.opacity = '1';
      openingCinematic.style.transform = 'scale(1)';
      openingVideo.play().catch(() => {});
    });
  });

  // Safety fallback after 12 seconds in case user never clicks or video fails
  setTimeout(() => {
    if (!introDismissed) dismissIntro();
  }, 12000);

  function revealHero() {
    const tl = gsap.timeline();
    tl.to('#hero-tag', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' })
      .to('#hero-subtitle', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.4')
      .to('#hero-groom', { opacity: 1, duration: 0.2 }, '-=0.3')
      .fromTo('.hero-char-groom', 
        { opacity: 0, y: 40, rotateX: -60, scale: 0.8 }, 
        { opacity: 1, y: 0, rotateX: 0, scale: 1, duration: 0.7, stagger: 0.05, ease: 'back.out(1.7)' }, '-=0.2')
      .to('#hero-amp', { opacity: 1, duration: 0.6 }, '-=0.3')
      .to('#hero-bride', { opacity: 1, duration: 0.2 }, '-=0.3')
      .fromTo('.hero-char-bride', 
        { opacity: 0, y: 40, rotateX: -60, scale: 0.8 }, 
        { opacity: 1, y: 0, rotateX: 0, scale: 1, duration: 0.7, stagger: 0.06, ease: 'back.out(1.7)' }, '-=0.2')
      .to('#hero-invite', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, '-=0.4')
      .to('#hero-date', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.3')
      .to('#countdown', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, '-=0.2')
      .to('#hero-ctas', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.3')
      .to('#scroll-indicator', { opacity: 1, duration: 0.6 }, '-=0.1');
  }

  // Set initial states
  gsap.set(['#hero-tag','#hero-subtitle','#hero-groom','#hero-amp','#hero-bride','#hero-invite','#hero-date','#countdown','#hero-ctas','#scroll-indicator'], {
    y: 30, opacity: 0
  });

  // ── NAVBAR scroll behavior ─────────────────────────────────────────
  const navbar = document.getElementById('navbar');
  ScrollTrigger.create({
    start: 'top -80px',
    onEnter: () => navbar && (navbar.style.background = 'rgba(11,10,26,0.92)', navbar.style.backdropFilter = 'blur(20px)', (navbar.style as any).borderBottom = '1px solid rgba(224,184,79,0.1)'),
    onLeaveBack: () => navbar && (navbar.style.background = 'rgba(11,10,26,0.0)', navbar.style.backdropFilter = '', (navbar.style as any).borderBottom = ''),
  });

  // ── SCROLL-TO-TOP button ─────────────────────────────────────────
  const scrollTopBtn = document.getElementById('scroll-top-btn');
  ScrollTrigger.create({
    start: 'top -400px',
    onEnter: () => scrollTopBtn && gsap.to(scrollTopBtn, { opacity: 1, duration: 0.3 }),
    onLeaveBack: () => scrollTopBtn && gsap.to(scrollTopBtn, { opacity: 0, duration: 0.3 }),
  });

  // ── REVEAL SECTIONS on scroll ─────────────────────────────────────
  document.querySelectorAll('.reveal-section').forEach(el => {
    gsap.fromTo(el,
      { opacity: 0, y: 60 },
      { opacity: 1, y: 0, duration: 1, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 80%', toggleActions: 'play none none reverse' }
      }
    );
  });

  // Story items stagger
  gsap.fromTo('.story-item', { opacity: 0, y: 40 }, {
    opacity: 1, y: 0, duration: 0.8, stagger: 0.2, ease: 'power2.out',
    scrollTrigger: { trigger: '#story', start: 'top 70%' }
  });

  // Event cards stagger
  gsap.fromTo('.event-card', { opacity: 0, y: 50, scale: 0.95 }, {
    opacity: 1, y: 0, scale: 1, duration: 0.7, stagger: 0.1, ease: 'power2.out',
    scrollTrigger: { trigger: '#events', start: 'top 70%' }
  });

  // SVG border draw
  document.querySelectorAll('.svg-draw-rect').forEach(el => {
    ScrollTrigger.create({
      trigger: el.closest('section') || el,
      start: 'top 70%',
      onEnter: () => gsap.to(el, { 'stroke-dashoffset': 0, duration: 2, ease: 'power2.out' }),
    });
  });

  // Couple card cursor glow
  document.querySelectorAll('.couple-card').forEach(card => {
    const glow = card.querySelector('.couple-glow') as HTMLElement | null;
    card.addEventListener('mousemove', (e: Event) => {
      if (!glow) return;
      const mouseEvent = e as MouseEvent;
      const rect = (card as HTMLElement).getBoundingClientRect();
      const x = ((mouseEvent.clientX - rect.left) / rect.width) * 100;
      const y = ((mouseEvent.clientY - rect.top) / rect.height) * 100;
      glow.style.setProperty('--mx', `${x}%`);
      glow.style.setProperty('--my', `${y}%`);
      glow.style.opacity = '1';
    });
    card.addEventListener('mouseleave', () => {
      if (glow) glow.style.opacity = '0';
    });
  });

  // Event card tilt
  document.querySelectorAll('.event-card').forEach(card => {
    card.addEventListener('mousemove', (e: Event) => {
      const mouseEvent = e as MouseEvent;
      const el = card as HTMLElement;
      const rect = el.getBoundingClientRect();
      const x = (mouseEvent.clientX - rect.left) / rect.width - 0.5;
      const y = (mouseEvent.clientY - rect.top) / rect.height - 0.5;
      el.style.transform = `perspective(1000px) rotateX(${y * -8}deg) rotateY(${x * 8}deg) scale(1.02)`;
    });
    card.addEventListener('mouseleave', () => {
      (card as HTMLElement).style.transform = '';
    });
  });

  // Parallax on mouse move
  document.addEventListener('mousemove', (e) => {
    const xPct = (e.clientX / window.innerWidth - 0.5) * 2;
    const yPct = (e.clientY / window.innerHeight - 0.5) * 2;
    document.querySelectorAll<HTMLElement>('.parallax-layer').forEach(el => {
      const depth = parseFloat(el.dataset.depth || '0.1');
      gsap.to(el, { x: xPct * 40 * depth, y: yPct * 40 * depth, duration: 1, ease: 'power1.out' });
    });
    const mandala = document.getElementById('hero-mandala');
    if (mandala) {
      gsap.to(mandala, { x: xPct * 20, y: yPct * 20, duration: 2, ease: 'power1.out' });
    }
  });

  // ── COUNTDOWN FLIP-CLOCK ──────────────────────────────────────────
  const weddingDate = new Date('2026-12-11T19:00:00+05:30').getTime();
  const prevVals: Record<string, number> = { days: -1, hours: -1, minutes: -1, seconds: -1 };

  function updateCountdown() {
    const now = Date.now();
    const diff = weddingDate - now;
    if (diff <= 0) return;
    const vals = {
      days: Math.floor(diff / 86400000),
      hours: Math.floor((diff % 86400000) / 3600000),
      minutes: Math.floor((diff % 3600000) / 60000),
      seconds: Math.floor((diff % 60000) / 1000),
    };
    Object.entries(vals).forEach(([key, val]) => {
      const el = document.getElementById(`cd-${key}-val`);
      const card = document.getElementById(`cd-${key}`);
      if (el && val !== prevVals[key]) {
        prevVals[key] = val;
        el.textContent = String(val).padStart(2, '0');
        if (card) {
          gsap.fromTo(card, { rotateX: -20, scale: 0.95 }, { rotateX: 0, scale: 1, duration: 0.3, ease: 'power2.out' });
        }
      }
    });
  }
  setInterval(updateCountdown, 1000);
  updateCountdown();

  // ── PETALS CANVAS ─────────────────────────────────────────────────
  const canvas = document.getElementById('petals-canvas') as HTMLCanvasElement;
  if (canvas) {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const ctx = canvas.getContext('2d')!;
    window.addEventListener('resize', () => {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    });

    const PETALS = Array.from({ length: 30 }, () => ({
      x: Math.random() * window.innerWidth,
      y: Math.random() * -window.innerHeight,
      size: 6 + Math.random() * 10,
      speed: 0.5 + Math.random() * 1.5,
      drift: (Math.random() - 0.5) * 0.8,
      rot: Math.random() * 360,
      rotSpeed: (Math.random() - 0.5) * 2,
      opacity: 0.3 + Math.random() * 0.5,
      color: Math.random() > 0.5 ? '#E0B84F' : '#FF9CB4',
    }));

    let mouseInfluence = { x: 0, y: 0 };
    document.addEventListener('mousemove', (e) => {
      mouseInfluence.x = (e.clientX / window.innerWidth - 0.5) * 2;
      mouseInfluence.y = (e.clientY / window.innerHeight - 0.5) * 2;
    });

    function drawPetals() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      PETALS.forEach(p => {
        p.y += p.speed;
        p.x += p.drift + mouseInfluence.x * 0.5;
        p.rot += p.rotSpeed;
        if (p.y > window.innerHeight + 20) {
          p.y = -20;
          p.x = Math.random() * window.innerWidth;
        }
        if (p.x > window.innerWidth + 20) p.x = -20;
        if (p.x < -20) p.x = window.innerWidth + 20;

        ctx.save();
        ctx.globalAlpha = p.opacity;
        ctx.translate(p.x, p.y);
        ctx.rotate((p.rot * Math.PI) / 180);
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.ellipse(0, 0, p.size / 2, p.size, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      });
      requestAnimationFrame(drawPetals);
    }
    drawPetals();
  }

  // ── THREE.JS DIYA SCENE ─────────────────────────────────────────
  async function initThree() {
    try {
      const THREE = await import('three');
      const threeCanvas = document.getElementById('hero-three') as HTMLCanvasElement;
      if (!threeCanvas) return;

      const renderer = new THREE.WebGLRenderer({ canvas: threeCanvas, alpha: true, antialias: false });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
      renderer.setSize(window.innerWidth, window.innerHeight);

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
      camera.position.z = 5;

      // Golden particle field (diyas)
      const geo = new THREE.BufferGeometry();
      const N = 200;
      const positions = new Float32Array(N * 3);
      const colors = new Float32Array(N * 3);
      const sizes = new Float32Array(N);
      const goldColor = new THREE.Color('#E0B84F');
      const roseColor = new THREE.Color('#FFB1C7');

      for (let i = 0; i < N; i++) {
        positions[i*3] = (Math.random() - 0.5) * 20;
        positions[i*3+1] = (Math.random() - 0.5) * 15;
        positions[i*3+2] = (Math.random() - 0.5) * 10;
        const c = Math.random() > 0.7 ? roseColor : goldColor;
        colors[i*3] = c.r; colors[i*3+1] = c.g; colors[i*3+2] = c.b;
        sizes[i] = 2 + Math.random() * 4;
      }
      geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
      geo.setAttribute('size', new THREE.BufferAttribute(sizes, 1));

      const mat = new THREE.PointsMaterial({
        size: 0.15, vertexColors: true, transparent: true, opacity: 0.6,
        sizeAttenuation: true,
      });
      const points = new THREE.Points(geo, mat);
      scene.add(points);

      window.addEventListener('resize', () => {
        renderer.setSize(window.innerWidth, window.innerHeight);
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
      });

      const clock = new THREE.Clock();
      function animateThree() {
        requestAnimationFrame(animateThree);
        const t = clock.getElapsedTime();
        points.rotation.y = t * 0.05;
        points.rotation.x = Math.sin(t * 0.03) * 0.1;
        // Flicker opacity
        mat.opacity = 0.4 + Math.sin(t * 2) * 0.15;
        renderer.render(scene, camera);
      }
      animateThree();
    } catch (e) {
      console.warn('Three.js failed, continuing without 3D:', e);
    }
  }

  // Only load Three on non-mobile or capable devices
  if (window.innerWidth > 768 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    initThree();
  }

  // ── ICS DOWNLOAD ──────────────────────────────────────────────────
  function downloadICS() {
    const ics = [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'PRODID:-//MukeshWedsPuja//Wedding//EN',
      'BEGIN:VEVENT',
      'UID:mukesh-weds-puja-2026@wedding',
      'DTSTART:20261211T130000Z',
      'DTEND:20261211T203000Z',
      'SUMMARY:Mukesh Ojha weds Puja | #MukeshWedsPuja',
      'DESCRIPTION:The Royal Wedding of Mukesh Ojha & Puja. #MukeshWedsPuja',
      'LOCATION:Grand Rajwada Mandap\\, Dugda\\, Bokaro\\, Jharkhand - 828404',
      'STATUS:CONFIRMED',
      'END:VEVENT',
      'END:VCALENDAR',
    ].join('\r\n');
    const blob = new Blob([ics], { type: 'text/calendar' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'MukeshWedsPuja.ics'; a.click();
    URL.revokeObjectURL(url);
  }

  document.getElementById('add-to-cal-btn')?.addEventListener('click', downloadICS);
  document.getElementById('add-to-cal-2')?.addEventListener('click', downloadICS);

  // ── HASHTAG COPY ──────────────────────────────────────────────────
  document.getElementById('copy-hashtag')?.addEventListener('click', () => {
    navigator.clipboard.writeText('#MukeshWedsPuja').then(() => {
      const toast = document.getElementById('copy-toast');
      if (toast) { toast.classList.remove('hidden'); setTimeout(() => toast.classList.add('hidden'), 2000); }
    });
  });

  // ── RSVP FORM ────────────────────────────────────────────────────
  document.getElementById('rsvp-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('rsvp-submit') as HTMLButtonElement;
    const name = (document.getElementById('rsvp-name') as HTMLInputElement).value;
    btn.textContent = 'Sending... ✦';
    btn.disabled = true;

    // Confetti burst
    try {
      const confetti = (await import('canvas-confetti')).default;
      confetti({ particleCount: 120, spread: 80, colors: ['#E0B84F','#FFB1C7','#FED467','#FFDF95'], origin: { y: 0.7 } });
      setTimeout(() => confetti({ particleCount: 60, spread: 120, angle: 60, colors: ['#E0B84F','#FFB1C7'] }), 300);
      setTimeout(() => confetti({ particleCount: 60, spread: 120, angle: 120, colors: ['#E0B84F','#FFB1C7'] }), 500);
    } catch (e) {}

    // Simulate submit (replace with your backend endpoint)
    await new Promise(r => setTimeout(r, 1000));
    (document.getElementById('rsvp-form') as HTMLFormElement).reset();
    btn.textContent = 'Confirm Royal Presence ✦';
    btn.disabled = false;
    const success = document.getElementById('rsvp-success');
    if (success) success.classList.remove('hidden');
    setTimeout(() => success?.classList.add('hidden'), 5000);
  });

  // ── GALLERY LIGHTBOX ─────────────────────────────────────────────
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxSub = document.getElementById('lightbox-sub');
  const lightboxClose = document.getElementById('lightbox-close');

  document.querySelectorAll('.gallery-item').forEach(item => {
    item.addEventListener('click', () => {
      const el = item as HTMLElement;
      const src = el.dataset.src || '';
      const title = el.dataset.title || '';
      const sub = el.dataset.sub || '';
      if (lightbox && lightboxImg) {
        lightboxImg.src = src;
        if (lightboxTitle) lightboxTitle.textContent = title;
        if (lightboxSub) lightboxSub.textContent = sub;
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
      }
    });
  });

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
    }
  }

  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });

  // ── AUDIO CONTROLS (HOWLER / WEB AUDIO SYNTH) ─────────────────────
  const audioToggle = document.getElementById('audio-toggle');
  const audioIcon = document.getElementById('audio-icon');
  const musicWidget = document.getElementById('music-widget');

  function updateAudioUI(isPlaying: boolean) {
    if (audioIcon) {
      audioIcon.innerHTML = isPlaying
        ? '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" rx="1"></rect><rect x="14" y="4" width="4" height="16" rx="1"></rect></svg>'
        : '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>';
    }
    if (audioToggle) {
      audioToggle.style.borderColor = isPlaying ? 'rgba(254,212,103,0.8)' : 'rgba(224,184,79,0.25)';
      audioToggle.style.boxShadow = isPlaying ? '0 0 16px rgba(254,212,103,0.3)' : 'none';
    }
    if (musicWidget) {
      musicWidget.style.borderColor = isPlaying ? 'rgba(254,212,103,0.8)' : 'rgba(224,184,79,0.25)';
      musicWidget.style.boxShadow = isPlaying ? '0 0 24px rgba(254,212,103,0.35)' : 'none';
    }
  }

  const handleToggleMusic = () => {
    royalAudio.toggleMusic((isPlaying) => {
      updateAudioUI(isPlaying);
    });
  };

  audioToggle?.addEventListener('click', handleToggleMusic);
  musicWidget?.addEventListener('click', handleToggleMusic);
  if (musicWidget) musicWidget.style.cursor = 'pointer';

  // ── MOBILE MENU DRAWER ───────────────────────────────────────────
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const mBar1 = document.getElementById('m-bar-1');
  const mBar2 = document.getElementById('m-bar-2');
  const mBar3 = document.getElementById('m-bar-3');
  let isMobileMenuOpen = false;

  function toggleMobileMenu(forceClose?: boolean) {
    if (!mobileDrawer) return;
    isMobileMenuOpen = forceClose ? false : !isMobileMenuOpen;

    if (isMobileMenuOpen) {
      mobileDrawer.classList.remove('hidden');
      mobileDrawer.classList.add('flex');
      document.body.style.overflow = 'hidden';
      if (mBar1) mBar1.style.transform = 'translateY(6px) rotate(45deg)';
      if (mBar2) mBar2.style.opacity = '0';
      if (mBar3) mBar3.style.transform = 'translateY(-6px) rotate(-45deg)';
    } else {
      mobileDrawer.classList.add('hidden');
      mobileDrawer.classList.remove('flex');
      document.body.style.overflow = '';
      if (mBar1) mBar1.style.transform = '';
      if (mBar2) mBar2.style.opacity = '1';
      if (mBar3) mBar3.style.transform = '';
    }
  }

  mobileMenuBtn?.addEventListener('click', () => toggleMobileMenu());
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => toggleMobileMenu(true));
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1280 && isMobileMenuOpen) {
      toggleMobileMenu(true);
    }
  });
</script>
