      <h2 class="section-title">The Sacred Rituals Of Our Vivah</h2>
      <div class="heading-divider" data-reveal="up" data-delay="0.1">
        <span class="hd-line left"></span>
        <span class="hd-sparkle">✦</span>
        <span class="hd-line right"></span>
      </div>
      <p class="font-['Montserrat'] text-[#6E5F55] text-xs sm:text-sm mt-3 max-w-md mx-auto">Every ritual a blessing, every blessing a beginning.</p>
    </div>

    <!-- Vanilla JS Infinite 5-Card Coverflow Carousel -->
    <div class="rituals-carousel-wrapper relative z-10 w-full select-none" data-carousel="rituals">

      <div class="rituals-track-container w-full overflow-visible py-4 sm:py-6" id="rituals-viewport">
        <div class="rituals-track flex items-center gap-4 sm:gap-5 md:gap-6" id="rituals-track">
          {sacredRituals.map((slide, idx) => {
            const words = slide.title.split(' ');
            const hasMultipleWords = words.length > 1;
            const firstPart = hasMultipleWords ? words.slice(0, -1).join(' ') : slide.title;
            const lastWord = hasMultipleWords ? words[words.length - 1] : '';

            return (
              <div
                class="ritual-card flex-shrink-0 relative focus:outline-none"
                data-ritual-title={slide.title}
                data-index={idx}
                tabindex="0"
                role="group"
                aria-roledescription="slide"
                aria-label={`Slide ${idx + 1} of ${sacredRituals.length}: ${slide.title}`}
              >
