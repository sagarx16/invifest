<style>
/* ── SACRED RITUALS PHOTO CAROUSEL STYLES ────────────────────────── */
#rituals {
  overflow-x: clip;
}

#rituals-swiper {
  overflow: visible !important;
  width: 100%;
  height: 520px;
  position: relative;
}

#rituals-swiper .swiper-wrapper {
  height: 100%;
  display: flex;
  align-items: center;
}

#rituals-swiper .swiper-slide {
  width: 320px !important;
  max-width: 330px !important;
  height: 500px !important;
  flex-shrink: 0;
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
  opacity: 0.55;
  display: block;
}

@media (min-width: 640px) {
  #rituals-swiper {
    height: 560px;
  }
  #rituals-swiper .swiper-slide {
    width: 375px !important;
    max-width: 380px !important;
    height: 535px !important;
  }
}

@media (min-width: 768px) {
  #rituals-swiper {
    height: 590px;
  }
  #rituals-swiper .swiper-slide {
    width: 410px !important;
    max-width: 420px !important;
    height: 565px !important;
  }
}

.ritual-card-frame {
  height: 100% !important;
  width: 100% !important;
}

#rituals-swiper .swiper-slide-active {
  opacity: 1 !important;
  z-index: 20;
}

/* Ken Burns slow subtle zoom on active slide */
#rituals-swiper .swiper-slide-active .ritual-card-img {
  animation: kenBurnsZoom 8s ease-in-out infinite alternate;
}

@keyframes kenBurnsZoom {
  0% { transform: scale(1); }
  100% { transform: scale(1.06); }
}

#rituals-swiper .swiper-slide-active .ritual-card-img.scale-110 {
  animation: kenBurnsZoomSlide11 8s ease-in-out infinite alternate;
}

@keyframes kenBurnsZoomSlide11 {
  0% { transform: scale(1.1); }
  100% { transform: scale(1.18); }
}

/* Gold shimmer sweeps once over title of active slide */
#rituals-swiper .swiper-slide-active .ritual-card-title {
  background: linear-gradient(110deg, #FFFFFF 15%, #DFB756 50%, #FFFFFF 85%);
  background-size: 200% 100%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: ritualTitleShimmer 1.8s ease-out 0.25s 1 forwards;
}

@keyframes ritualTitleShimmer {
  0% { background-position: 150% 0; }
  100% { background-position: -150% 0; }
}

/* Text staggered fade-up when slide becomes active */
#rituals-swiper .swiper-slide-active .ritual-text-stagger > *:nth-child(1) {
  animation: ritualTextFadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.08s both;
}
#rituals-swiper .swiper-slide-active .ritual-text-stagger > *:nth-child(2) {
  animation: ritualTextFadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.16s both;
