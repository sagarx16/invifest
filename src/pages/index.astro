        <p class="font-['Montserrat'] text-[#6E5F55] text-xs sm:text-sm mt-3 max-w-xl mx-auto">Please grace each auspicious function with your presence and blessings.</p>
      </div>

      <!-- Ceremonies Alternating Zigzag Timeline -->
      <div class="cer-timeline relative mx-auto">
        <!-- Continuous Vertical Gold Line Track -->
        <div class="cer-timeline-track" aria-hidden="true">
          <div class="cer-timeline-line-base"></div>
          <div class="cer-timeline-line-progress" id="cer-line-progress"></div>
          <div class="cer-tracker-dot" id="cer-tracker-dot"></div>
        </div>

        {ceremonies.map((cer, index) => {
          const isEven = index % 2 === 0;
          return (
            <div class={`cer-row ${isEven ? 'cer-row--even' : 'cer-row--odd'}`} data-index={index}>
              <!-- Text Column -->
              <div class="cer-col-text">
                <div class={`cer-card ${cer.isVivah ? 'cer-card--vivah' : ''}`}>
                  <span class={`cer-label ${cer.isVivah ? 'cer-label--gold' : ''}`}>
                    {(() => {
                      const parts = cer.label.split(' · ');
                      if (parts.length === 3) {
                        return <>{parts[0]} · {parts[1]} · <strong class="cer-label-date font-bold">{parts[2]}</strong></>;
                      }
                      return cer.label;
                    })()}
                  </span>
                  <h3 class="cer-title">{cer.title}</h3>
                  <p class="cer-desc">{cer.desc}</p>
                  <div class="cer-divider"></div>
                  <div class="cer-meta">
                    {cer.meta.map((m) => (
                      <div class={`cer-meta-row ${m.type === 'calendar' ? 'cer-meta-row--date cer-date-sweep-wrap' : ''}`}>
                        {m.type === 'calendar' && (
                          <span class="cer-date-sweep" aria-hidden="true"></span>
                        )}
                        {m.type === 'calendar' && (
                          <svg class="cer-icon cer-icon--calendar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        )}
                        {m.type === 'time' && (
                          <svg class="cer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        )}
                        {m.type === 'procession' && (
                          <svg class="cer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2"></circle><path d="M10 22v-6l-2-2v-4l4-2 4 2v4l-2 2v6"></path></svg>
                        )}
                        {m.type === 'venue' && (
                          <svg class="cer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        )}
                        <span class={m.type === 'calendar' ? 'cer-date-text' : 'cer-meta-text'}>{m.text}</span>
                      </div>
                    ))}
                  </div>
                  <div class="cer-dress">
                    <span class="cer-dress-label">Dress Code</span>
                    <div class="cer-swatches">
                      {cer.swatches.map((sw) => (
                        <span class="cer-swatch" style={`background:${sw};`}></span>
                      ))}
                    </div>
                    <span class="cer-dress-name">{cer.dressLabel}</span>
                  </div>
                </div>
              </div>

              <!-- Center Number Circle on Vertical Line -->
              <div class="cer-center">
                <div class={`cer-node ${cer.isVivah ? 'cer-node--gold' : ''}`}>
                  <div class="cer-node-ripple" aria-hidden="true"></div>
                  <span>{cer.num}</span>
                </div>
              </div>

              <!-- Photo Column -->
              <div class="cer-col-photo">
                <div class="cer-photo-wrap">
                  <Picture
                    src={cer.img}
                    formats={['avif', 'webp']}
                    fallbackFormat="jpg"
                    alt={cer.alt}
                    loading="lazy"
                    decoding="async"
                    widths={[400, 600, 800]}
                    sizes="(max-width: 768px) 100vw, 520px"
                    quality={80}
                    class="w-full h-full object-cover"
                    style={`object-position: ${cer.imgPos};`}
                  />
                  <div class="cer-photo-overlay"></div>
                </div>
              </div>
            </div>
          );
        })}
      </div><!-- /.cer-timeline -->
    </div>
  </section>


  <!-- ========== SACRED RITUALS (PHOTO CAROUSEL) ========== -->
  <section id="rituals" class="py-16 sm:py-24 px-0 relative reveal-section overflow-hidden select-none" style="background: radial-gradient(circle at 50% 45%, rgba(247,235,200,0.45) 0%, rgba(250,246,240,0.85) 60%, #FAF6F0 100%);">
