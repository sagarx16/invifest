                      <button
                        type="button"
                        class="ritual-read-more-btn hidden inline-flex items-center gap-1.5 mt-1.5 text-[11px] font-['Cinzel'] font-semibold tracking-wider text-[#DFB756] hover:text-[#FFF5D6] focus:outline-none cursor-pointer select-none transition-colors duration-200"
                        aria-expanded="false"
                        aria-label={`Read full description for ${slide.title}`}
