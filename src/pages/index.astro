                    class="absolute inset-x-0 top-0 h-32 pointer-events-none z-15"
                    style="background: linear-gradient(180deg, rgba(20,4,8,0.75) 0%, rgba(20,4,8,0.3) 55%, transparent 100%);"
                  ></div>

                  <!-- Bottom Deep Gradient (Contrasting Maroon-Black for Text Readability) -->
                  <div
                    class="absolute inset-x-0 bottom-0 h-4/5 pointer-events-none z-15"
                    style="background: linear-gradient(180deg, transparent 0%, rgba(26,6,10,0.35) 25%, rgba(26,6,10,0.88) 60%, rgba(26,6,10,0.98) 96%);"
                  ></div>

                  <!-- Roman Number Chip at Top-Left -->
                  <div class="absolute top-6 left-6 z-25 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] sm:text-[11px] font-['Cinzel'] font-bold tracking-[0.2em] text-[#F3E5AB] bg-[rgba(26,6,10,0.92)] border border-[#D4AF37]/60 shadow-md">
                    <span class="text-[#DFB756] text-[8px]">✦</span>
                    <span>{slide.num}</span>
                  </div>

                  <!-- Bottom Text Content Staggered -->
                  <div class="absolute inset-x-0 bottom-0 p-5 sm:p-7 z-25 flex flex-col items-start text-left ritual-text-stagger">
                    <!-- Hindi Name in Devanagari Serif -->
                    <span class="font-['Noto_Serif_Devanagari','Tiro_Devanagari_Hindi',serif] text-sm sm:text-base font-semibold text-[#DFB756] tracking-wider mb-0.5 drop-shadow-sm">
                      {slide.hindi}
