---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mukesh Weds Puja | Wedding Invitation" description="With divine blessings and ancestral grace, you are cordially invited to the Royal Wedding of Mukesh Ojha & Puja on 11th December 2026 at Dugda, Bokaro.">

  <!-- ========== GRAND OPENING ENVELOPE CINEMATIC ========== -->
  <div id="opening-cinematic" class="fixed inset-0 z-[10000] flex flex-col justify-between items-center p-4 sm:p-6 select-none transition-all duration-1000" style="background:#0B0A1A;">
    <!-- Background Radial Ambient Glow -->
    <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(circle at 50% 50%, rgba(59,10,30,0.6) 0%, rgba(11,10,26,0.95) 70%, #0B0A1A 100%);"></div>
    <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(circle at 50% 30%, rgba(224,184,79,0.14) 0%, transparent 60%);"></div>

    <!-- Top Header Bar -->
    <div class="relative z-10 w-full max-w-4xl flex items-center justify-between pt-1 sm:pt-2">
      <div class="flex items-center gap-2">
        <span class="text-[#E0B84F] text-xs">✦</span>
        <span class="font-['Playfair_Display'] text-[#FED467] text-xs sm:text-sm tracking-widest uppercase">॥ श्री गणेशाय नमः ॥</span>
      </div>
      <div class="flex items-center gap-2">
        <button id="cinematic-unmute-btn" class="px-3 py-1.5 rounded-full text-[10px] tracking-wider uppercase font-['Montserrat'] font-semibold flex items-center gap-1.5 transition-all hover:bg-white/10" style="background:rgba(31,30,47,0.8);border:1px solid rgba(224,184,79,0.3);color:#FED467;">
          <span id="cinematic-sound-icon" class="flex items-center">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <line x1="23" y1="9" x2="17" y2="15"></line>
              <line x1="17" y1="9" x2="23" y2="15"></line>
            </svg>
          </span>
          <span id="cinematic-sound-text">Unmute</span>
        </button>
        <button id="cinematic-skip-btn" class="px-3.5 py-1.5 rounded-full text-[10px] tracking-[0.15em] uppercase font-['Montserrat'] font-bold transition-all hover:bg-white/10" style="background:rgba(11,10,26,0.7);border:1px solid rgba(224,184,79,0.25);color:#D1C5B1;">
          Skip Intro →
        </button>
      </div>
    </div>

    <!-- Center Stage: Royal Video Frame -->
    <div class="relative z-10 my-auto flex flex-col items-center">
      <div class="text-center mb-2.5 sm:mb-3">
        <div class="w-12 h-12 mx-auto mb-2 p-1 rounded-full bg-[#1F1E2F]/80 border border-[#E0B84F]/40 shadow-lg flex items-center justify-center">
          <img src="/images/seal.png" alt="M&P Seal" class="w-10 h-10 object-contain drop-shadow-[0_0_8px_rgba(254,212,103,0.5)]" />
        </div>
        <p class="font-['Montserrat'] text-[9px] sm:text-[10px] tracking-[0.3em] uppercase text-[#E0B84F] mb-1">A Royal Beginning</p>
        <h2 class="font-['Playfair_Display'] text-xl sm:text-2xl md:text-3xl font-semibold text-[#FED467]">Mukesh Ojha &amp; Puja</h2>
      </div>

      <!-- Video Container with Luxury Golden Border & Shadow -->
      <div class="relative group cursor-pointer w-[280px] xs:w-[320px] sm:w-[350px] md:w-[380px] aspect-[768/1344] max-h-[62vh] sm:max-h-[66vh] rounded-3xl overflow-hidden shadow-[0_0_50px_rgba(224,184,79,0.35),0_20px_40px_rgba(0,0,0,0.8)] border-2 border-[#E0B84F]/50 bg-[#0B0A1A]" id="video-card">
        <video
          id="opening-video"
          playsinline
          autoplay
          muted
          poster="/images/video_thumb.jpg"
          class="w-full h-full object-cover"
        >
          <source src="/videos/opening.mp4" type="video/mp4" />
        </video>

        <!-- Tap to Unmute Overlay Hint -->
        <div id="unmute-badge" class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-[9px] font-['Montserrat'] font-semibold tracking-wider uppercase flex items-center gap-1.5 transition-opacity" style="background:rgba(11,10,26,0.85);backdrop-filter:blur(8px);border:1px solid rgba(224,184,79,0.3);color:#FED467;">
          <svg class="w-3 h-3 text-[#FED467]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          </svg>
          <span>Tap for sound</span>
        </div>

        <!-- Video Progress Bar at Bottom of Video Frame -->
        <div class="absolute bottom-0 left-0 right-0 h-1 bg-white/20">
          <div id="video-progress-fill" class="h-full bg-gradient-to-r from-[#FED467] to-[#E0B84F] transition-all duration-100" style="width:0%;"></div>
        </div>
      </div>
    </div>

    <!-- Bottom Action Area -->
    <div class="relative z-10 w-full max-w-md flex flex-col items-center pb-2 text-center">
      <button id="cinematic-enter-btn" class="w-full sm:w-auto px-8 py-3.5 rounded-full font-['Montserrat'] text-[10px] sm:text-[11px] tracking-[0.2em] uppercase font-bold transition-all duration-300 ripple-btn shine-btn relative overflow-hidden shadow-[0_0_30px_rgba(224,184,79,0.4)]" style="background:linear-gradient(135deg,#F4E3B5,#E0B84F,#B88E28);color:#251A00;">
        Open Royal Invitation · प्रवेश करें ✦
      </button>
      <p class="font-['Montserrat'] text-[9px] sm:text-[10px] tracking-widest text-[#D1C5B1] opacity-70 mt-2">
        11th December 2026 · Dugda, Bokaro · #MukeshWedsPuja
      </p>
    </div>
  </div>

  <!-- ========== FLOATING PETALS CANVAS ========== -->
  <canvas id="petals-canvas" class="fixed inset-0 pointer-events-none z-[6]" style="opacity:0.7;"></canvas>

  <!-- ========== THREE.JS HERO BG ========== -->
  <canvas id="hero-three" class="fixed inset-0 pointer-events-none z-[2]"></canvas>

  <!-- ========== NAVBAR ========== -->
  <header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500" style="background:rgba(11,10,26,0.0);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-3">
      <a href="#hero" class="flex items-center gap-2.5 sm:gap-3 group">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-[#E0B84F]/40 p-0.5 flex items-center justify-center flex-shrink-0 bg-[#0B0A1A]">
          <img src="/images/seal.png" alt="M&P Royal Seal" class="w-full h-full object-contain" />
        </div>
        <div>
          <p class="font-['Playfair_Display'] text-[#FED467] text-sm sm:text-base font-semibold leading-tight">Mukesh &amp; Puja</p>
          <p class="text-[9px] sm:text-[10px] tracking-[0.18em] sm:tracking-[0.2em] uppercase text-[#D1C5B1] opacity-70">11 Dec 2026 · Bokaro</p>
        </div>
      </a>
      <nav class="hidden xl:flex items-center gap-1 px-3 py-2 rounded-full text-xs" style="background:rgba(11,10,26,0.6);backdrop-filter:blur(12px);border:1px solid rgba(224,184,79,0.15);">
        {['Blessings','Couple','Story','Events','Venue','Gallery','RSVP'].map(s => (
          <a href={`#${s.toLowerCase()}`} class="px-3 py-1.5 rounded-full tracking-[0.15em] uppercase font-['Montserrat'] font-semibold text-[10px] text-[#D1C5B1] hover:text-[#FED467] hover:bg-white/5 transition-all duration-300">{s}</a>
        ))}
      </nav>
      <div class="flex items-center gap-2 sm:gap-3">
        <button id="audio-toggle" aria-label="Toggle music" class="hidden sm:flex items-center gap-2 px-3 py-2 rounded-full text-[10px] tracking-[0.15em] uppercase font-semibold transition-all duration-300 magnetic-btn ripple-btn" style="background:rgba(11,10,26,0.7);border:1px solid rgba(224,184,79,0.25);color:#E0B84F;">
          <span id="audio-icon" class="flex items-center">
            <svg class="w-3.5 h-3.5 text-[#E0B84F]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18V5l12-2v13"></path>
              <circle cx="6" cy="18" r="3"></circle>
              <circle cx="18" cy="16" r="3"></circle>
            </svg>
          </span>
          <span class="hidden md:inline">Shehnai</span>
        </button>
        <a href="#rsvp" class="px-3.5 sm:px-5 py-1.5 sm:py-2 rounded-full text-[9px] sm:text-[10px] tracking-[0.15em] sm:tracking-[0.2em] uppercase font-['Montserrat'] font-bold transition-all duration-300 ripple-btn shine-btn relative overflow-hidden" style="background:linear-gradient(135deg,#F4E3B5 0%,#E0B84F 50%,#B88E28 100%);color:#251A00;box-shadow:0 0 20px rgba(224,184,79,0.35);">RSVP</a>
        <button id="mobile-menu-btn" aria-label="Toggle mobile menu" class="xl:hidden w-9 h-9 rounded-full flex flex-col items-center justify-center gap-1 border border-[#E0B84F]/30 bg-[#0B0A1A]/80 text-[#E0B84F] ripple-btn">
          <span class="w-4 h-0.5 bg-[#E0B84F] transition-transform duration-300" id="m-bar-1"></span>
          <span class="w-4 h-0.5 bg-[#E0B84F] transition-opacity duration-300" id="m-bar-2"></span>
          <span class="w-4 h-0.5 bg-[#E0B84F] transition-transform duration-300" id="m-bar-3"></span>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-drawer" class="fixed inset-0 z-40 bg-[#0B0A1A]/95 backdrop-blur-2xl hidden flex-col justify-between p-6 pt-24 transition-all duration-300">
    <div class="flex flex-col items-center text-center space-y-3 my-auto">
      <div class="w-14 h-14 rounded-full border border-[#E0B84F]/50 p-1 flex items-center justify-center mb-1 shadow-lg bg-[#0B0A1A]">
        <img src="/images/seal.png" alt="M&P Seal" class="w-full h-full object-contain" />
      </div>
      <p class="font-['Playfair_Display'] text-[#FED467] text-2xl font-semibold">Mukesh Ojha &amp; Puja</p>
      <p class="text-[10px] tracking-[0.2em] uppercase text-[#D1C5B1]">11 December 2026 · Dugda, Bokaro</p>
      <div class="h-px w-24 my-2" style="background:linear-gradient(90deg,transparent,#E0B84F,transparent);"></div>
      <nav class="flex flex-col items-center space-y-2.5 pt-2">
        {[
          {name:'Divine Blessings', href:'#blessings'},
          {name:'The Royal Duo', href:'#couple'},
          {name:'Sacred Story', href:'#story'},
          {name:'Festivities & Itinerary', href:'#events'},
          {name:'Royal Venue', href:'#venue'},
          {name:'Cinematic Gallery', href:'#gallery'},
          {name:'Confirm RSVP', href:'#rsvp'},
        ].map(item => (
          <a href={item.href} class="mobile-nav-link text-sm font-['Montserrat'] uppercase tracking-[0.2em] font-medium text-[#E4E0F7] hover:text-[#FED467] py-1 transition-colors">
            ✦ {item.name}
          </a>
        ))}
      </nav>
    </div>
    <div class="flex flex-col items-center gap-3 pb-6">
      <a href="#rsvp" class="mobile-nav-link w-full max-w-xs py-3.5 text-center rounded-full text-xs tracking-[0.2em] uppercase font-['Montserrat'] font-bold ripple-btn shine-btn" style="background:linear-gradient(135deg,#F4E3B5,#E0B84F,#B88E28);color:#251A00;box-shadow:0 0 20px rgba(224,184,79,0.35);">
        Confirm RSVP ✦
      </a>
      <p class="text-[10px] text-[#D1C5B1]/70 tracking-widest uppercase">#MukeshWedsPuja</p>
    </div>
  </div>

  <!-- ========== HERO SECTION ========== -->
  <section id="hero" class="relative min-h-screen flex flex-col items-center justify-center text-center px-6 overflow-hidden pt-20">
    <!-- Hero Royal Background Image (Mukesh & Puja) -->
    <div class="absolute inset-0 z-[1] overflow-hidden pointer-events-none">
      <img
        src="/hero.jpg"
        alt="Mukesh & Puja Royal Portrait"
        class="w-full h-full object-cover object-center sm:object-[center_30%] scale-105 transition-transform duration-1000"
      />
      <!-- Luxury Dark Night & Royal Gold/Burgundy Tint Overlays for Royal Contrast -->
      <div class="absolute inset-0 bg-[#0B0A1A]/70 mix-blend-multiply"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#0B0A1A] via-[#0B0A1A]/45 to-[#0B0A1A]/80"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#0B0A1A]/75 via-transparent to-[#0B0A1A]/75"></div>
      <div class="absolute inset-0" style="background:radial-gradient(circle at 50% 45%, rgba(59,10,30,0.4) 0%, rgba(11,10,26,0.85) 80%);"></div>
    </div>

    <!-- Parallax layers -->
    <div class="parallax-layer absolute inset-0 z-[3]" data-depth="0.05" style="background:radial-gradient(ellipse at 50% 60%,rgba(59,10,30,0.4) 0%,transparent 70%);"></div>
    <div class="parallax-layer absolute inset-0 z-[3]" data-depth="0.1" style="background:radial-gradient(ellipse at 30% 40%,rgba(224,184,79,0.08) 0%,transparent 60%);"></div>

    <!-- Palace silhouette SVG layers -->
    <div class="parallax-layer absolute bottom-0 left-0 right-0 z-[4]" data-depth="0.3">
      <svg viewBox="0 0 1440 400" preserveAspectRatio="xMidYMax slice" class="w-full opacity-20">
        <path d="M0,400 L0,200 Q60,150 120,200 L120,120 Q150,80 180,120 L180,80 Q200,40 220,80 L220,120 Q250,80 280,120 L280,200 Q340,150 400,200 L400,250 Q460,200 520,250 Q580,200 640,180 Q700,160 760,180 Q820,200 880,220 Q940,200 1000,220 Q1060,200 1120,180 L1120,120 Q1150,80 1180,120 L1180,80 Q1200,40 1220,80 L1220,120 Q1250,80 1280,120 L1280,200 Q1340,150 1400,200 L1440,180 L1440,400 Z" fill="#E0B84F"/>
      </svg>
    </div>
    <div class="parallax-layer absolute bottom-0 left-0 right-0 z-[4]" data-depth="0.5">
      <svg viewBox="0 0 1440 300" preserveAspectRatio="xMidYMax slice" class="w-full opacity-15">
        <path d="M0,300 L0,150 Q80,100 160,150 L160,80 Q190,40 220,80 L220,150 Q300,100 380,150 Q460,100 540,130 Q620,100 700,120 Q780,100 860,130 Q940,100 1020,120 Q1100,100 1180,130 L1180,80 Q1210,40 1240,80 L1240,150 Q1320,100 1400,150 L1440,130 L1440,300 Z" fill="#FFB1C7"/>
      </svg>
    </div>

    <!-- Rotating Mandala SVG -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-[4]">
      <svg id="hero-mandala" width="600" height="600" viewBox="0 0 600 600" class="opacity-10" style="animation: spin 60s linear infinite;">
        <defs>
          <style>@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}</style>
        </defs>
        <g transform="translate(300,300)">
          {Array.from({length: 16}).map((_, i) => (
            <g transform={`rotate(${i * 22.5})`}>
              <ellipse cx="0" cy="-200" rx="8" ry="40" fill="none" stroke="#E0B84F" stroke-width="0.8" opacity="0.8"/>
              <circle cx="0" cy="-160" r="4" fill="none" stroke="#E0B84F" stroke-width="0.6" opacity="0.6"/>
              <path d={`M0,-240 Q10,-220 0,-200 Q-10,-220 0,-240`} fill="#E0B84F" opacity="0.4"/>
            </g>
          ))}
          <circle cx="0" cy="0" r="80" fill="none" stroke="#E0B84F" stroke-width="0.8" opacity="0.5"/>
          <circle cx="0" cy="0" r="120" fill="none" stroke="#E0B84F" stroke-width="0.5" opacity="0.4" stroke-dasharray="8,8"/>
          <circle cx="0" cy="0" r="160" fill="none" stroke="#E0B84F" stroke-width="0.4" opacity="0.3"/>
          <circle cx="0" cy="0" r="20" fill="#E0B84F" opacity="0.15"/>
        </g>
      </svg>
    </div>

    <!-- Content -->
    <div class="relative z-[8] max-w-5xl mx-auto flex flex-col items-center">
      <div id="hero-tag" class="inline-flex items-center gap-3 px-5 py-2 rounded-full mb-8 opacity-0" style="background:rgba(31,30,47,0.6);backdrop-filter:blur(12px);border:1px solid rgba(224,184,79,0.2);">
        <span class="text-[#E0B84F]">✦</span>
        <span class="font-['Playfair_Display'] text-[#E0B84F] text-base tracking-widest">॥ श्री गणेशाय नमः ॥</span>
        <span class="text-[#E0B84F]">✦</span>
      </div>

      <p id="hero-subtitle" class="font-['Montserrat'] text-[11px] tracking-[0.35em] uppercase text-[#D1C5B1] mb-6 opacity-0">The Auspicious Wedding Of</p>

      <div class="mb-4">
        <h1 id="hero-groom" class="font-['Playfair_Display'] font-semibold leading-none text-[#FED467] opacity-0 flex justify-center flex-wrap" style="font-size:clamp(32px,7.5vw,84px);letter-spacing:0.03em;text-shadow:0 0 35px rgba(254,212,103,0.4);">
          {"Mukesh Ojha".split("").map((ch) => (
            <span class="hero-char-groom inline-block">{ch === " " ? "\u00A0" : ch}</span>
          ))}
        </h1>
        <div id="hero-amp" class="flex items-center justify-center gap-3 sm:gap-6 my-2 sm:my-4 opacity-0">
          <div class="h-px w-16 sm:w-40" style="background:linear-gradient(90deg,transparent,#E0B84F);"></div>
          <span class="font-['Playfair_Display'] italic text-[#FFB1C7]" style="font-size:clamp(22px,3.5vw,42px);">&amp;</span>
          <div class="h-px w-16 sm:w-40" style="background:linear-gradient(270deg,transparent,#E0B84F);"></div>
        </div>
        <h1 id="hero-bride" class="font-['Playfair_Display'] font-semibold leading-none text-[#FFB1C7] opacity-0 flex justify-center flex-wrap" style="font-size:clamp(32px,7.5vw,84px);letter-spacing:0.03em;text-shadow:0 0 35px rgba(255,177,199,0.4);">
          {"Puja".split("").map((ch) => (
            <span class="hero-char-bride inline-block">{ch === " " ? "\u00A0" : ch}</span>
          ))}
        </h1>
      </div>

      <!-- Imperial Crest Seal Badge from Stitch -->
      <div class="w-14 h-14 sm:w-16 sm:h-16 my-2 p-1 rounded-full bg-[#1F1E2F]/80 border border-[#E0B84F]/40 shadow-xl flex items-center justify-center">
        <img alt="Mukesh & Puja Royal Wedding Seal" class="w-12 h-12 sm:w-14 sm:h-14 object-contain drop-shadow-[0_0_10px_rgba(254,212,103,0.5)]" src="/images/seal.png" />
      </div>

      <p id="hero-invite" class="font-['Montserrat'] font-light text-[#D1C5B1] max-w-2xl leading-relaxed mb-6 opacity-0 px-2" style="font-size:clamp(13px,1.5vw,17px);">
        Cordially invite you to celebrate our sacred union amidst palatial grace, ancestral rites, and celestial splendour.
      </p>

      <div id="hero-date" class="inline-flex flex-col sm:flex-row items-center gap-1.5 sm:gap-3 px-5 py-2.5 sm:px-6 sm:py-3 rounded-2xl sm:rounded-full mb-8 sm:mb-10 opacity-0" style="background:rgba(31,30,47,0.7);border:1px solid rgba(224,184,79,0.25);">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-[#E0B84F] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span class="font-['Playfair_Display'] text-[#FED467] font-semibold text-sm sm:text-lg">Friday, 11th December 2026</span>
        </div>
        <span class="hidden sm:inline w-1.5 h-1.5 rounded-full bg-[#E0B84F]"></span>
        <span class="font-['Montserrat'] text-[10px] sm:text-[11px] tracking-[0.15em] uppercase text-[#D1C5B1]">Dugda, Bokaro</span>
      </div>

      <!-- Flip-Clock Countdown -->
      <div id="countdown" class="grid grid-cols-4 gap-2 sm:gap-4 mb-8 sm:mb-10 opacity-0 max-w-xs sm:max-w-md w-full justify-items-center">
        {['days','hours','minutes','seconds'].map(u => (
          <div class="flex flex-col items-center gap-1.5">
            <div class="flip-clock-card" id={`cd-${u}`} style="width:clamp(56px,18vw,88px);height:clamp(70px,20vw,104px);font-size:clamp(1.4rem,4vw,2.5rem);">
              <span id={`cd-${u}-val`}>0</span>
            </div>
            <span class="font-['Montserrat'] text-[8px] sm:text-[9px] tracking-[0.18em] uppercase text-[#D1C5B1]">{u}</span>
          </div>
        ))}
      </div>

      <!-- CTA Buttons -->
      <div id="hero-ctas" class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-3 sm:gap-4 w-full max-w-xs sm:max-w-2xl opacity-0">
        <a href="#events" class="w-full sm:w-auto text-center px-7 py-3 rounded-full font-['Montserrat'] text-[10px] sm:text-[11px] tracking-[0.2em] uppercase font-bold transition-all duration-300 ripple-btn shine-btn relative overflow-hidden magnetic-btn" style="background:linear-gradient(135deg,#F4E3B5,#E0B84F,#B88E28);color:#251A00;box-shadow:0 0 25px rgba(224,184,79,0.4);">
          Explore Celebrations
        </a>
        <button id="replay-envelope-btn" class="w-full sm:w-auto text-center justify-center px-6 py-3 rounded-full font-['Montserrat'] text-[10px] sm:text-[11px] tracking-[0.2em] uppercase font-semibold transition-all duration-300 ripple-btn magnetic-btn flex items-center gap-2" style="background:rgba(59,10,30,0.6);border:1px solid rgba(255,177,199,0.4);color:#FFB1C7;">
          <svg class="w-3.5 h-3.5 text-[#FFB1C7]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
