  import { EffectCoverflow, Navigation, Pagination, Autoplay, Keyboard, A11y } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';
  import 'swiper/css/effect-coverflow';

  gsap.registerPlugin(ScrollTrigger);

  // Lenis smooth scroll
  const lenis = new Lenis({ lerp: 0.08, smoothWheel: true });
  (window as any).lenis = lenis;
  lenis.on('scroll', ScrollTrigger.update);
  gsap.ticker.add((time) => lenis.raf(time * 1000));
  gsap.ticker.lagSmoothing(0);

  // ── GRAND OPENING ENVELOPE CINEMATIC & HERO REVEAL ────────────────
  const openingCinematic = document.getElementById('opening-cinematic');
  const openingVideo = document.getElementById('opening-video') as HTMLVideoElement | null;
  const unmuteBtn = document.getElementById('cinematic-unmute-btn');
  const soundIcon = document.getElementById('cinematic-sound-icon');
  const soundText = document.getElementById('cinematic-sound-text');
  const unmuteBadge = document.getElementById('unmute-badge');
  const skipBtn = document.getElementById('cinematic-skip-btn');
  const enterBtn = document.getElementById('cinematic-enter-btn');
  const videoProgressFill = document.getElementById('video-progress-fill');
  const videoCard = document.getElementById('video-card');
  const replayEnvelopeBtn = document.getElementById('replay-envelope-btn');

  let heroRevealed = false;
  let introDismissed = false;

  function triggerRevealHero() {
    if (heroRevealed) return;
    heroRevealed = true;
    revealHero();
  }

  function dismissIntro() {
    if (introDismissed) return;
    introDismissed = true;

    if (openingVideo) {
      openingVideo.pause();
    }

    if (openingCinematic) {
      openingCinematic.style.transition = 'opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1)';
      openingCinematic.style.opacity = '0';
      openingCinematic.style.transform = 'scale(1.04)';
      openingCinematic.style.pointerEvents = 'none';
      setTimeout(() => {
        openingCinematic.style.display = 'none';
      }, 950);
    }

    // Play golden wedding chime
    royalAudio.playDoorOpenSound();

    // Immediately start playing the wedding song ("Aaj Sajeya") as soon as video closes
    royalAudio.playSong((isPlaying) => {
      updateAudioUI(isPlaying);
    });

    triggerRevealHero();
  }

  // Ambient background video element
  const openingVideoAmbient = document.getElementById('opening-video-ambient') as HTMLVideoElement | null;

  const soundOnSvg = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>';
  const soundOffSvg = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>';

  function setVideoAudioState(isSoundOn: boolean) {
    if (!openingVideo) return;
    openingVideo.muted = !isSoundOn;
    if (isSoundOn) {
      openingVideo.volume = 1;
      if (soundIcon) soundIcon.innerHTML = soundOnSvg;
      if (soundText) soundText.textContent = 'Sound ON';
    } else {
      if (soundIcon) soundIcon.innerHTML = soundOffSvg;
      if (soundText) soundText.textContent = 'Mute';
    }
  }

  function toggleVideoSound() {
    if (!openingVideo) return;
    // Always keep sound ON!
    setVideoAudioState(true);
    openingVideo.volume = 1.0;
    openingVideo.play().catch(() => {});
  }

  let userManuallyMuted = false;

  // Enforce sound on video interaction, but respect manual user mute after video
  const enforceAllSoundActive = () => {
    if (openingVideo && !introDismissed) {
      openingVideo.muted = false;
      openingVideo.volume = 1.0;
      setVideoAudioState(true);
      if (openingVideo.paused) {
        openingVideo.play().catch(() => {});
      }
    }
    // Only auto-play if user did NOT explicitly mute/pause!
    if (introDismissed && !royalAudio.getIsPlaying() && !userManuallyMuted) {
      royalAudio.playSong((isPlaying) => updateAudioUI(isPlaying));
    }
  };

  ['click', 'touchstart', 'touchend', 'pointerdown', 'keydown', 'scroll'].forEach((evt) => {
    window.addEventListener(evt, enforceAllSoundActive, { passive: true });
  });

  videoCard?.addEventListener('click', () => {
    enforceAllSoundActive();
    if (openingVideo && openingVideo.paused) {
      openingVideo.play().catch(() => {});
    }
  });

  unmuteBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    enforceAllSoundActive();
  });

  enterBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    dismissIntro();
  });

  if (openingVideo) {
    // Keep unmuted by default
    openingVideo.muted = false;
    openingVideo.volume = 1.0;

    const startPlayback = () => {
      const playPromise = openingVideo.play();
      if (playPromise !== undefined) {
        playPromise.then(() => {
          setVideoAudioState(true);
        }).catch(() => {
          // If browser policy prevents unmuted autoplay before user interaction:
          openingVideo.muted = true;
          openingVideo.play().catch(() => {});

          const unmuteOnFirstGesture = () => {
            if (openingVideo && !introDismissed) {
              setVideoAudioState(true);
            }
            window.removeEventListener('click', unmuteOnFirstGesture, { capture: true });
            window.removeEventListener('touchstart', unmuteOnFirstGesture, { capture: true });
            window.removeEventListener('pointerdown', unmuteOnFirstGesture, { capture: true });
            window.removeEventListener('keydown', unmuteOnFirstGesture, { capture: true });
          };

          window.addEventListener('click', unmuteOnFirstGesture, { once: true, capture: true });
          window.addEventListener('touchstart', unmuteOnFirstGesture, { once: true, capture: true });
          window.addEventListener('pointerdown', unmuteOnFirstGesture, { once: true, capture: true });
          window.addEventListener('keydown', unmuteOnFirstGesture, { once: true, capture: true });
        });
      }
    };

    startPlayback();

    openingVideo.addEventListener('timeupdate', () => {
      if (openingVideo.duration && videoProgressFill) {
        const pct = (openingVideo.currentTime / openingVideo.duration) * 100;
        videoProgressFill.style.width = pct + '%';
      }
      if (openingVideoAmbient && Math.abs(openingVideoAmbient.currentTime - openingVideo.currentTime) > 0.5) {
        openingVideoAmbient.currentTime = openingVideo.currentTime;
      }
    });

    openingVideo.addEventListener('ended', () => {
      setTimeout(() => {
        dismissIntro();
      }, 600);
    });
  }

  // Replay envelope video from hero section
  replayEnvelopeBtn?.addEventListener('click', () => {
    if (!openingCinematic || !openingVideo) return;
    // Pause background song while video is playing
    royalAudio.pauseSong((isPlaying) => {
      updateAudioUI(isPlaying);
    });
    introDismissed = false;
    openingCinematic.style.display = 'flex';
    openingCinematic.style.pointerEvents = 'auto';
    openingVideo.currentTime = 0;
    setVideoAudioState(true);
    requestAnimationFrame(() => {
      openingCinematic.style.opacity = '1';
      openingCinematic.style.transform = 'scale(1)';
      openingVideo.play().catch(() => {});
    });
  });


  function revealHero() {
    if (typeof window !== 'undefined' && window.location.search.includes('skipIntro')) {
      gsap.set(['#hero-tag','#hero-subtitle','#hero-groom','#hero-amp','#hero-bride','#hero-invite','#hero-ctas','#scroll-indicator'], {
        opacity: 1, y: 0
      });
      return;
    }
    const tl = gsap.timeline();
    tl.to('#hero-tag', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' })
      .to('#hero-subtitle', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.4')
      .to('#hero-groom', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, '-=0.3')
      .fromTo('.hero-names-flash', { opacity: 0, scale: 0.85 }, { opacity: 0.85, scale: 1.08, duration: 0.28, yoyo: true, repeat: 1, ease: 'power2.inOut' }, '-=0.4')
      .to('#hero-amp', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.3')
      .to('#hero-bride', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, '-=0.3')
      .to('#hero-invite', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, '-=0.4')
      .to('#hero-ctas', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.3')
      .to('#scroll-indicator', { opacity: 1, duration: 0.6 }, '-=0.1');
  }

  // Set initial states
  gsap.set(['#hero-tag','#hero-subtitle','#hero-groom','#hero-amp','#hero-bride','#hero-invite','#hero-ctas','#scroll-indicator'], {
    y: 30, opacity: 0
  });

  if (typeof window !== 'undefined' && window.location.search.includes('skipIntro')) {
    if (openingCinematic) openingCinematic.style.display = 'none';
    introDismissed = true;
    triggerRevealHero();
  }


  // ── SCROLL-TO-TOP button ─────────────────────────────────────────
  const scrollTopBtn = document.getElementById('scroll-top-btn');
  ScrollTrigger.create({
    start: 'top -400px',
    onEnter: () => scrollTopBtn && gsap.to(scrollTopBtn, { opacity: 1, duration: 0.3 }),
    onLeaveBack: () => scrollTopBtn && gsap.to(scrollTopBtn, { opacity: 0, duration: 0.3 }),
  });

  // ── REVEAL SECTIONS on scroll ─────────────────────────────────────
  document.querySelectorAll('.reveal-section').forEach(el => {
    gsap.fromTo(el,
      { opacity: 0, y: 60 },
      { opacity: 1, y: 0, duration: 1, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 80%', toggleActions: 'play none none reverse' }
      }
    );
  });

  // Ceremonies timeline row stagger
  gsap.fromTo('.cer-row', { opacity: 0, y: 35 }, {
    opacity: 1, y: 0, duration: 0.75, stagger: 0.18, ease: 'power2.out',
    scrollTrigger: { trigger: '#events', start: 'top 70%' }
  });

  const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;


  // Attach calendar download to ceremony buttons
  document.querySelectorAll('.cer-btn').forEach(btn => {
    btn.addEventListener('click', downloadICS);
  });


  // ── MEET THE COUPLE: 3D TILT, GLOW & TAP-TO-SWAP ────────────────

  document.querySelectorAll('.couple-card').forEach(card => {
    const el = card as HTMLElement;
    const glow = el.querySelector('.couple-glow') as HTMLElement | null;

    // Desktop hover: glow + 3D tilt
    if (isFinePointer && !isReducedMotion) {
      el.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = el.getBoundingClientRect();
        const normX = (e.clientX - rect.left) / rect.width - 0.5;
        const normY = (e.clientY - rect.top) / rect.height - 0.5;
        
        // Tilt
        el.style.transform = `perspective(1000px) rotateX(${normY * -6}deg) rotateY(${normX * 6}deg) translateY(-4px)`;
        
        // Glow
        if (glow) {
          glow.style.setProperty('--mx', `${(normX + 0.5) * 100}%`);
          glow.style.setProperty('--my', `${(normY + 0.5) * 100}%`);
          glow.style.opacity = '1';
        }
      });

      el.addEventListener('mouseleave', () => {
        el.style.transform = '';
        if (glow) glow.style.opacity = '0';
      });
    }

    // Tap / Click reveal toggle (desktop click or mobile tap)
    el.addEventListener('click', () => {
      el.classList.toggle('is-swapped');
      const hint = el.querySelector('.hint-text');
      if (hint) {
        hint.textContent = el.classList.contains('is-swapped') ? 'tap to restore' : 'tap to see more';
      }
    });
  });

  // ── MEET THE BRIDE & GROOM: MEETING IN THE MIDDLE (GSAP) ────────
  const coupleSection = document.getElementById('couple');
  const groomFloating = document.querySelector('.groom-detail-floating') as HTMLElement | null;
  const brideFloating = document.querySelector('.bride-detail-floating') as HTMLElement | null;
  const threadPath = document.getElementById('couple-thread-path') as SVGPathElement | null;
  const threadSvg = document.getElementById('couple-gold-thread-svg') as SVGSVGElement | null;
  const centerHeartDisc = document.querySelector('.center-heart-disc') as HTMLElement | null;

  if (coupleSection && groomFloating && brideFloating && threadPath && threadSvg) {
    const updateThreadGeometry = (drawProgress: number) => {
      const svgRect = threadSvg.getBoundingClientRect();
      if (!svgRect.width || !svgRect.height) return;

      const groomRect = groomFloating.getBoundingClientRect();
      const brideRect = brideFloating.getBoundingClientRect();
      const heartRect = centerHeartDisc ? centerHeartDisc.getBoundingClientRect() : null;

      // Centers relative to SVG canvas
      const gX = groomRect.left + groomRect.width / 2 - svgRect.left;
      const gY = groomRect.top + groomRect.height / 2 - svgRect.top;

      const bX = brideRect.left + brideRect.width / 2 - svgRect.left;
      const bY = brideRect.top + brideRect.height / 2 - svgRect.top;

      let hX = (gX + bX) / 2;
      let hY = (gY + bY) / 2;
      if (heartRect) {
        hX = heartRect.left + heartRect.width / 2 - svgRect.left;
        hY = heartRect.top + heartRect.height / 2 - svgRect.top;
      }

      // Smooth curved path passing directly through the center of the heart: Groom Ring -> Center Heart -> Bride Aarsi
      const isDesktop = window.innerWidth >= 1024;
      const d = isDesktop
        ? `M ${gX.toFixed(1)} ${gY.toFixed(1)} Q ${(gX + 60).toFixed(1)} ${hY.toFixed(1)} ${hX.toFixed(1)} ${hY.toFixed(1)} Q ${(bX - 60).toFixed(1)} ${hY.toFixed(1)} ${bX.toFixed(1)} ${bY.toFixed(1)}`
        : `M ${gX.toFixed(1)} ${gY.toFixed(1)} Q ${hX.toFixed(1)} ${(gY + 40).toFixed(1)} ${hX.toFixed(1)} ${hY.toFixed(1)} Q ${hX.toFixed(1)} ${(bY - 40).toFixed(1)} ${bX.toFixed(1)} ${bY.toFixed(1)}`;
      threadPath.setAttribute('d', d);

      const totalLen = threadPath.getTotalLength() || 400;
      threadPath.style.strokeDasharray = `${totalLen}`;
      const clampedP = Math.min(Math.max(drawProgress, 0), 1);
      threadPath.style.strokeDashoffset = `${totalLen * (1 - clampedP)}`;
      threadPath.style.opacity = clampedP > 0.05 ? '1' : '0';
    };

    if (!isReducedMotion) {
      ScrollTrigger.create({
        trigger: '#couple',
        start: 'top 85%',
        end: 'center 45%',
        scrub: 1.2,
        onUpdate: (self) => {
          const p = self.progress; // 0 to 1
          const isDesktop = window.innerWidth >= 1024;

          if (isDesktop) {
            // Desktop: slide inward towards center heart
            const slideDistance = 140; // px
            gsap.set(groomFloating, { x: p * slideDistance, y: 0 });
            gsap.set(brideFloating, { x: -p * slideDistance, y: 0 });
          } else {
            // Mobile: stacked vertically, slide inward toward center heart
            const slideDistance = 48; // px
            gsap.set(groomFloating, { x: 0, y: p * slideDistance });
            gsap.set(brideFloating, { x: 0, y: -p * slideDistance });
          }

          updateThreadGeometry(p);

          // Center heart glowing pulse intensifies when they meet
          if (centerHeartDisc) {
            if (p >= 0.7) {
              centerHeartDisc.classList.add('is-joined');
            } else {
              centerHeartDisc.classList.remove('is-joined');
            }
          }
        }
      });

      window.addEventListener('resize', () => {
        updateThreadGeometry(0.5);
      });
      // Initial render frame
      requestAnimationFrame(() => updateThreadGeometry(0));
    } else {
      // Reduced motion: static connecting thread
      updateThreadGeometry(1);
    }
  }

  // Parallax on mouse move
  document.addEventListener('mousemove', (e) => {
    const xPct = (e.clientX / window.innerWidth - 0.5) * 2;
    const yPct = (e.clientY / window.innerHeight - 0.5) * 2;
    document.querySelectorAll<HTMLElement>('.parallax-layer').forEach(el => {
      const depth = parseFloat(el.dataset.depth || '0.1');
      gsap.to(el, { x: xPct * 40 * depth, y: yPct * 40 * depth, duration: 1, ease: 'power1.out' });
    });
    const mandala = document.getElementById('hero-mandala');
    if (mandala) {
      gsap.to(mandala, { x: xPct * 20, y: yPct * 20, duration: 2, ease: 'power1.out' });
    }
  });

  // ── COUNTDOWN FLIP-CLOCK ──────────────────────────────────────────
  const weddingDate = new Date('2026-12-11T19:00:00+05:30').getTime();
  const prevVals: Record<string, number> = { days: -1, hours: -1, minutes: -1, seconds: -1 };

  function updateCountdown() {
    const now = Date.now();
    const diff = weddingDate - now;
    if (diff <= 0) return;
    const vals = {
      days: Math.floor(diff / 86400000),
      hours: Math.floor((diff % 86400000) / 3600000),
      minutes: Math.floor((diff % 3600000) / 60000),
      seconds: Math.floor((diff % 60000) / 1000),
    };
    Object.entries(vals).forEach(([key, val]) => {
      const el = document.getElementById(`cd-${key}-val`);
      const card = document.getElementById(`cd-${key}`);
      if (el && val !== prevVals[key]) {
        prevVals[key] = val;
        el.textContent = String(val).padStart(2, '0');
        if (card) {
          gsap.fromTo(card, { rotateX: -20, scale: 0.95 }, { rotateX: 0, scale: 1, duration: 0.3, ease: 'power2.out' });
        }
      }
    });
  }
  setInterval(updateCountdown, 1000);
  updateCountdown();

  // ── SAVE THE DATE INTERACTIVE SCRATCH CARDS & SCROLL GATE ─────────
  const STD_STORAGE_KEY = 'mukesh_puja_std_unlocked_v3';
  let isScratchUnlocked = false;

  // Dev-only reset: opening with ?reset=1 in URL clears saved states
  if (typeof window !== 'undefined') {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('reset') === '1') {
      try {
        localStorage.removeItem('mukesh_puja_std_unlocked_v1');
        localStorage.removeItem('mukesh_puja_std_unlocked_v2');
        localStorage.removeItem(STD_STORAGE_KEY);
        sessionStorage.removeItem('mukesh_puja_std_unlocked_v1');
        sessionStorage.removeItem('mukesh_puja_std_unlocked_v2');
        sessionStorage.removeItem(STD_STORAGE_KEY);
      } catch (e) {}
      const cleanUrl = window.location.pathname + window.location.hash;
      window.history.replaceState({}, '', cleanUrl);
    } else if (urlParams.get('unlocked') === '1') {
      isScratchUnlocked = true;
    } else {
      try {
        isScratchUnlocked = localStorage.getItem(STD_STORAGE_KEY) === 'true';
      } catch (e) {
        isScratchUnlocked = false;
      }
    }
  }

  const lockedContentWrapper = document.getElementById('locked-post-save-the-date');
  const lockedCountdownCard = document.getElementById('locked-countdown-card');
  const scratchProgressText = document.getElementById('scratch-progress-text');
  const scratchUnlockedContinue = document.getElementById('scratch-unlocked-continue');
  const scratchContinueBtn = document.getElementById('scratch-continue-btn');
  const scratchCardsContainer = document.getElementById('scratch-cards-container');
  const scratchLockToast = document.getElementById('scratch-lock-toast');

  let lockToastTimer: any = null;
  let isShakingCards = false;

  function triggerLockedFeedback() {
    if (isScratchUnlocked) return;
    if (scratchCardsContainer && !isShakingCards) {
      isShakingCards = true;
      scratchCardsContainer.classList.add('shake-anim');
      setTimeout(() => {
        scratchCardsContainer.classList.remove('shake-anim');
        isShakingCards = false;
      }, 500);
    }
    if (scratchLockToast) {
      scratchLockToast.classList.remove('opacity-0', 'translate-y-4');
      scratchLockToast.classList.add('opacity-100', 'translate-y-0');
      clearTimeout(lockToastTimer);
      lockToastTimer = setTimeout(() => {
        scratchLockToast.classList.remove('opacity-100', 'translate-y-0');
        scratchLockToast.classList.add('opacity-0', 'translate-y-4');
      }, 2400);
    }
  }

  function getSaveTheDateLimit(): number {
    if (isScratchUnlocked) return Infinity;
    const container = document.getElementById('scratch-cards-container');
    if (!container) return Infinity;
    const rect = container.getBoundingClientRect();
    const scrollY = window.scrollY || window.pageYOffset || 0;
    // Clamps exactly where the 3 cards and progress indicator are vertically centered
    return Math.max(0, scrollY + rect.top + rect.height / 2 - window.innerHeight / 2 + 25);
  }

  // Lenis clamp
  lenis.on('scroll', (e: any) => {
    if (!isScratchUnlocked) {
      const limit = getSaveTheDateLimit();
      if (limit < Infinity && e.scroll > limit + 5) {
        lenis.scrollTo(limit, { immediate: true });
        triggerLockedFeedback();
      }
    }
    ScrollTrigger.update();
  });

  // Window scroll clamp
  window.addEventListener('scroll', () => {
    if (!isScratchUnlocked) {
      const limit = getSaveTheDateLimit();
      if (limit < Infinity && window.scrollY > limit + 5) {
        window.scrollTo(0, limit);
        triggerLockedFeedback();
      }
    }
  }, { passive: true });

  // Mouse wheel downwards check when near limit
  window.addEventListener('wheel', (e) => {
    if (!isScratchUnlocked && e.deltaY > 0) {
      const limit = getSaveTheDateLimit();
      const scrollY = window.scrollY || window.pageYOffset || 0;
      if (limit < Infinity && scrollY >= limit - 10) {
        triggerLockedFeedback();
      }
    }
  }, { passive: true });

  // Touch swipe upwards (scrolling down) check when near limit
  let touchStartY = 0;
  window.addEventListener('touchstart', (e) => {
    if (e.touches && e.touches[0]) touchStartY = e.touches[0].clientY;
  }, { passive: true });
  window.addEventListener('touchmove', (e) => {
    if (!isScratchUnlocked && e.touches && e.touches[0]) {
      const dy = touchStartY - e.touches[0].clientY;
      if (dy > 12) {
        const limit = getSaveTheDateLimit();
        const scrollY = window.scrollY || window.pageYOffset || 0;
        if (limit < Infinity && scrollY >= limit - 10) {
          triggerLockedFeedback();
        }
      }
    }
  }, { passive: true });

  // Keyboard navigation downward check
  window.addEventListener('keydown', (e) => {
    if (!isScratchUnlocked) {
      const isDownKey = ['PageDown', 'End', 'ArrowDown', ' '].includes(e.key);
      if (isDownKey && !(e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement)) {
        const limit = getSaveTheDateLimit();
        const scrollY = window.scrollY || window.pageYOffset || 0;
        if (limit < Infinity && scrollY >= limit - 15) {
          if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === 'End' || (e.key === ' ' && !e.shiftKey)) {
            e.preventDefault();
            triggerLockedFeedback();
          }
        }
      }
    }
  });

  // Intercept anchor clicks to locked sections
  document.addEventListener('click', (e) => {
    const anchor = (e.target as HTMLElement)?.closest('a');
    if (anchor && !isScratchUnlocked) {
      const href = anchor.getAttribute('href');
      if (href && href.startsWith('#') && href !== '#' && href !== '#hero' && href !== '#save-the-date') {
        e.preventDefault();
        e.stopPropagation();
        const std = document.getElementById('save-the-date');
        if (std) lenis.scrollTo(std, { duration: 0.8 });
        triggerLockedFeedback();
      }
    }
  }, true);

  // Prevent hash routing to locked sections
  function enforceHashGuard() {
    if (!isScratchUnlocked && window.location.hash && window.location.hash !== '#hero' && window.location.hash !== '#save-the-date') {
      window.location.hash = '#save-the-date';
      triggerLockedFeedback();
    }
  }
  window.addEventListener('hashchange', enforceHashGuard);
  enforceHashGuard();

  function updateProgress(count: number) {
    const diamonds = document.querySelectorAll('#scratch-progress-diamonds .scratch-diamond');
    diamonds.forEach((d, idx) => {
      if (idx < count) {
        d.className = 'scratch-diamond text-[11px] transition-colors duration-300 text-[#B8860B] drop-shadow-[0_0_6px_rgba(212,175,55,0.7)]';
      } else {
        d.className = 'scratch-diamond text-[11px] transition-colors duration-300 text-stone-300';
      }
    });
    if (scratchProgressText) {
      if (count >= 3) {
        scratchProgressText.textContent = '3 / 3 REVEALED · CELEBRATION UNLOCKED';
      } else {
        scratchProgressText.textContent = `${count} / 3 REVEALED`;
      }
    }
  }

  // Draw procedural embossed antique gold foil on canvas
  function drawAntiqueGoldFoil(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D, w: number, h: number) {
    ctx.save();
    // 1. Brushed antique-gold metallic gradient at 135deg
    const grad = ctx.createLinearGradient(0, 0, w, h);
    grad.addColorStop(0, '#B8902F');
    grad.addColorStop(0.32, '#F4E3B5');
    grad.addColorStop(0.68, '#D4AF37');
    grad.addColorStop(1, '#A87B22');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, w, h);

    // 2. Fine brushed metal micro-strokes
    for (let i = 0; i < 46; i++) {
      const y = (h / 46) * i + Math.sin(i) * 2;
      ctx.strokeStyle = i % 2 === 0 ? 'rgba(255, 255, 255, 0.08)' : 'rgba(90, 50, 10, 0.06)';
      ctx.lineWidth = 0.8;
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(w, y + (Math.sin(i * 1.5) * 3));
      ctx.stroke();
    }

    // 3. Fine glitter sparkle noise
    for (let i = 0; i < 85; i++) {
      const gx = Math.random() * w;
      const gy = Math.random() * h;
      const gr = Math.random() * 1.1 + 0.3;
      ctx.fillStyle = i % 3 === 0
        ? 'rgba(255, 255, 255, 0.5)'
        : (i % 3 === 1 ? 'rgba(255, 240, 190, 0.38)' : 'rgba(130, 85, 20, 0.28)');
      ctx.beginPath();
      ctx.arc(gx, gy, gr, 0, Math.PI * 2);
      ctx.fill();
    }

    // Emboss relief helper (stamped metallic coin effect)
    const drawEmboss = (drawFn: () => void, lineWidth = 1) => {
      // Shadow (shifted +0.8, +0.8)
      ctx.save();
      ctx.translate(0.8, 0.8);
      ctx.strokeStyle = 'rgba(95, 55, 10, 0.48)';
      ctx.fillStyle = 'rgba(95, 55, 10, 0.35)';
      ctx.lineWidth = lineWidth;
      drawFn();
      ctx.restore();

      // Highlight (shifted -0.8, -0.8)
      ctx.save();
      ctx.translate(-0.8, -0.8);
      ctx.strokeStyle = 'rgba(255, 250, 225, 0.65)';
      ctx.fillStyle = 'rgba(255, 250, 225, 0.45)';
      ctx.lineWidth = lineWidth;
      drawFn();
      ctx.restore();
    };

    // 4. Thin double border in relief
    drawEmboss(() => {
      ctx.strokeRect(5, 5, w - 10, h - 10);
    }, 1.2);
    drawEmboss(() => {
      ctx.strokeRect(9, 9, w - 18, h - 18);
    }, 0.8);

    // 5. Top arch lotus motif in relief
    const lx = w / 2;
    const ly = 22;
    drawEmboss(() => {
      ctx.beginPath();
      // Center petal
      ctx.moveTo(lx, ly - 8);
      ctx.quadraticCurveTo(lx + 4, ly, lx, ly + 6);
      ctx.quadraticCurveTo(lx - 4, ly, lx, ly - 8);
      // Left petal
      ctx.moveTo(lx, ly + 5);
      ctx.quadraticCurveTo(lx - 7, ly - 2, lx - 8, ly - 6);
      ctx.quadraticCurveTo(lx - 4, ly - 1, lx, ly + 5);
      // Right petal
      ctx.moveTo(lx, ly + 5);
      ctx.quadraticCurveTo(lx + 7, ly - 2, lx + 8, ly - 6);
      ctx.quadraticCurveTo(lx + 4, ly - 1, lx, ly + 5);
      ctx.stroke();
    }, 1);

    // 6. Embossed mandala in center
    const cx = w / 2;
    const cy = h * 0.52;

    // Concentric relief rings
    [38, 26, 15, 6].forEach((r) => {
      drawEmboss(() => {
        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, Math.PI * 2);
        ctx.stroke();
      }, 0.9);
    });

    // Dotted ring at r = 20.5
    drawEmboss(() => {
      ctx.save();
      ctx.setLineDash([2, 3]);
      ctx.beginPath();
      ctx.arc(cx, cy, 20.5, 0, Math.PI * 2);
      ctx.stroke();
      ctx.restore();
    }, 0.9);

    // Radiating 12 petals rosette
    drawEmboss(() => {
      for (let a = 0; a < 12; a++) {
        const angle = (a * Math.PI) / 6;
        const px1 = cx + Math.cos(angle) * 15;
        const py1 = cy + Math.sin(angle) * 15;
        const px2 = cx + Math.cos(angle) * 26;
        const py2 = cy + Math.sin(angle) * 26;
        ctx.beginPath();
        ctx.moveTo(px1, py1);
        ctx.lineTo(px2, py2);
        ctx.stroke();
      }
    }, 0.8);

    // 7. Fine paisley / floral vines along left and right edges
    drawEmboss(() => {
      // Left edge vine
      ctx.beginPath();
      ctx.moveTo(14, h * 0.3);
      ctx.bezierCurveTo(10, h * 0.42, 18, h * 0.58, 14, h * 0.72);
      ctx.stroke();
      // Right edge vine
      ctx.beginPath();
      ctx.moveTo(w - 14, h * 0.3);
      ctx.bezierCurveTo(w - 10, h * 0.42, w - 18, h * 0.58, w - 14, h * 0.72);
      ctx.stroke();
      // Delicate leaf florets
      [0.38, 0.5, 0.62].forEach((ratio) => {
        ctx.beginPath();
        ctx.arc(14, h * ratio, 2.5, 0, Math.PI * 2);
        ctx.arc(w - 14, h * ratio, 2.5, 0, Math.PI * 2);
        ctx.stroke();
      });
    }, 0.8);

    // 8. Tiny engraved sparkle icon at center of mandala (shadow & highlight)
    drawEmboss(() => {
      ctx.beginPath();
      ctx.moveTo(cx, cy - 4.5);
      ctx.lineTo(cx, cy + 4.5);
      ctx.moveTo(cx - 4.5, cy);
      ctx.lineTo(cx + 4.5, cy);
      ctx.stroke();
    }, 1.2);

    ctx.restore();
  }

  function spawnGoldDust(x: number, y: number, container: HTMLElement) {
    for (let i = 0; i < 3; i++) {
      const p = document.createElement('span');
      p.className = 'gold-dust-particle';
      const angle = Math.random() * Math.PI * 2;
      const dist = Math.random() * 24 + 8;
      p.style.left = `${x}px`;
      p.style.top = `${y}px`;
      p.style.setProperty('--dx', `${Math.cos(angle) * dist}px`);
      p.style.setProperty('--dy', `${Math.sin(angle) * dist}px`);
      container.appendChild(p);
      setTimeout(() => p.remove(), 450);
    }
  }

  function initScratchCards() {
    const scratchCanvases = document.querySelectorAll<HTMLCanvasElement>('.scratch-canvas');
    const revealedCards = new Set<string>();

    if (isScratchUnlocked) {
      if (lockedContentWrapper) lockedContentWrapper.classList.remove('is-locked');
      if (lockedCountdownCard) lockedCountdownCard.classList.remove('is-locked');
      window.dispatchEvent(new Event('resize'));
      updateProgress(3);
      scratchCanvases.forEach((c) => {
        c.style.display = 'none';
        const card = c.closest('.scratch-card') as HTMLElement;
        if (card) {
          card.classList.remove('card-pulse-glow');
          const shimmer = card.querySelector('.scratch-foil-shimmer') as HTMLElement;
          if (shimmer) shimmer.style.display = 'none';
          const hint = card.querySelector('.card-center-sparkle') as HTMLElement;
          if (hint) hint.remove();
        }
      });
      document.querySelectorAll('.card-foil-placeholder').forEach(el => el.remove());
      if (scratchUnlockedContinue) {
        scratchUnlockedContinue.classList.remove('hidden');
        scratchUnlockedContinue.classList.add('flex');
      }
      return;
    }

    updateProgress(0);

    scratchCanvases.forEach((canvas, index) => {
      const card = canvas.closest('.scratch-card') as HTMLElement;
      const cardId = card?.dataset.card || `card-${index}`;
      const shimmerEl = card?.querySelector('.scratch-foil-shimmer') as HTMLElement | null;
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return;

      const rect = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      const w = rect.width || canvas.width || 150;
      const h = rect.height || canvas.height || 225;

      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.scale(dpr, dpr);

      // Render antique gold embossed foil before removing placeholders
      drawAntiqueGoldFoil(canvas, ctx, w, h);

      let isScratching = false;
      let isRevealed = false;
      let hasStartedScratching = false;
      let lastX: number | null = null;
      let lastY: number | null = null;
      let lastSampleTime = 0;

      function scratchAt(clientX: number, clientY: number) {
        if (isRevealed || !ctx) return;
        hasStartedScratching = true;

        // Hide hint sparkle immediately upon scratching
        const hint = card?.querySelector('.card-center-sparkle') as HTMLElement | null;
        if (hint) {
          hint.style.transition = 'opacity 0.2s ease';
          hint.style.opacity = '0';
          setTimeout(() => hint.remove(), 220);
        }

        const cRect = canvas.getBoundingClientRect();
        const x = clientX - cRect.left;
        const y = clientY - cRect.top;

        // Big brush: ~44px desktop, ~40px mobile with soft round edges
        const isMobile = window.innerWidth < 640;
        const brushRadius = isMobile ? 40 : 44;

        ctx.globalCompositeOperation = 'destination-out';
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.lineWidth = brushRadius * 2;

        ctx.beginPath();
        if (lastX !== null && lastY !== null) {
          ctx.moveTo(lastX, lastY);
          ctx.lineTo(x, y);
          ctx.stroke();
        } else {
          ctx.arc(x, y, brushRadius, 0, Math.PI * 2);
          ctx.fill();
        }

        lastX = x;
        lastY = y;

        if (card) spawnGoldDust(x, y, card);

        // Throttled pixel checking (~100ms)
        const now = performance.now();
        if (now - lastSampleTime > 100) {
          lastSampleTime = now;
          checkCompletion();
        }
      }

      function checkCompletion() {
        if (isRevealed || !ctx) return;
        try {
          const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
          const data = imgData.data;
          let cleared = 0;
          let total = 0;
          // Grid sampling (sample alpha channel every 40 bytes)
          for (let i = 3; i < data.length; i += 40) {
            total++;
            if (data[i] === 0) cleared++;
          }
          const ratio = cleared / total;
          // Reveal threshold: 25-30% cleared (0.26)
          if (ratio >= 0.26) {
            revealCard();
          }
        } catch (e) {}
      }

      async function revealCard() {
        if (isRevealed) return;
        isRevealed = true;
        canvas.style.pointerEvents = 'none';
        if (card) {
          card.classList.remove('card-pulse-glow');
          const hint = card.querySelector('.card-center-sparkle') as HTMLElement | null;
          if (hint) hint.remove();
        }

        // Smooth fade out (~0.5s) for canvas and shimmer overlay
        gsap.to([canvas, shimmerEl], {
          opacity: 0,
          duration: 0.5,
          ease: 'power2.out',
          onComplete: () => {
            canvas.style.display = 'none';
            if (shimmerEl) shimmerEl.style.display = 'none';
          }
        });

        // Small gold sparkle burst
        try {
          const confetti = (await import('canvas-confetti')).default;
          const cRect = canvas.getBoundingClientRect();
          confetti({
            particleCount: 26,
            spread: 45,
            origin: {
              x: (cRect.left + cRect.width / 2) / window.innerWidth,
              y: (cRect.top + cRect.height / 2) / window.innerHeight
            },
            colors: ['#D4AF37', '#B8860B', '#FFFDF8']
          });
        } catch (e) {}

        revealedCards.add(cardId);
        updateProgress(revealedCards.size);

        if (revealedCards.size >= 3) {
          onAllCardsRevealed();
        }
      }

      // Pointer event handlers with pointer capture
      canvas.addEventListener('pointerdown', (e) => {
        isScratching = true;
        lastX = null;
        lastY = null;
        try { canvas.setPointerCapture(e.pointerId); } catch (err) {}
        scratchAt(e.clientX, e.clientY);
      });

      canvas.addEventListener('pointermove', (e) => {
        if (!isScratching) return;
        scratchAt(e.clientX, e.clientY);
      });

      const stopScratching = (e: PointerEvent) => {
        if (isScratching) {
          isScratching = false;
          lastX = null;
          lastY = null;
          try { canvas.releasePointerCapture(e.pointerId); } catch (err) {}
          checkCompletion();
        }
      };

      canvas.addEventListener('pointerup', stopScratching);
      canvas.addEventListener('pointercancel', stopScratching);

      // Prevent touch scrolling while scratching on mobile
      canvas.addEventListener('touchstart', (e) => {
        e.preventDefault();
      }, { passive: false });
      canvas.addEventListener('touchmove', (e) => {
        e.preventDefault();
      }, { passive: false });

      // Keyboard accessibility (Space / Enter triggers progressive scratch)
      if (card) {
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            e.stopPropagation();
            if (isRevealed || !ctx) return;

            const hint = card?.querySelector('.card-center-sparkle') as HTMLElement | null;
            if (hint) hint.remove();

            // Clear circular spots progressively across canvas
            ctx.globalCompositeOperation = 'destination-out';
            const spots = [
              { x: w * 0.35, y: h * 0.35 },
              { x: w * 0.65, y: h * 0.35 },
              { x: w * 0.5, y: h * 0.65 },
              { x: w * 0.5, y: h * 0.5 },
            ];
            spots.forEach(pt => {
              ctx.beginPath();
              ctx.arc(pt.x, pt.y, 44, 0, Math.PI * 2);
              ctx.fill();
            });
            checkCompletion();
          }
        });
      }

      // Handle window resize before card is scratched
      window.addEventListener('resize', () => {
        if (!isRevealed && !hasStartedScratching) {
          const r = canvas.getBoundingClientRect();
          const d = window.devicePixelRatio || 1;
          const rw = r.width || canvas.width;
          const rh = r.height || canvas.height;
          canvas.width = rw * d;
          canvas.height = rh * d;
          ctx.scale(d, d);
          drawAntiqueGoldFoil(canvas, ctx, rw, rh);
        }
      });
    });

    // Remove foil placeholder fallbacks now that canvases are rendered
    document.querySelectorAll('.card-foil-placeholder').forEach((el) => el.remove());

    async function onAllCardsRevealed() {
      isScratchUnlocked = true;
      try {
        localStorage.setItem(STD_STORAGE_KEY, 'true');
      } catch (e) {}

      // Grand celebration confetti burst
      try {
        const confetti = (await import('canvas-confetti')).default;
        confetti({
          particleCount: 85,
          spread: 70,
          origin: { y: 0.55 },
          colors: ['#D4AF37', '#B8860B', '#FFFDF8', '#F5E8D3', '#E6A8A8']
        });
        setTimeout(() => {
          confetti({
            particleCount: 45,
            angle: 60,
            spread: 50,
            origin: { x: 0 },
            colors: ['#D4AF37', '#B8860B', '#FFFDF8']
          });
          confetti({
            particleCount: 45,
            angle: 120,
            spread: 50,
            origin: { x: 1 },
            colors: ['#D4AF37', '#B8860B', '#FFFDF8']
          });
        }, 250);
      } catch (e) {}

      // Unlock scroll gate & countdown plaque
      if (lockedContentWrapper) {
        lockedContentWrapper.classList.remove('is-locked');
      }
      if (lockedCountdownCard) {
        lockedCountdownCard.classList.remove('is-locked');
      }
      lenis.resize();
      ScrollTrigger.refresh();
      window.dispatchEvent(new Event('resize'));

      updateProgress(3);

      // Show Continue button
      if (scratchUnlockedContinue) {
        scratchUnlockedContinue.classList.remove('hidden');
        scratchUnlockedContinue.classList.add('flex');
        gsap.fromTo(scratchUnlockedContinue, { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' });
      }

      // Smooth auto-scroll after 1.2s to next section (Meet The Couple)
      const autoScrollTimer = setTimeout(() => {
        scrollToNextSection();
      }, 1200);

      scratchContinueBtn?.addEventListener('click', () => {
        clearTimeout(autoScrollTimer);
        scrollToNextSection();
      });

      function scrollToNextSection() {
        const nextSection = document.getElementById('couple');
        if (nextSection) {
          lenis.scrollTo(nextSection, { duration: 1.4 });
        }
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScratchCards);
  } else {
    initScratchCards();
  }

  // ── ICS DOWNLOAD ──────────────────────────────────────────────────
  function downloadICS() {
    const ics = [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'PRODID:-//MukeshWedsPuja//Wedding//EN',
      'BEGIN:VEVENT',
      'UID:mukesh-weds-puja-2026@wedding',
      'DTSTART:20261211T130000Z',
      'DTEND:20261211T203000Z',
      'SUMMARY:Mukesh Ojha weds Puja | #MukeshWedsPuja',
      'DESCRIPTION:The Royal Wedding of Mukesh Ojha & Puja. #MukeshWedsPuja',
      'LOCATION:Grand Rajwada Mandap\\, Dugda\\, Bokaro\\, Jharkhand - 828404',
      'STATUS:CONFIRMED',
      'END:VEVENT',
      'END:VCALENDAR',
    ].join('\r\n');
    const blob = new Blob([ics], { type: 'text/calendar' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'MukeshWedsPuja.ics'; a.click();
    URL.revokeObjectURL(url);
  }

  document.getElementById('add-to-calendar-btn')?.addEventListener('click', downloadICS);
  document.getElementById('add-to-cal-btn')?.addEventListener('click', downloadICS);
  document.getElementById('add-to-cal-2')?.addEventListener('click', downloadICS);

  // ── HASHTAG COPY ──────────────────────────────────────────────────
  document.getElementById('copy-hashtag')?.addEventListener('click', () => {
    navigator.clipboard.writeText('#MukeshWedsPuja').then(() => {
      const toast = document.getElementById('copy-toast');
      if (toast) { toast.classList.remove('hidden'); setTimeout(() => toast.classList.add('hidden'), 2000); }
    });
  });





  // ── AUDIO CONTROLS (HOWLER / WEB AUDIO SYNTH) ─────────────────────
  const musicWidget = document.getElementById('music-widget');
  const widgetSongStatus = document.getElementById('widget-song-status');
  const widgetBars = document.getElementById('widget-bars');

  function updateAudioUI(isPlaying: boolean) {
    if (musicWidget) {
      musicWidget.style.borderColor = isPlaying ? 'rgba(212,175,55,0.6)' : 'rgba(212,175,55,0.25)';
      musicWidget.style.opacity = isPlaying ? '1' : '0.75';
    }
    if (widgetSongStatus) {
      widgetSongStatus.textContent = isPlaying ? 'Playing · Click to Mute' : 'Muted · Click to Play';
    }
    if (widgetBars) {
      widgetBars.style.opacity = isPlaying ? '1' : '0.25';
    }
  }

  const handleToggleMusic = (e?: Event) => {
    if (e) {
      e.stopPropagation();
      e.preventDefault();
    }
    const isPlaying = royalAudio.getIsPlaying();
    if (isPlaying) {
      userManuallyMuted = true;
      royalAudio.pauseSong((playing) => updateAudioUI(playing));
    } else {
      userManuallyMuted = false;
      royalAudio.playSong((playing) => updateAudioUI(playing));
    }
  };

  musicWidget?.addEventListener('click', handleToggleMusic);
  if (musicWidget) musicWidget.style.cursor = 'pointer';

  // ── SACRED RITUALS PHOTO CAROUSEL INITIALIZATION ──────────────────
  const ritualsSwiperEl = document.getElementById('rituals-swiper');
  if (ritualsSwiperEl) {
    const counterEl = document.getElementById('rituals-counter');
    const progressLine = document.getElementById('rituals-progress-line');
    const liveRegion = document.getElementById('rituals-live-region');
    const totalRituals = 11;

    const ritualsSwiper = new Swiper(ritualsSwiperEl, {
      modules: [EffectCoverflow, Navigation, Pagination, Autoplay, Keyboard, A11y],
      effect: 'coverflow',
      grabCursor: true,
      centeredSlides: true,
      slidesPerView: 'auto',
      initialSlide: 0,
      loop: true,
      speed: 650,
      observer: true,
      observeParents: true,
      observeSlideChildren: true,
      keyboard: {
        enabled: true,
        onlyInViewport: true,
      },
      mousewheel: false, // Explicitly disabled to not fight page scroll
      coverflowEffect: {
        rotate: 0,
        stretch: 0,
        depth: 120,
        modifier: 1.25,
        slideShadows: false,
        scale: 0.9,
      },
      autoplay: {
        delay: 3500,
        disableOnInteraction: false,
        pauseOnMouseEnter: false,
      },
      navigation: {
        prevEl: '#rituals-prev',
        nextEl: '#rituals-next',
      },
      pagination: {
        el: '#rituals-dots',
        clickable: true,
        bulletClass: 'rituals-dot',
        bulletActiveClass: 'rituals-dot-active',
        renderBullet: function (index, className) {
          return `<button class="${className}" aria-label="Go to ritual slide ${index + 1}"></button>`;
        },
      },
      on: {
        init: function (swiper) {
          updateRitualsCarouselUI(swiper);
          if (swiper.autoplay) {
            swiper.autoplay.start();
          }
        },
        slideChange: function (swiper) {
          updateRitualsCarouselUI(swiper);
        },
        autoplayTimeLeft: function (swiper, time, progress) {
          if (progressLine) {
            const pct = Math.max(0, Math.min(100, (1 - progress) * 100));
            progressLine.style.width = `${pct}%`;
          }
        },
      },
    });

    function updateRitualsCarouselUI(swiper: any) {
      const realIdx = typeof swiper.realIndex === 'number' ? swiper.realIndex : 0;
      const currentNumber = realIdx + 1;
      const formatted = `${currentNumber < 10 ? '0' : ''}${currentNumber} / ${totalRituals < 10 ? '0' : ''}${totalRituals}`;
      if (counterEl) {
        counterEl.textContent = formatted;
      }
      const activeSlide = swiper.slides ? swiper.slides[swiper.activeIndex] : null;
      const title = activeSlide ? activeSlide.getAttribute('data-ritual-title') : '';
      if (liveRegion) {
        liveRegion.textContent = `Slide ${currentNumber} of ${totalRituals}: ${title || 'Ritual'}`;
      }
    }

    // Ensure autoplay starts immediately and resumes on tab visibility
    if (ritualsSwiper.autoplay) {
      ritualsSwiper.autoplay.start();
    }

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && ritualsSwiper.autoplay) {
        ritualsSwiper.autoplay.start();
      }
    });
  }

</script>
