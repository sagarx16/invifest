                  <!-- Photo with Ken Burns capability and precise object position -->
                  <Picture
                    src={slide.img}
                    formats={['avif', 'webp']}
                    fallbackFormat="jpg"
                    alt={slide.alt}
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                    widths={[360, 540, 720]}
                    sizes="(max-width: 640px) 340px, 420px"
                    quality={80}
