      <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-[#D1C5B1] text-[9px] sm:text-[10px] font-['Montserrat'] text-center sm:text-left" style="border-top:1px solid rgba(224,184,79,0.1);">
        <span>© 2026 The Royal Wedding of Mukesh &amp; Puja. All rights reserved.</span>
