---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mukesh Weds Puja | Wedding Invitation" description="With divine blessings and ancestral grace, you are cordially invited to the Royal Wedding of Mukesh Ojha & Puja on 11th December 2026 at Dugda, Bokaro.">

  <!-- ========== GRAND OPENING ENVELOPE CINEMATIC (FULL WINDOW) ========== -->
  <div id="opening-cinematic" class="fixed inset-0 z-[10000] w-screen h-screen overflow-hidden select-none transition-all duration-1000 flex flex-col justify-between" style="background:#150D0A;">
    <!-- Ambient Blur Background Video Layer (fills widescreen behind) -->
    <video
      id="opening-video-ambient"
      playsinline
      autoplay
      muted
      loop
      class="absolute inset-0 w-full h-full object-cover filter blur-3xl opacity-50 scale-110 pointer-events-none"
    >
      <source src="/videos/opening.mp4" type="video/mp4" />
    </video>

    <!-- Main Full-Window Video Container -->
    <div class="absolute inset-0 w-full h-full flex items-center justify-center cursor-pointer" id="video-card">
      <video
        id="opening-video"
        playsinline
        autoplay
        poster="/images/video_thumb.jpg"
        class="w-full h-full object-cover sm:object-contain md:object-cover pointer-events-auto"
      >
        <source src="/videos/opening.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- Soft Vignette & Subtle Gradient for Controls Readability -->
    <div class="absolute inset-0 pointer-events-none bg-gradient-to-b from-black/50 via-transparent to-black/60 z-10"></div>

    <!-- Top Floating Header Bar (Overlay) -->
    <div class="relative z-20 w-full px-4 sm:px-8 pt-4 sm:pt-6 flex items-center justify-between pointer-events-none">
      <div class="flex items-center gap-2.5 px-3.5 py-1.5 rounded-full pointer-events-auto shadow-lg" style="background:rgba(255,255,255,0.9);backdrop-filter:blur(16px);border:1px solid rgba(212,175,55,0.45);">
        <span class="text-[#B8860B] text-xs">✦</span>
        <span class="font-['Playfair_Display'] text-[#8C6219] text-xs sm:text-sm tracking-widest uppercase font-semibold">॥ श्री गणेशाय नमः ॥</span>
      </div>

      <div class="flex items-center gap-2.5 pointer-events-auto">
        <button id="cinematic-unmute-btn" class="px-3.5 py-1.5 rounded-full text-[10px] tracking-wider uppercase font-['Montserrat'] font-semibold flex items-center gap-1.5 transition-all hover:scale-105 active:scale-95 shadow-lg" style="background:rgba(255,255,255,0.92);backdrop-filter:blur(16px);border:1px solid rgba(197,148,55,0.45);color:#8C6219;">
          <span id="cinematic-sound-icon" class="flex items-center">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            </svg>
          </span>
          <span id="cinematic-sound-text">Sound ON</span>
        </button>
      </div>
    </div>

    <!-- Center Stage: Empty spacer -->
    <div class="relative z-10 pointer-events-none my-auto"></div>

    <!-- Bottom Floating Bar & Enter Button -->
    <div class="relative z-20 w-full px-4 pb-6 sm:pb-8 flex flex-col items-center pointer-events-none">
      <button id="cinematic-enter-btn" class="pointer-events-auto px-8 sm:px-12 py-3.5 sm:py-4 rounded-full font-['Montserrat'] text-[11px] sm:text-xs tracking-[0.2em] uppercase font-bold transition-all duration-300 ripple-btn shine-btn hover:scale-105 active:scale-95 shadow-[0_8px_30px_rgba(0,0,0,0.4)]" style="background:linear-gradient(135deg,#D4AF37,#B8860B,#996515);color:#FFFFFF;border:1px solid rgba(255,255,255,0.5);">
        Open Royal Invitation · प्रवेश करें ✦
      </button>
      <div class="flex items-center gap-2 mt-3 px-3.5 py-1 rounded-full pointer-events-auto shadow-md" style="background:rgba(255,255,255,0.85);backdrop-filter:blur(12px);border:1px solid rgba(212,175,55,0.35);">
        <p class="font-['Montserrat'] text-[9px] sm:text-[10px] tracking-widest text-[#261E19] font-medium">
          Mukesh Ojha &amp; Puja • 11th Dec 2026 • Bokaro
        </p>
      </div>
    </div>

    <!-- Full-Width Bottom Progress Bar -->
    <div class="absolute bottom-0 left-0 right-0 h-1.5 bg-black/30 z-30">
      <div id="video-progress-fill" class="h-full bg-gradient-to-r from-[#F5D77F] via-[#D4AF37] to-[#B8860B] transition-all duration-100" style="width:0%;"></div>
    </div>
  </div>


  <!-- ========== NAVBAR ========== -->
  <header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500" style="background:rgba(250,246,240,0.0);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-3">
      <a href="#hero" class="flex items-center gap-2.5 sm:gap-3 group">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-[#D4AF37]/50 p-0.5 flex items-center justify-center flex-shrink-0 bg-white shadow-sm overflow-hidden">
          <img src="/images/seal.png" alt="M&P Royal Seal" class="w-full h-full object-cover" />
        </div>
        <div>
          <p class="font-['Playfair_Display'] text-[#261E19] text-sm sm:text-base font-semibold leading-tight">Mukesh &amp; Puja</p>
          <p class="text-[9px] sm:text-[10px] tracking-[0.18em] sm:tracking-[0.2em] uppercase text-[#6E5F55]">11 Dec 2026 · Bokaro</p>
        </div>
      </a>
      <nav class="hidden xl:flex items-center gap-1 px-3 py-2 rounded-full text-xs" style="background:rgba(255,255,255,0.88);backdrop-filter:blur(12px);border:1px solid rgba(212,175,55,0.3);box-shadow:0 4px 16px rgba(0,0,0,0.05);">
        {['Blessings','Couple','Story','Events','Venue','Gallery','RSVP'].map(s => (
          <a href={`#${s.toLowerCase()}`} class="px-3 py-1.5 rounded-full tracking-[0.15em] uppercase font-['Montserrat'] font-semibold text-[10px] text-[#5C4D42] hover:text-[#8C6219] hover:bg-[#FAF6EE] transition-all duration-300">{s}</a>
        ))}
      </nav>
      <div class="flex items-center gap-2 sm:gap-3">
        <button id="audio-toggle" aria-label="Toggle music" class="hidden sm:flex items-center gap-2 px-3 py-2 rounded-full text-[10px] tracking-[0.15em] uppercase font-semibold transition-all duration-300 magnetic-btn ripple-btn" style="background:rgba(255,255,255,0.9);border:1px solid rgba(212,175,55,0.35);color:#8C6219;box-shadow:0 2px 8px rgba(0,0,0,0.05);">
          <span id="audio-icon" class="flex items-center">
            <svg class="w-3.5 h-3.5 text-[#8C6219]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18V5l12-2v13"></path>
              <circle cx="6" cy="18" r="3"></circle>
              <circle cx="18" cy="16" r="3"></circle>
            </svg>
          </span>
          <span class="hidden md:inline">Shehnai</span>
        </button>
        <a href="#rsvp" class="px-3.5 sm:px-5 py-1.5 sm:py-2 rounded-full text-[9px] sm:text-[10px] tracking-[0.15em] sm:tracking-[0.2em] uppercase font-['Montserrat'] font-bold transition-all duration-300 ripple-btn shine-btn relative overflow-hidden" style="background:linear-gradient(135deg,#D4AF37 0%,#B8860B 50%,#996515 100%);color:#FFFFFF;box-shadow:0 2px 12px rgba(184,134,11,0.3);">RSVP</a>
        <button id="mobile-menu-btn" aria-label="Toggle mobile menu" class="xl:hidden w-9 h-9 rounded-full flex flex-col items-center justify-center gap-1 border border-[#D4AF37]/40 bg-white/90 text-[#8C6219] ripple-btn shadow-sm">
          <span class="w-4 h-0.5 bg-[#8C6219] transition-transform duration-300" id="m-bar-1"></span>
          <span class="w-4 h-0.5 bg-[#8C6219] transition-opacity duration-300" id="m-bar-2"></span>
          <span class="w-4 h-0.5 bg-[#8C6219] transition-transform duration-300" id="m-bar-3"></span>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-drawer" class="fixed inset-0 z-40 bg-[#FAF6EE]/98 backdrop-blur-2xl hidden flex-col justify-between p-6 pt-24 transition-all duration-300">
    <div class="flex flex-col items-center text-center space-y-3 my-auto">
      <div class="w-14 h-14 rounded-full border border-[#D4AF37]/50 p-1 flex items-center justify-center mb-1 shadow-md bg-white overflow-hidden">
        <img src="/images/seal.png" alt="M&P Seal" class="w-full h-full object-cover" />
      </div>
      <p class="font-['Playfair_Display'] text-[#261E19] text-2xl font-semibold">Mukesh Ojha &amp; Puja</p>
      <p class="text-[10px] tracking-[0.2em] uppercase text-[#6E5F55]">11 December 2026 · Dugda, Bokaro</p>
      <div class="h-px w-24 my-2" style="background:linear-gradient(90deg,transparent,#D4AF37,transparent);"></div>
      <nav class="flex flex-col items-center space-y-2.5 pt-2">
        {[
          {name:'Divine Blessings', href:'#blessings'},
          {name:'The Royal Duo', href:'#couple'},
          {name:'Sacred Story', href:'#story'},
          {name:'Festivities & Itinerary', href:'#events'},
          {name:'Royal Venue', href:'#venue'},
          {name:'Cinematic Gallery', href:'#gallery'},
          {name:'Confirm RSVP', href:'#rsvp'},
        ].map(item => (
          <a href={item.href} class="mobile-nav-link text-sm font-['Montserrat'] uppercase tracking-[0.2em] font-medium text-[#5C4D42] hover:text-[#8C6219] py-1 transition-colors">
            ✦ {item.name}
          </a>
        ))}
      </nav>
    </div>
    <div class="flex flex-col items-center gap-3 pb-6">
      <a href="#rsvp" class="mobile-nav-link w-full max-w-xs py-3.5 text-center rounded-full text-xs tracking-[0.2em] uppercase font-['Montserrat'] font-bold ripple-btn shine-btn" style="background:linear-gradient(135deg,#D4AF37,#B8860B,#996515);color:#FFFFFF;box-shadow:0 4px 20px rgba(184,134,11,0.3);">
        Confirm RSVP ✦
      </a>
      <p class="text-[10px] text-[#6E5F55] tracking-widest uppercase">#MukeshWedsPuja</p>
    </div>
  </div>

  <!-- ========== HERO SECTION ========== -->
  <!-- ========== HERO SECTION ========== -->
  <section id="hero" class="relative min-h-screen flex flex-col items-center justify-center text-center px-4 sm:px-6 overflow-hidden pt-24 pb-16">
    <!-- Hero Royal Background Image (Mukesh & Puja) - Clean & Vibrant -->
    <div class="absolute inset-0 z-[1] overflow-hidden pointer-events-none">
      <img
        src="/hero.jpg"
        alt="Mukesh & Puja Royal Portrait"
        class="w-full h-full object-cover object-[center_20%] sm:object-[center_28%] scale-100 transition-transform duration-1000"
      />
      <!-- Clean, Minimal Vignette: Soft top fade for navbar and gentle bottom fade to next section -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#FAF6F0] via-transparent to-[#FAF6F0]/60 pointer-events-none"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#FAF6F0]/25 via-transparent to-[#FAF6F0]/25 pointer-events-none"></div>
      <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 50% 50%, rgba(250,246,240,0.0) 0%, rgba(250,246,240,0.35) 100%);"></div>
    </div>

    <!-- Content: Elegant Royal Typography Floating Over The Portrait -->
    <div class="relative z-[8] max-w-4xl mx-auto flex flex-col items-center">
      <!-- Auspicious Invocation Pill -->
      <div id="hero-tag" class="inline-flex items-center gap-2.5 px-4 py-1.5 sm:px-6 sm:py-2 rounded-full mb-3 sm:mb-4 opacity-0" style="background:rgba(255,255,255,0.88);backdrop-filter:blur(16px);border:1px solid rgba(212,175,55,0.45);box-shadow:0 8px 30px rgba(180,150,120,0.18);">
        <span class="text-[#8C6219] text-xs">✦</span>
        <span class="font-['Playfair_Display'] text-[#8C6219] text-xs sm:text-sm tracking-[0.25em] uppercase font-semibold">॥ श्री गणेशाय नमः ॥</span>
        <span class="text-[#8C6219] text-xs">✦</span>
      </div>

      <p id="hero-subtitle" class="font-['Montserrat'] text-[10px] sm:text-xs tracking-[0.35em] uppercase text-[#8C6219] mb-3 sm:mb-5 opacity-0 drop-shadow-[0_1px_4px_rgba(255,255,255,0.9)] font-semibold">
        The Auspicious Wedding Of
      </p>

      <!-- Royal Names -->
      <div class="mb-3 sm:mb-5 text-center">
        <h1 id="hero-groom" class="font-['Playfair_Display'] font-bold leading-none opacity-0 flex justify-center flex-wrap" style="font-size:clamp(36px,8vw,90px);letter-spacing:0.02em;color:#261E19;text-shadow:0 2px 20px rgba(255,255,255,0.95), 0 0 10px rgba(212,175,55,0.35);">
          {"Mukesh Ojha".split("").map((ch) => (
            <span class="hero-char-groom inline-block">{ch === " " ? "\u00A0" : ch}</span>
          ))}
        </h1>
        <div id="hero-amp" class="flex items-center justify-center gap-3 sm:gap-6 my-1.5 sm:my-2.5 opacity-0">
          <div class="h-px w-14 sm:w-32" style="background:linear-gradient(90deg,transparent,#D4AF37);"></div>
          <span class="font-['Playfair_Display'] italic text-[#A62C4E] text-2xl sm:text-4xl drop-shadow-[0_2px_8px_rgba(255,255,255,0.9)]">&amp;</span>
          <div class="h-px w-14 sm:w-32" style="background:linear-gradient(270deg,transparent,#D4AF37);"></div>
        </div>
        <h1 id="hero-bride" class="font-['Playfair_Display'] font-bold leading-none opacity-0 flex justify-center flex-wrap" style="font-size:clamp(36px,8vw,90px);letter-spacing:0.02em;color:#7A1C30;text-shadow:0 2px 20px rgba(255,255,255,0.95), 0 0 10px rgba(219,103,137,0.35);">
          {"Puja".split("").map((ch) => (
            <span class="hero-char-bride inline-block">{ch === " " ? "\u00A0" : ch}</span>
          ))}
        </h1>
      </div>

      <p id="hero-invite" class="font-['Montserrat'] font-light text-[#3C3028] max-w-lg leading-relaxed mb-5 sm:mb-7 opacity-0 px-3 drop-shadow-[0_1px_6px_rgba(255,255,255,0.9)] font-medium" style="font-size:clamp(12px,1.4vw,15px);">
        Cordially invite you to celebrate our sacred union amidst palatial grace, ancestral rites, and celestial splendour.
      </p>

      <!-- Date & Venue Pill with Frosted Glass -->
      <div id="hero-date" class="inline-flex flex-col sm:flex-row items-center gap-2 sm:gap-3 px-5 py-2.5 sm:px-7 sm:py-3 rounded-full mb-6 sm:mb-8 opacity-0" style="background:rgba(255,255,255,0.9);backdrop-filter:blur(20px);border:1px solid rgba(212,175,55,0.4);box-shadow:0 8px 30px rgba(180,150,120,0.18);">
        <div class="flex items-center gap-2 text-[#8C6219]">
          <svg class="w-4 h-4 text-[#8C6219] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span class="font-['Playfair_Display'] font-semibold text-sm sm:text-base tracking-wide">Friday, 11th December 2026</span>
        </div>
        <span class="hidden sm:inline w-1.5 h-1.5 rounded-full bg-[#D4AF37]"></span>
        <div class="flex items-center gap-1.5 text-[#5C4D42] text-xs sm:text-sm uppercase tracking-wider font-['Montserrat']">
          <svg class="w-3.5 h-3.5 text-[#8C6219] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>Dugda, Bokaro</span>
        </div>
      </div>

      <!-- Modern Frosted Glass Countdown Ribbon -->
      <div id="countdown" class="grid grid-cols-4 gap-2.5 sm:gap-4 mb-8 sm:mb-10 opacity-0 max-w-xs sm:max-w-md w-full justify-items-center">
        {['days','hours','minutes','seconds'].map(u => (
          <div class="flex flex-col items-center gap-1.5">
            <div class="flip-clock-card" id={`cd-${u}`} style="background:rgba(255,255,255,0.92);backdrop-filter:blur(16px);border:1px solid rgba(212,175,55,0.45);box-shadow:0 8px 24px rgba(180,150,120,0.18);width:clamp(56px,18vw,86px);height:clamp(68px,20vw,98px);font-size:clamp(1.4rem,4vw,2.4rem);color:#8C6219;">
              <span id={`cd-${u}-val`}>0</span>
            </div>
            <span class="font-['Montserrat'] text-[8px] sm:text-[9px] tracking-[0.2em] uppercase text-[#6E5F55] font-semibold">{u}</span>
          </div>
        ))}
      </div>

      <!-- Clean Action Buttons -->
      <div id="hero-ctas" class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-3 sm:gap-4 w-full max-w-xs sm:max-w-2xl opacity-0">
        <a href="#events" class="w-full sm:w-auto text-center px-7 py-3.5 rounded-full font-['Montserrat'] text-[10px] sm:text-[11px] tracking-[0.2em] uppercase font-bold transition-all duration-300 ripple-btn shine-btn relative overflow-hidden magnetic-btn shadow-[0_4px_20px_rgba(184,134,11,0.3)]" style="background:linear-gradient(135deg,#D4AF37,#B8860B,#996515);color:#FFFFFF;">
          Explore Celebrations
        </a>
        <button id="replay-envelope-btn" class="w-full sm:w-auto text-center justify-center px-6 py-3.5 rounded-full font-['Montserrat'] text-[10px] sm:text-[11px] tracking-[0.2em] uppercase font-semibold transition-all duration-300 ripple-btn magnetic-btn flex items-center gap-2 hover:bg-[#A62C4E]/10" style="background:rgba(255,245,248,0.92);backdrop-filter:blur(12px);border:1px solid rgba(219,103,137,0.45);color:#A62C4E;box-shadow:0 4px 16px rgba(219,103,137,0.15);">
          <svg class="w-3.5 h-3.5 text-[#A62C4E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <span>Replay Envelope</span>
        </button>
        <button id="add-to-cal-btn" class="w-full sm:w-auto text-center justify-center px-6 py-3.5 rounded-full font-['Montserrat'] text-[10px] sm:text-[11px] tracking-[0.2em] uppercase font-semibold transition-all duration-300 ripple-btn magnetic-btn flex items-center gap-2 hover:bg-black/5" style="background:rgba(255,255,255,0.92);backdrop-filter:blur(12px);border:1px solid rgba(212,175,55,0.45);color:#8C6219;box-shadow:0 4px 16px rgba(180,150,120,0.15);">
          <svg class="w-3.5 h-3.5 text-[#8C6219]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Save The Date</span>
        </button>
        <a id="whatsapp-share" href="https://api.whatsapp.com/send?text=You%20are%20cordially%20invited%20to%20the%20Royal%20Wedding%20of%20Mukesh%20Ojha%20%26%20Puja%20on%2011th%20December%202026%20at%20Dugda%2C%20Bokaro%21%20%23MukeshWedsPuja" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto text-center justify-center px-6 py-3.5 rounded-full font-['Montserrat'] text-[10px] sm:text-[11px] tracking-[0.2em] uppercase font-semibold transition-all duration-300 ripple-btn magnetic-btn flex items-center gap-2 hover:bg-[#25d366]/10" style="background:rgba(240,253,244,0.95);backdrop-filter:blur(12px);border:1px solid rgba(34,197,94,0.45);color:#15803d;box-shadow:0 4px 16px rgba(34,197,94,0.15);">
          <svg class="w-3.5 h-3.5 text-[#15803d] fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>WhatsApp Invite</span>
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div id="scroll-indicator" class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-0 z-[8]">
      <span class="font-['Montserrat'] text-[9px] tracking-[0.25em] uppercase text-[#6E5F55] font-semibold">Scroll</span>
      <div class="w-0.5 h-12 relative overflow-hidden" style="background:rgba(212,175,55,0.25);">
        <div class="w-full h-1/2 absolute top-0" style="background:#D4AF37;animation:scroll-pulse 1.5s ease-in-out infinite;"></div>
      </div>
    </div>
  </section>

  <!-- ========== BLESSINGS / SHLOKA ========== -->
  <section id="blessings" class="py-16 sm:py-24 px-4 sm:px-6 relative">
    <div class="max-w-4xl mx-auto text-center glass-card rounded-2xl p-6 sm:p-12 md:p-16 relative overflow-hidden reveal-section">
