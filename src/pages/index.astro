          <div class="p-6 sm:p-8 rounded-2xl glass-card">
            <div class="flex items-center gap-3 mb-5 sm:mb-6">
              <div class="flex items-center" set:html={f.svg}></div>
              <div>
                <p class="font-['Montserrat'] text-[9px] tracking-[0.2em] uppercase font-bold" style={`color:${f.color}`}>{f.side}</p>
                <h3 class="font-['Playfair_Display'] text-[#261E19] text-lg sm:text-xl font-semibold">{f.family}</h3>
              </div>
            </div>
            <p class="font-['Montserrat'] font-light text-[#5C4D42] text-xs sm:text-sm mb-4 sm:mb-5">With eternal reverence to our esteemed ancestors and elders, welcoming you with folded hands:</p>
            <ul class="space-y-2.5 sm:space-y-3">
              {f.items.map(item => (
                <li class="flex items-start gap-2.5 sm:gap-3 font-['Montserrat'] text-xs sm:text-sm text-[#5C4D42]">
                  <span class="w-1.5 h-1.5 rounded-full flex-shrink-0 mt-1.5" style={`background:${f.color}`}></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="text-center mt-8 sm:mt-12 p-5 sm:p-6 rounded-2xl glass-card max-w-xl mx-auto">
        <p class="font-['Playfair_Display'] text-[#8C6219] italic text-base sm:text-lg font-semibold">Darshanabhilashi</p>
        <p class="font-['Montserrat'] text-[#5C4D42] text-xs mt-1.5">All near, dear relatives &amp; friends of Ojha &amp; Family Parivar.</p>
      </div>
    </div>
  </section>

  <!-- ========== HASHTAG + SHARE ========== -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 text-center relative reveal-section">
    <div class="max-w-3xl mx-auto">
      <p class="section-tag mb-4 sm:mb-6">Celebrate Our Union Online</p>
      <div id="copy-hashtag" class="inline-flex items-center gap-2.5 sm:gap-3 px-5 sm:px-8 py-3 sm:py-4 rounded-full cursor-pointer transition-all duration-300 hover:shadow-[0_4px_25px_rgba(180,150,120,0.25)] mb-6 sm:mb-8" style="background:rgba(255,255,255,0.92);border:1px solid rgba(212,175,55,0.4);box-shadow:0 4px 20px rgba(180,150,120,0.15);">
        <span class="font-['Playfair_Display'] font-bold text-[#8C6219] text-xl sm:text-2xl tracking-wider">#MukeshWedsPuja</span>
        <svg class="w-4 h-4 text-[#8C6219] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
        <span id="copy-toast" class="text-[#A62C4E] text-xs font-semibold hidden">Copied!</span>
      </div>
      <p class="font-['Montserrat'] font-light text-[#5C4D42] max-w-xl mx-auto mb-8 sm:mb-10 text-xs sm:text-sm leading-relaxed px-2">Share your lovely photographs, heartfelt stories, and ceremonial greetings across social media using our official royal wedding hashtag.</p>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4 max-w-xs sm:max-w-none mx-auto">
        <a id="wa-share-bottom" href="https://api.whatsapp.com/send?text=You%20are%20cordially%20invited%20to%20the%20Royal%20Wedding%20of%20Mukesh%20Ojha%20%26%20Puja%20on%2011th%20December%202026%20at%20Dugda%2C%20Bokaro%21%20%23MukeshWedsPuja" target="_blank" rel="noopener noreferrer" class="px-6 sm:px-8 py-3 sm:py-3.5 rounded-full font-['Montserrat'] text-[10px] sm:text-[11px] tracking-[0.15em] uppercase font-semibold transition-all hover:opacity-90 ripple-btn magnetic-btn flex items-center justify-center gap-2" style="background:#25D366;border:1px solid #22c55e;color:#FFFFFF;box-shadow:0 4px 15px rgba(37,211,102,0.25);">
          <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"/></svg>
          <span>Share On WhatsApp</span>
        </a>
        <button id="add-to-cal-2" class="px-6 sm:px-8 py-3 sm:py-3.5 rounded-full font-['Montserrat'] text-[10px] sm:text-[11px] tracking-[0.15em] uppercase font-semibold transition-all hover:opacity-90 ripple-btn magnetic-btn flex items-center justify-center gap-2" style="background:rgba(255,255,255,0.92);border:1px solid rgba(212,175,55,0.4);color:#8C6219;box-shadow:0 4px 15px rgba(180,150,120,0.12);">
          <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <span>Add to Calendar</span>
        </button>
      </div>
      <div class="mt-12 sm:mt-16 pt-6 sm:pt-8" style="border-top:1px solid rgba(212,175,55,0.2);">
        <p class="font-['Playfair_Display'] text-[#261E19] italic text-base sm:text-lg font-normal px-2">"May your steps be blessed, and may your presence illuminate our celebration forever."</p>
      </div>
    </div>
  </section>

  <!-- ========== FOOTER ========== -->
  <footer class="relative pt-12 sm:pt-16 pb-8 sm:pb-10" style="background:linear-gradient(to bottom, #FAF6EE, #F2E8D8);border-top:1px solid rgba(212,175,55,0.3);box-shadow:0 -6px 30px rgba(180,150,120,0.12);">
    <!-- Floating lanterns -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      {Array.from({length: 8}).map((_, i) => (
        <div class="absolute opacity-30 text-[#D4AF37]" style={`left:${10+i*12}%;bottom:0;animation:lantern-rise ${4+i}s ease-in-out infinite;animation-delay:${i*0.5}s;`}>
          <svg class="w-5 h-5 text-[#D4AF37] drop-shadow-[0_0_8px_rgba(212,175,55,0.6)]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2c-.5 2-2 4-2 6a4 4 0 0 0 8 0c0-2-1.5-4-2-6h-4zm-9 14c0 3.3 4 6 9 6s9-2.7 9-6H3z"/>
          </svg>
        </div>
      ))}
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
      <div class="w-14 h-14 mx-auto mb-4 rounded-full border border-[#D4AF37]/50 p-1 flex items-center justify-center bg-white shadow-md overflow-hidden">
        <img src="/images/seal.png" alt="M&P Wedding Seal" class="w-full h-full object-cover" />
      </div>
      <div class="flex items-center justify-center gap-4 sm:gap-6 mb-6 sm:mb-8">
        <div class="h-px w-16 sm:w-48" style="background:linear-gradient(90deg,transparent,#D4AF37);"></div>
        <span class="font-['Playfair_Display'] text-[#8C6219] font-semibold text-xl sm:text-2xl">M &amp; P</span>
        <div class="h-px w-16 sm:w-48" style="background:linear-gradient(270deg,transparent,#D4AF37);"></div>
      </div>
      <div class="text-center space-y-2 mb-8 sm:mb-10 px-2">
        <p class="font-['Playfair_Display'] text-[#261E19] text-lg sm:text-xl font-semibold">Mukesh Ojha &amp; Puja</p>
        <p class="font-['Montserrat'] text-[#8C6219] text-[10px] sm:text-[11px] tracking-[0.2em] uppercase font-semibold">11th December 2026 · Dugda, Bokaro, Jharkhand</p>
        <p class="font-['Montserrat'] font-light text-[#5C4D42] italic text-xs sm:text-sm max-w-md mx-auto">"With the blessings of our ancestors and divine grace, we invite you to honor our auspicious royal union."</p>
        <p class="font-['Montserrat'] text-[#A62C4E] text-[11px] sm:text-xs tracking-widest uppercase font-semibold pt-2">#MukeshWedsPuja</p>
      </div>
      <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-[#7A6B60] text-[9px] sm:text-[10px] font-['Montserrat'] text-center sm:text-left" style="border-top:1px solid rgba(212,175,55,0.2);">
        <span>© 2026 The Royal Wedding of Mukesh &amp; Puja. All rights reserved.</span>
        <span>Ceremony &amp; Celebrations at Dugda, Bokaro</span>
      </div>
    </div>
  </footer>

  <!-- Audio element (muted by default) -->
  <audio id="bg-audio" loop preload="none">
    <!-- Add shehnai audio src here -->
  </audio>

  <!-- Scroll-to-top -->
  <a href="#hero" id="scroll-top-btn" class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-40 w-10 h-10 sm:w-11 sm:h-11 rounded-full flex items-center justify-center transition-all duration-300 opacity-0 magnetic-btn ripple-btn text-sm sm:text-base" style="background:rgba(255,255,255,0.92);border:1px solid rgba(212,175,55,0.45);color:#8C6219;backdrop-filter:blur(12px);box-shadow:0 6px 20px rgba(180,150,120,0.2);" aria-label="Back to top">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
  </a>

  <!-- Music widget -->
  <div class="fixed bottom-4 left-4 sm:bottom-6 sm:left-6 z-40">
    <div id="music-widget" class="flex items-center gap-2 sm:gap-3 px-3 py-2 sm:px-4 sm:py-2.5 rounded-full" style="background:rgba(255,255,255,0.92);backdrop-filter:blur(20px);border:1px solid rgba(212,175,55,0.4);box-shadow:0 6px 20px rgba(180,150,120,0.2);">
      <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[#8C6219] flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" style="animation:pulse 2s ease-in-out infinite;">
        <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
      </svg>
      <div class="flex flex-col">
        <span class="font-['Montserrat'] text-[9px] sm:text-[10px] text-[#8C6219] tracking-widest uppercase leading-none font-semibold">Aaj Sajeya</span>
        <span class="font-['Montserrat'] text-[7px] sm:text-[8px] text-[#7A6B60] uppercase tracking-widest leading-none mt-0.5 hidden xs:inline font-medium">Wedding Song</span>
      </div>
      <div class="flex items-center gap-0.5 ml-0.5 sm:ml-1">
        {[3,4,2].map(h => (
          <span class="w-0.5 bg-[#8C6219] rounded-full" style={`height:${h*4}px;animation:music-bar 0.8s ease-in-out infinite alternate;`}></span>
        ))}
      </div>
    </div>
  </div>

</Layout>

<style>
@keyframes scroll-pulse {
  0% { transform: translateY(-100%); opacity: 1; }
  100% { transform: translateY(200%); opacity: 0; }
}
@keyframes lantern-rise {
  0% { transform: translateY(0) scale(1); opacity: 0.3; }
  50% { transform: translateY(-40vh) scale(1.1) translateX(10px); opacity: 0.5; }
  100% { transform: translateY(-80vh) scale(0.8) translateX(-5px); opacity: 0; }
}
@keyframes music-bar {
  from { transform: scaleY(0.4); }
  to { transform: scaleY(1); }
}
</style>

<script>
  // ── GSAP + ScrollTrigger animations ──────────────────────────────
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';
  import { royalAudio } from '../lib/audio';

  gsap.registerPlugin(ScrollTrigger);

  // Lenis smooth scroll
  const lenis = new Lenis({ lerp: 0.08, smoothWheel: true });
  lenis.on('scroll', ScrollTrigger.update);
  gsap.ticker.add((time) => lenis.raf(time * 1000));
  gsap.ticker.lagSmoothing(0);

  // ── GRAND OPENING ENVELOPE CINEMATIC & HERO REVEAL ────────────────
  const openingCinematic = document.getElementById('opening-cinematic');
  const openingVideo = document.getElementById('opening-video') as HTMLVideoElement | null;
  const unmuteBtn = document.getElementById('cinematic-unmute-btn');
  const soundIcon = document.getElementById('cinematic-sound-icon');
  const soundText = document.getElementById('cinematic-sound-text');
  const unmuteBadge = document.getElementById('unmute-badge');
  const skipBtn = document.getElementById('cinematic-skip-btn');
  const enterBtn = document.getElementById('cinematic-enter-btn');
  const videoProgressFill = document.getElementById('video-progress-fill');
  const videoCard = document.getElementById('video-card');
  const replayEnvelopeBtn = document.getElementById('replay-envelope-btn');

  let heroRevealed = false;
  let introDismissed = false;

  function triggerRevealHero() {
    if (heroRevealed) return;
    heroRevealed = true;
    revealHero();
  }

  function dismissIntro() {
    if (introDismissed) return;
    introDismissed = true;

    if (openingVideo) {
      openingVideo.pause();
    }

    if (openingCinematic) {
      openingCinematic.style.transition = 'opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1)';
      openingCinematic.style.opacity = '0';
      openingCinematic.style.transform = 'scale(1.04)';
      openingCinematic.style.pointerEvents = 'none';
      setTimeout(() => {
        openingCinematic.style.display = 'none';
      }, 950);
    }

    // Play golden wedding chime
    royalAudio.playDoorOpenSound();

    // Immediately start playing the wedding song ("Aaj Sajeya") as soon as video closes
    royalAudio.playSong((isPlaying) => {
      updateAudioUI(isPlaying);
    });

    triggerRevealHero();
  }

  // Ambient background video element
  const openingVideoAmbient = document.getElementById('opening-video-ambient') as HTMLVideoElement | null;

  const soundOnSvg = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>';
  const soundOffSvg = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>';

  function setVideoAudioState(isSoundOn: boolean) {
    if (!openingVideo) return;
    openingVideo.muted = !isSoundOn;
    if (isSoundOn) {
      openingVideo.volume = 1;
      if (soundIcon) soundIcon.innerHTML = soundOnSvg;
      if (soundText) soundText.textContent = 'Sound ON';
    } else {
      if (soundIcon) soundIcon.innerHTML = soundOffSvg;
      if (soundText) soundText.textContent = 'Mute';
    }
  }

  function toggleVideoSound() {
    if (!openingVideo) return;
    // Always keep sound ON!
    setVideoAudioState(true);
    openingVideo.volume = 1.0;
    openingVideo.play().catch(() => {});
  }

  // Enforce sound is always active on any interaction
  const enforceAllSoundActive = () => {
    if (openingVideo && !introDismissed) {
      openingVideo.muted = false;
      openingVideo.volume = 1.0;
      setVideoAudioState(true);
      if (openingVideo.paused) {
        openingVideo.play().catch(() => {});
      }
    }
    if (introDismissed && !royalAudio.getIsPlaying()) {
      royalAudio.playSong((isPlaying) => updateAudioUI(isPlaying));
    }
  };

  ['click', 'touchstart', 'touchend', 'pointerdown', 'keydown', 'scroll'].forEach((evt) => {
    window.addEventListener(evt, enforceAllSoundActive, { passive: true });
  });

  videoCard?.addEventListener('click', () => {
    enforceAllSoundActive();
  });

  unmuteBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    enforceAllSoundActive();
  });

  enterBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    dismissIntro();
  });

  if (openingVideo) {
    // Keep unmuted by default
    openingVideo.muted = false;
    openingVideo.volume = 1.0;

    const startPlayback = () => {
      const playPromise = openingVideo.play();
      if (playPromise !== undefined) {
        playPromise.then(() => {
          setVideoAudioState(true);
        }).catch(() => {
          // If browser policy prevents unmuted autoplay before user interaction:
          openingVideo.muted = true;
          openingVideo.play().catch(() => {});

          const unmuteOnFirstGesture = () => {
            if (openingVideo && !introDismissed) {
              setVideoAudioState(true);
            }
            window.removeEventListener('click', unmuteOnFirstGesture, { capture: true });
            window.removeEventListener('touchstart', unmuteOnFirstGesture, { capture: true });
            window.removeEventListener('pointerdown', unmuteOnFirstGesture, { capture: true });
            window.removeEventListener('keydown', unmuteOnFirstGesture, { capture: true });
          };

          window.addEventListener('click', unmuteOnFirstGesture, { once: true, capture: true });
          window.addEventListener('touchstart', unmuteOnFirstGesture, { once: true, capture: true });
          window.addEventListener('pointerdown', unmuteOnFirstGesture, { once: true, capture: true });
          window.addEventListener('keydown', unmuteOnFirstGesture, { once: true, capture: true });
        });
      }
    };

    startPlayback();

    openingVideo.addEventListener('timeupdate', () => {
      if (openingVideo.duration && videoProgressFill) {
        const pct = (openingVideo.currentTime / openingVideo.duration) * 100;
        videoProgressFill.style.width = pct + '%';
      }
      if (openingVideoAmbient && Math.abs(openingVideoAmbient.currentTime - openingVideo.currentTime) > 0.5) {
        openingVideoAmbient.currentTime = openingVideo.currentTime;
      }
    });

    openingVideo.addEventListener('ended', () => {
      setTimeout(() => {
        dismissIntro();
      }, 600);
    });
  }

  // Replay envelope video from hero section
  replayEnvelopeBtn?.addEventListener('click', () => {
    if (!openingCinematic || !openingVideo) return;
    // Pause background song while video is playing
    royalAudio.pauseSong((isPlaying) => {
      updateAudioUI(isPlaying);
    });
    introDismissed = false;
    openingCinematic.style.display = 'flex';
    openingCinematic.style.pointerEvents = 'auto';
    openingVideo.currentTime = 0;
    setVideoAudioState(true);
    requestAnimationFrame(() => {
      openingCinematic.style.opacity = '1';
      openingCinematic.style.transform = 'scale(1)';
      openingVideo.play().catch(() => {});
    });
  });


  function revealHero() {
    const tl = gsap.timeline();
    tl.to('#hero-tag', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' })
      .to('#hero-subtitle', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.4')
      .to('#hero-groom', { opacity: 1, duration: 0.2 }, '-=0.3')
      .fromTo('.hero-char-groom', 
        { opacity: 0, y: 40, rotateX: -60, scale: 0.8 }, 
        { opacity: 1, y: 0, rotateX: 0, scale: 1, duration: 0.7, stagger: 0.05, ease: 'back.out(1.7)' }, '-=0.2')
      .to('#hero-amp', { opacity: 1, duration: 0.6 }, '-=0.3')
      .to('#hero-bride', { opacity: 1, duration: 0.2 }, '-=0.3')
      .fromTo('.hero-char-bride', 
        { opacity: 0, y: 40, rotateX: -60, scale: 0.8 }, 
        { opacity: 1, y: 0, rotateX: 0, scale: 1, duration: 0.7, stagger: 0.06, ease: 'back.out(1.7)' }, '-=0.2')
      .to('#hero-invite', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, '-=0.4')
      .to('#hero-date', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.3')
      .to('#countdown', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, '-=0.2')
      .to('#hero-ctas', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.3')
      .to('#scroll-indicator', { opacity: 1, duration: 0.6 }, '-=0.1');
  }

  // Set initial states
  gsap.set(['#hero-tag','#hero-subtitle','#hero-groom','#hero-amp','#hero-bride','#hero-invite','#hero-date','#countdown','#hero-ctas','#scroll-indicator'], {
    y: 30, opacity: 0
  });

  // ── NAVBAR scroll behavior ─────────────────────────────────────────
  const navbar = document.getElementById('navbar');
  ScrollTrigger.create({
    start: 'top -80px',
    onEnter: () => navbar && (navbar.style.background = 'rgba(255,255,255,0.92)', navbar.style.backdropFilter = 'blur(20px)', (navbar.style as any).borderBottom = '1px solid rgba(212,175,55,0.25)'),
    onLeaveBack: () => navbar && (navbar.style.background = 'rgba(250,246,240,0.0)', navbar.style.backdropFilter = '', (navbar.style as any).borderBottom = ''),
  });

  // ── SCROLL-TO-TOP button ─────────────────────────────────────────
  const scrollTopBtn = document.getElementById('scroll-top-btn');
  ScrollTrigger.create({
    start: 'top -400px',
    onEnter: () => scrollTopBtn && gsap.to(scrollTopBtn, { opacity: 1, duration: 0.3 }),
    onLeaveBack: () => scrollTopBtn && gsap.to(scrollTopBtn, { opacity: 0, duration: 0.3 }),
  });

  // ── REVEAL SECTIONS on scroll ─────────────────────────────────────
  document.querySelectorAll('.reveal-section').forEach(el => {
    gsap.fromTo(el,
      { opacity: 0, y: 60 },
      { opacity: 1, y: 0, duration: 1, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 80%', toggleActions: 'play none none reverse' }
      }
    );
  });

  // Story items stagger
  gsap.fromTo('.story-item', { opacity: 0, y: 40 }, {
    opacity: 1, y: 0, duration: 0.8, stagger: 0.2, ease: 'power2.out',
    scrollTrigger: { trigger: '#story', start: 'top 70%' }
  });

  // Event cards stagger
  gsap.fromTo('.event-card', { opacity: 0, y: 50, scale: 0.95 }, {
    opacity: 1, y: 0, scale: 1, duration: 0.7, stagger: 0.1, ease: 'power2.out',
    scrollTrigger: { trigger: '#events', start: 'top 70%' }
  });

  // SVG border draw
  document.querySelectorAll('.svg-draw-rect').forEach(el => {
    ScrollTrigger.create({
      trigger: el.closest('section') || el,
      start: 'top 70%',
      onEnter: () => gsap.to(el, { 'stroke-dashoffset': 0, duration: 2, ease: 'power2.out' }),
    });
  });

  // Couple card cursor glow
  document.querySelectorAll('.couple-card').forEach(card => {
    const glow = card.querySelector('.couple-glow') as HTMLElement | null;
    card.addEventListener('mousemove', (e: Event) => {
      if (!glow) return;
      const mouseEvent = e as MouseEvent;
      const rect = (card as HTMLElement).getBoundingClientRect();
      const x = ((mouseEvent.clientX - rect.left) / rect.width) * 100;
      const y = ((mouseEvent.clientY - rect.top) / rect.height) * 100;
      glow.style.setProperty('--mx', `${x}%`);
      glow.style.setProperty('--my', `${y}%`);
      glow.style.opacity = '1';
    });
    card.addEventListener('mouseleave', () => {
      if (glow) glow.style.opacity = '0';
    });
  });

  // Event card tilt
  document.querySelectorAll('.event-card').forEach(card => {
    card.addEventListener('mousemove', (e: Event) => {
      const mouseEvent = e as MouseEvent;
      const el = card as HTMLElement;
      const rect = el.getBoundingClientRect();
      const x = (mouseEvent.clientX - rect.left) / rect.width - 0.5;
      const y = (mouseEvent.clientY - rect.top) / rect.height - 0.5;
      el.style.transform = `perspective(1000px) rotateX(${y * -8}deg) rotateY(${x * 8}deg) scale(1.02)`;
    });
    card.addEventListener('mouseleave', () => {
      (card as HTMLElement).style.transform = '';
    });
  });

  // Parallax on mouse move
  document.addEventListener('mousemove', (e) => {
    const xPct = (e.clientX / window.innerWidth - 0.5) * 2;
    const yPct = (e.clientY / window.innerHeight - 0.5) * 2;
    document.querySelectorAll<HTMLElement>('.parallax-layer').forEach(el => {
      const depth = parseFloat(el.dataset.depth || '0.1');
      gsap.to(el, { x: xPct * 40 * depth, y: yPct * 40 * depth, duration: 1, ease: 'power1.out' });
    });
    const mandala = document.getElementById('hero-mandala');
    if (mandala) {
      gsap.to(mandala, { x: xPct * 20, y: yPct * 20, duration: 2, ease: 'power1.out' });
    }
  });

  // ── COUNTDOWN FLIP-CLOCK ──────────────────────────────────────────
  const weddingDate = new Date('2026-12-11T19:00:00+05:30').getTime();
  const prevVals: Record<string, number> = { days: -1, hours: -1, minutes: -1, seconds: -1 };

  function updateCountdown() {
    const now = Date.now();
    const diff = weddingDate - now;
    if (diff <= 0) return;
    const vals = {
      days: Math.floor(diff / 86400000),
      hours: Math.floor((diff % 86400000) / 3600000),
      minutes: Math.floor((diff % 3600000) / 60000),
      seconds: Math.floor((diff % 60000) / 1000),
    };
    Object.entries(vals).forEach(([key, val]) => {
      const el = document.getElementById(`cd-${key}-val`);
      const card = document.getElementById(`cd-${key}`);
      if (el && val !== prevVals[key]) {
        prevVals[key] = val;
        el.textContent = String(val).padStart(2, '0');
        if (card) {
          gsap.fromTo(card, { rotateX: -20, scale: 0.95 }, { rotateX: 0, scale: 1, duration: 0.3, ease: 'power2.out' });
        }
      }
    });
  }
  setInterval(updateCountdown, 1000);
  updateCountdown();


  // ── ICS DOWNLOAD ──────────────────────────────────────────────────
  function downloadICS() {
    const ics = [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'PRODID:-//MukeshWedsPuja//Wedding//EN',
      'BEGIN:VEVENT',
      'UID:mukesh-weds-puja-2026@wedding',
      'DTSTART:20261211T130000Z',
      'DTEND:20261211T203000Z',
      'SUMMARY:Mukesh Ojha weds Puja | #MukeshWedsPuja',
      'DESCRIPTION:The Royal Wedding of Mukesh Ojha & Puja. #MukeshWedsPuja',
      'LOCATION:Grand Rajwada Mandap\\, Dugda\\, Bokaro\\, Jharkhand - 828404',
      'STATUS:CONFIRMED',
      'END:VEVENT',
      'END:VCALENDAR',
    ].join('\r\n');
    const blob = new Blob([ics], { type: 'text/calendar' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'MukeshWedsPuja.ics'; a.click();
    URL.revokeObjectURL(url);
  }

  document.getElementById('add-to-cal-btn')?.addEventListener('click', downloadICS);
  document.getElementById('add-to-cal-2')?.addEventListener('click', downloadICS);

  // ── HASHTAG COPY ──────────────────────────────────────────────────
  document.getElementById('copy-hashtag')?.addEventListener('click', () => {
    navigator.clipboard.writeText('#MukeshWedsPuja').then(() => {
      const toast = document.getElementById('copy-toast');
      if (toast) { toast.classList.remove('hidden'); setTimeout(() => toast.classList.add('hidden'), 2000); }
    });
  });

  // ── RSVP FORM ────────────────────────────────────────────────────
  document.getElementById('rsvp-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('rsvp-submit') as HTMLButtonElement;
    const name = (document.getElementById('rsvp-name') as HTMLInputElement).value;
    btn.textContent = 'Sending... ✦';
    btn.disabled = true;

    // Confetti burst
    try {
      const confetti = (await import('canvas-confetti')).default;
      confetti({ particleCount: 120, spread: 80, colors: ['#E0B84F','#FFB1C7','#FED467','#FFDF95'], origin: { y: 0.7 } });
      setTimeout(() => confetti({ particleCount: 60, spread: 120, angle: 60, colors: ['#E0B84F','#FFB1C7'] }), 300);
      setTimeout(() => confetti({ particleCount: 60, spread: 120, angle: 120, colors: ['#E0B84F','#FFB1C7'] }), 500);
    } catch (e) {}

    // Simulate submit (replace with your backend endpoint)
    await new Promise(r => setTimeout(r, 1000));
    (document.getElementById('rsvp-form') as HTMLFormElement).reset();
    btn.textContent = 'Confirm Royal Presence ✦';
    btn.disabled = false;
    const success = document.getElementById('rsvp-success');
    if (success) success.classList.remove('hidden');
    setTimeout(() => success?.classList.add('hidden'), 5000);
  });

  // ── GALLERY LIGHTBOX ─────────────────────────────────────────────
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxSub = document.getElementById('lightbox-sub');
  const lightboxClose = document.getElementById('lightbox-close');

  document.querySelectorAll('.gallery-item').forEach(item => {
    item.addEventListener('click', () => {
      const el = item as HTMLElement;
      const src = el.dataset.src || '';
      const title = el.dataset.title || '';
      const sub = el.dataset.sub || '';
      if (lightbox && lightboxImg) {
        lightboxImg.src = src;
        if (lightboxTitle) lightboxTitle.textContent = title;
        if (lightboxSub) lightboxSub.textContent = sub;
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
      }
    });
  });

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
    }
  }

  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });

  // ── AUDIO CONTROLS (HOWLER / WEB AUDIO SYNTH) ─────────────────────
  const audioToggle = document.getElementById('audio-toggle');
  const audioIcon = document.getElementById('audio-icon');
  const musicWidget = document.getElementById('music-widget');

  function updateAudioUI(isPlaying: boolean) {
    if (audioIcon) {
      audioIcon.innerHTML = isPlaying
        ? '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" rx="1"></rect><rect x="14" y="4" width="4" height="16" rx="1"></rect></svg>'
        : '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>';
    }
    if (audioToggle) {
      audioToggle.style.borderColor = isPlaying ? 'rgba(254,212,103,0.8)' : 'rgba(224,184,79,0.25)';
      audioToggle.style.boxShadow = isPlaying ? '0 0 16px rgba(254,212,103,0.3)' : 'none';
    }
    if (musicWidget) {
      musicWidget.style.borderColor = isPlaying ? 'rgba(254,212,103,0.8)' : 'rgba(224,184,79,0.25)';
      musicWidget.style.boxShadow = isPlaying ? '0 0 24px rgba(254,212,103,0.35)' : 'none';
    }
  }

  const handleToggleMusic = () => {
    royalAudio.toggleMusic((isPlaying) => {
      updateAudioUI(isPlaying);
    });
  };

  audioToggle?.addEventListener('click', handleToggleMusic);
  musicWidget?.addEventListener('click', handleToggleMusic);
  if (musicWidget) musicWidget.style.cursor = 'pointer';

  // ── MOBILE MENU DRAWER ───────────────────────────────────────────
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const mBar1 = document.getElementById('m-bar-1');
  const mBar2 = document.getElementById('m-bar-2');
  const mBar3 = document.getElementById('m-bar-3');
  let isMobileMenuOpen = false;

  function toggleMobileMenu(forceClose?: boolean) {
    if (!mobileDrawer) return;
    isMobileMenuOpen = forceClose ? false : !isMobileMenuOpen;

    if (isMobileMenuOpen) {
      mobileDrawer.classList.remove('hidden');
      mobileDrawer.classList.add('flex');
      document.body.style.overflow = 'hidden';
      if (mBar1) mBar1.style.transform = 'translateY(6px) rotate(45deg)';
      if (mBar2) mBar2.style.opacity = '0';
      if (mBar3) mBar3.style.transform = 'translateY(-6px) rotate(-45deg)';
    } else {
      mobileDrawer.classList.add('hidden');
      mobileDrawer.classList.remove('flex');
      document.body.style.overflow = '';
      if (mBar1) mBar1.style.transform = '';
      if (mBar2) mBar2.style.opacity = '1';
      if (mBar3) mBar3.style.transform = '';
    }
  }

  mobileMenuBtn?.addEventListener('click', () => toggleMobileMenu());
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => toggleMobileMenu(true));
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1280 && isMobileMenuOpen) {
      toggleMobileMenu(true);
    }
  });
</script>
