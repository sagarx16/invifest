---
import Layout from '../layouts/Layout.astro';

const sacredRituals = [
  {
    num: 'I',
    counter: '01',
    hindi: 'वधू आगमन',
    title: 'Vadhu Aagman',
    tagline: 'She arrives like a festival.',
    text: 'Beneath a canopy of twinkling lights held high by the people who love her, the bride steps forward, every sequin catching the glow. The whole mandap holds its breath. This is the moment everyone waited for: she arrives, and the evening becomes a celebration.',
    img: '/rituals/c888d80fe207447a5afadd5f379afe4e.jpg',
    alt: 'Bride walking under a canopy of fairy lights, Vadhu Aagman',
    objectPosition: 'center 35%',
    scaleFix: false
  },
  {
    num: 'II',
    counter: '02',
    hindi: 'जयमाला',
    title: 'Jaimala',
    tagline: 'Two garlands, one yes.',
    text: 'Garlands of roses and carnations rise, and each of them says yes to the other in front of everyone they love. The Jaimala is the first public promise, full of playful laughter, gentle respect and the joy of a welcome that lasts a lifetime.',
    img: '/rituals/165b7b72155727b8c64401bbcb5faa88.jpg',
    alt: 'Pink and white carnation garlands, hathphool and hand resting on groom arm, Jaimala',
    objectPosition: 'center 40%',
    scaleFix: false
  },
  {
    num: 'III',
    counter: '03',
    hindi: 'मंगल मिलन',
    title: 'Mangal Milan',
    tagline: 'Side by side, at last.',
    text: 'Wrapped in the fragrance of jasmine and blush carnations, they stand together, fingers quietly finding each other. No words are needed. Just the soft chime of bangles and the calm of two people who have found their home in each other.',
    img: '/rituals/005e44603a92a4cf5982aceac2474629.jpg',
    alt: 'Couple standing side by side with jasmine garlands and hands clasped, Mangal Milan',
    objectPosition: 'center 45%',
    scaleFix: false
  },
  {
    num: 'IV',
    counter: '04',
    hindi: 'कन्यादान',
    title: 'Kanyadaan',
    tagline: "A family's blessing, a family's trust.",
    text: 'With mauli on the wrist and sacred water in hand, the family places its most precious joy into new care. Kanyadaan is not a goodbye. It is an offering made with love and complete trust, a blessing the bride carries with her wherever she goes.',
    img: '/rituals/wed.jpg',
    alt: 'Henna-covered hand with sacred mauli thread on wrist, Kanyadaan',
    objectPosition: 'center 50%',
    scaleFix: false
  },
  {
    num: 'V',
    counter: '05',
    hindi: 'हस्त मिलाप',
    title: 'Hast Milap',
    tagline: 'Where two hands become one path.',
    text: 'A golden thread above, fingers entwined below. In the hush of the ceremony, two hands meet and a shared road begins: to walk together, to hold on through every season, and to never let go in the dark.',
    img: '/rituals/eb47fe994cdd0048dccb38042104a50c.jpg',
    alt: 'Two joined hands with thin gold thread arching across the frame, Hast Milap',
    objectPosition: 'center 45%',
    scaleFix: false
  },
  {
    num: 'VI',
    counter: '06',
    hindi: 'पाणिग्रहण',
    title: 'Pani Grahan',
    tagline: 'I take your hand, and I take your life with mine.',
    text: "Before the sacred fire, the groom accepts the bride's hand, her palm holding petals, her bangles ringing like temple bells. Pani Grahan is the vow of partnership: in joy and in struggle, and in all the beautiful ordinary days that come after.",
    img: '/rituals/2363c9d13ae0d4c75da43bf00ae75179.jpg',
    alt: 'Open palm holding red rose petal before sacred fire, Pani Grahan',
    objectPosition: 'center 50%',
    scaleFix: false
  },
  {
    num: 'VII',
    counter: '07',
    hindi: 'मौली बंधन',
    title: 'Mauli Bandhan',
    tagline: 'A thread of red and gold, a blessing that binds.',
    text: 'A sacred thread is wound around the couple and the holy space, guarding them with the prayers of generations. Simple, humble and powerful, it carries the blessings of those who came before, tied gently around those who are just beginning.',
    img: '/rituals/wedd.jpg',
    alt: 'Sacred red and white thread crossing joined hands, Mauli Bandhan',
    objectPosition: 'center 40%',
    scaleFix: false
  },
  {
    num: 'VIII',
    counter: '08',
    hindi: 'गठबंधन',
    title: 'Gathbandhan',
    tagline: 'A knot that no distance can loosen.',
    text: "The bride's dupatta is tied to the groom's, silk and flowers drawn together in a single knot. It is the knot of destiny: two families, two lives, one promise, tied with love and carried into every step of the phere.",
    img: '/rituals/wedding.jpg',
    alt: "Pink dupatta knotted to red net dupatta glowing in sunlight, Gathbandhan",
    objectPosition: 'center 40%',
    scaleFix: false
  },
  {
    num: 'IX',
    counter: '09',
    hindi: 'सात फेरे',
    title: 'Saat Phere',
    tagline: 'Seven steps, seven promises, one lifetime.',
    text: 'Bound together by the knot, they walk around the sacred fire. Each step carries a vow: nourishment, strength, prosperity, joy, family, harmony and lifelong friendship. With the first step they are two people in love. With the seventh, they are family.',
    img: '/rituals/7b404c8d76c65a9103a995c42b05a430.jpg',
    alt: 'Two hands held up with dupatta knot tassels against bright sky, Saat Phere',
    objectPosition: 'center 45%',
    scaleFix: false
  },
  {
    num: 'X',
    counter: '10',
    hindi: 'सिंदूर दान',
    title: 'Sindoor Daan',
    tagline: 'A thin red line, a lifetime of love.',
    text: 'With a steady hand and a gentle smile, the groom fills the parting of her hair with sindoor. A single touch, a single colour: red for love, for devotion, and for the start of a home built together.',
    img: '/rituals/55bb27790893c4c7dc4499806a76d4d3.jpg',
    alt: "Groom applying vermilion sindoor in the bride's parting, Sindoor Daan",
    objectPosition: 'center 25%',
    scaleFix: false
  },
  {
    num: 'XI',
    counter: '11',
    hindi: 'गृह प्रवेश',
    title: 'Griha Pravesh',
    tagline: 'Rice, rose petals, and a new beginning.',
    text: 'At the threshold, the bride softly tips the kalash of rice with her foot, letting prosperity spill into her new home along with petals and blessings. Griha Pravesh welcomes her as the light of the household: its luck, its laughter and its warmth.',
    img: '/rituals/268c82ee4b857fdee4525f5c0afeb094.jpg',
    alt: "Bride's henna-decorated foot tipping copper kalash of rice over rose petals, Griha Pravesh",
    objectPosition: 'center top',
    scaleFix: true
  }
];
---

<Layout title="Mukesh Weds Puja | Wedding Invitation" description="With divine blessings and ancestral grace, you are cordially invited to the Royal Wedding of Mukesh Ojha & Puja on 11th December 2026 at Dugda, Bokaro.">

  <!-- ========== GRAND OPENING ENVELOPE CINEMATIC (FULL WINDOW) ========== -->
  <div id="opening-cinematic" class="fixed inset-0 z-[10000] w-screen h-screen overflow-hidden select-none transition-all duration-1000 flex flex-col justify-between" style="background:#150D0A;">
    <!-- Ambient Blur Background Video Layer (fills widescreen behind) -->
    <video
      id="opening-video-ambient"
      playsinline
      autoplay
      muted
      loop
      class="absolute inset-0 w-full h-full object-cover filter blur-3xl opacity-50 scale-110 pointer-events-none"
    >
      <source src="/videos/opening.mp4" type="video/mp4" />
    </video>

    <!-- Main Full-Window Video Container -->
    <div class="absolute inset-0 w-full h-full flex items-center justify-center cursor-pointer" id="video-card">
      <video
        id="opening-video"
        playsinline
        autoplay
        poster="/images/video_thumb.jpg"
        class="w-full h-full object-cover sm:object-contain md:object-cover pointer-events-auto"
      >
        <source src="/videos/opening.mp4" type="video/mp4" />
      </video>
    </div>

  </div>


  <!-- ========== HERO SECTION ========== -->
  <section id="hero" class="relative min-h-screen flex flex-col items-center justify-center text-center px-4 sm:px-6 overflow-hidden py-12 sm:py-14 md:py-16">
    <!-- Hero Royal Background Image (Mukesh & Puja) - Clean & Vibrant -->
    <div class="absolute inset-0 z-[1] overflow-hidden pointer-events-none">
      <img
        src="/hero.jpg"
        alt="Mukesh & Puja Royal Portrait"
        class="w-full h-full object-cover object-[center_20%] sm:object-[center_28%] scale-100 transition-transform duration-1000"
      />
    </div>

    <!-- 1. Even soft ivory vignette frame around all four sides (8-12% viewport, equal thickness in vmin) -->
    <div
      class="absolute inset-0 z-[2] pointer-events-none"
      style="box-shadow: inset 0 0 10vmin 3.5vmin rgba(255, 248, 231, 0.95), inset 0 0 16vmin 7vmin rgba(255, 248, 231, 0.55);"
    ></div>

    <!-- 4. Localized soft dark gradient behind the names and description for razor-sharp gold contrast without darkening the whole image -->
    <div class="absolute inset-0 z-[3] pointer-events-none flex items-center justify-center">
      <div
        class="w-[92%] max-w-2xl h-[72%] max-h-[560px] rounded-full"
        style="background: radial-gradient(ellipse at center, rgba(18, 9, 4, 0.45) 0%, rgba(18, 9, 4, 0.22) 55%, transparent 75%); filter: blur(24px);"
      ></div>
    </div>

    <!-- Content: Elegant Royal Typography Floating Over The Portrait -->
    <div class="relative z-[8] max-w-4xl mx-auto flex flex-col items-center">
      <!-- Auspicious Invocation Pill: English with Aaj Sajeya Font & Color -->
      <div id="hero-tag" class="inline-flex items-center gap-2.5 px-6 py-2 rounded-full mb-3 sm:mb-4 opacity-0 shadow-sm" style="background:rgba(250,242,228,0.85);backdrop-filter:blur(16px);border:1px solid rgba(212,175,55,0.4);box-shadow:0 6px 20px rgba(160,120,70,0.12);">
        <span class="text-[#8C6219] text-xs">✦</span>
        <span class="font-['Montserrat'] text-[#8C6219] text-[10px] sm:text-xs tracking-widest uppercase font-semibold">Shri Ganeshaya Namah</span>
        <span class="text-[#8C6219] text-xs">✦</span>
      </div>

      <!-- Subtitle Badge: Aaj Sajeya Font & Color with generous bottom margin -->
      <div id="hero-subtitle" class="inline-flex items-center gap-2 px-5 py-1.5 rounded-full mb-6 sm:mb-8 md:mb-9 opacity-0 shadow-xs" style="background:rgba(250,242,228,0.85);backdrop-filter:blur(16px);border:1px solid rgba(212,175,55,0.4);box-shadow:0 4px 16px rgba(160,120,70,0.1);">
        <span class="font-['Montserrat'] text-[9px] sm:text-[10px] tracking-widest uppercase text-[#8C6219] font-semibold">The Auspicious Wedding Of</span>
      </div>

      <!-- 2 & 3. Royal Names: Generous Vertical Breathing Room, Twinkling Sparkles & Gold Shine Sweep -->
      <div id="hero-names-wrap" class="relative my-2 sm:my-4 text-center w-full max-w-3xl mx-auto">
        <!-- 6 Tiny Sparkle Stars Twinkling Near Calligraphy Letters -->
        <span class="name-sparkle text-[#FFE89E] text-xs sm:text-sm" style="top:2%; left:8%; animation-delay:0s;">✦</span>
        <span class="name-sparkle text-[#FFF4C7] text-sm sm:text-base" style="top:10%; right:10%; animation-delay:0.8s;">✦</span>
        <span class="name-sparkle text-[#FFE89E] text-[10px] sm:text-xs" style="top:44%; left:16%; animation-delay:1.5s;">✦</span>
        <span class="name-sparkle text-[#FFF4C7] text-[10px] sm:text-xs" style="top:46%; right:18%; animation-delay:0.4s;">✦</span>
        <span class="name-sparkle text-[#FFE89E] text-xs sm:text-sm" style="top:74%; left:12%; animation-delay:1.1s;">✦</span>
        <span class="name-sparkle text-[#FFF4C7] text-sm sm:text-base" style="top:88%; right:12%; animation-delay:1.9s;">✦</span>

        <!-- One-time bright flash burst on initial reveal -->
        <div class="hero-names-flash absolute inset-0 pointer-events-none rounded-full" style="background:radial-gradient(circle, rgba(255,255,255,0.8) 0%, rgba(245,210,108,0.5) 45%, transparent 70%); opacity:0; filter:blur(14px);"></div>

        <h1 id="hero-groom" class="font-['Great_Vibes'] opacity-0 leading-[1.1] tracking-[0.06em] sm:tracking-[0.08em] name-shine" style="font-size:clamp(54px,11vw,116px);">
          Mukesh Ojha
        </h1>
        <div id="hero-amp" class="flex items-center justify-center gap-3 sm:gap-5 my-4 sm:my-6 md:my-7 opacity-0">
          <div class="h-px w-16 sm:w-28" style="background:linear-gradient(90deg,transparent,#D4AF37);"></div>
          <span class="px-5 py-1 rounded-full font-['Montserrat'] font-semibold text-[10px] sm:text-[11px] tracking-widest uppercase flex items-center gap-2 shadow-sm" style="background:rgba(250,242,228,0.85);border:1px solid rgba(212,175,55,0.4);color:#8C6219;">
            <span class="text-[9px] text-[#8C6219]">✦</span>
            <span>Weds</span>
            <span class="text-[9px] text-[#8C6219]">✦</span>
          </span>
          <div class="h-px w-16 sm:w-28" style="background:linear-gradient(270deg,transparent,#D4AF37);"></div>
        </div>
        <h1 id="hero-bride" class="font-['Great_Vibes'] opacity-0 leading-[1.1] tracking-[0.06em] sm:tracking-[0.08em] name-shine" style="font-size:clamp(54px,11vw,116px);">
          Puja
        </h1>
      </div>

      <!-- Invitation Text: Floating Golden & Non-Bold with proper separation -->
      <div id="hero-invite" class="max-w-xl mx-auto mt-6 sm:mt-8 md:mt-10 mb-6 sm:mb-8 opacity-0 px-4 text-center">
        <p class="font-['Montserrat'] text-[#E5C158] leading-relaxed font-normal tracking-wide" style="font-size:clamp(13px,1.35vw,15.5px);text-shadow:0 1px 4px rgba(0,0,0,0.75), 0 2px 12px rgba(0,0,0,0.6);">
          Cordially invite you to celebrate our sacred union amidst palatial grace, ancestral rites, and celestial splendour.
        </p>
      </div>

      <!-- Single Grand Explore Celebrations CTA -->
      <div id="hero-ctas" class="flex items-center justify-center w-full opacity-0 mt-2 sm:mt-4">
        <a href="#save-the-date" class="group px-9 sm:px-12 py-4 sm:py-4.5 rounded-full font-['Cinzel'] text-xs sm:text-sm tracking-[0.25em] uppercase font-normal transition-all duration-500 ripple-btn shine-btn relative overflow-hidden magnetic-btn hover:scale-105 active:scale-95 shadow-[0_8px_30px_rgba(184,134,11,0.35)] flex items-center gap-3" style="background:linear-gradient(135deg, #DFB756 0%, #B8860B 50%, #8C6219 100%);color:#FFFFFF;border:1px solid rgba(255,255,255,0.4);">
          <span>Explore Celebrations</span>
          <span class="text-xs transition-transform duration-300 group-hover:translate-x-1">✦</span>
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div id="scroll-indicator" class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-0 z-[8]">
      <span class="font-['Montserrat'] text-[9px] tracking-[0.25em] uppercase text-[#A07828] font-normal">Scroll</span>
      <div class="w-0.5 h-12 relative overflow-hidden" style="background:rgba(212,175,55,0.25);">
        <div class="w-full h-1/2 absolute top-0" style="background:#D4AF37;animation:scroll-pulse 1.5s ease-in-out infinite;"></div>
      </div>
    </div>
  </section>

  <!-- ========== SAVE THE DATE & LIVE COUNTDOWN SECTION ========== -->
  <section id="save-the-date" class="py-20 sm:py-28 px-4 sm:px-6 relative overflow-hidden" style="background:radial-gradient(ellipse at 50% 20%, #FFFDF8 0%, #F9F3E8 55%, #F0E6D4 100%);">
    <!-- Subtle Golden Borders & Flourishes -->
    <div class="absolute top-0 left-0 right-0 h-px" style="background:linear-gradient(90deg,transparent,#D4AF37,transparent);"></div>
    <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg,transparent,#D4AF37,transparent);"></div>

    <div class="max-w-4xl mx-auto relative z-10 text-center reveal-section">
      <!-- Section Tag -->
      <div class="inline-flex items-center gap-2 px-5 py-1.5 rounded-full mb-3 shadow-xs" style="background:rgba(255,253,248,0.92);border:1px solid rgba(212,175,55,0.45);">
        <span class="text-[#B8860B] text-xs">✦</span>
        <span class="font-['Montserrat'] text-[10px] sm:text-xs tracking-[0.35em] uppercase text-[#A07828] font-normal">The Date</span>
        <span class="text-[#B8860B] text-xs">✦</span>
      </div>

      <!-- Main Title (golden & elegant serif, non-bold) -->
      <h2 class="font-['Playfair_Display'] text-4xl sm:text-5xl md:text-6xl text-[#B8860B] font-normal mb-3 tracking-tight">
        Save the Date
      </h2>
      <p class="font-['Playfair_Display'] italic text-[#A07828] text-sm sm:text-base font-normal mb-8 sm:mb-12 flex items-center justify-center gap-2">
        <span>Scratch below to reveal our wedding date</span>
        <span class="text-[#B8860B]">✨</span>
      </p>

      <!-- Royal Jharokha Arch SVG Clip-Path Definition -->
      <svg class="absolute w-0 h-0 overflow-hidden pointer-events-none" width="0" height="0" aria-hidden="true">
        <defs>
          <clipPath id="jharokha-arch-clip" clipPathUnits="objectBoundingBox">
            <path d="M 0,1 L 0,0.28 C 0,0.18 0.12,0.14 0.25,0.13 C 0.38,0.12 0.44,0.03 0.5,0 C 0.56,0.03 0.62,0.12 0.75,0.13 C 0.88,0.14 1,0.18 1,0.28 L 1,1 Z" />
          </clipPath>
        </defs>
      </svg>

      <!-- 3 Interactive Scratch Cards: Royal Jharokha Arches -->
      <div id="scratch-cards-container" class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 md:gap-8 mb-6 relative transition-transform duration-300">
        <!-- MONTH CARD (Jharokha Arch) -->
        <div class="flex flex-col items-center">
          <span class="font-['Montserrat'] text-[10px] sm:text-xs tracking-[0.28em] uppercase text-[#A07828] font-normal mb-6 sm:mb-7 flex items-center gap-1.5">
            <span class="text-[#B8860B] text-[9px]">✦</span>
            <span>Month</span>
            <span class="text-[#B8860B] text-[9px]">✦</span>
          </span>
          <div class="scratch-card card-pulse-glow card-float-1 relative select-none w-[115px] h-[175px] sm:w-[135px] sm:h-[205px] md:w-[150px] md:h-[225px] focus:outline-none transition-transform duration-300" tabindex="0" role="button" aria-label="Scratch card for Month. Press Space or Enter to scratch" data-card="month" style="filter:drop-shadow(0 10px 22px rgba(184,134,11,0.28)) drop-shadow(0 0 10px rgba(212,175,55,0.32));">
            <!-- Jharokha Arch Clipped Content -->
            <div class="relative w-full h-full overflow-hidden" style="clip-path:url(#jharokha-arch-clip);-webkit-clip-path:url(#jharokha-arch-clip);">
              <!-- 4. Revealed Content Underneath: Deep Maroon (#5A0F1F) with Gold Mandala & Gradient Serif -->
              <div class="absolute inset-0 flex flex-col items-center justify-center p-3 text-center overflow-hidden" style="background:radial-gradient(circle at 50% 35%, #6E1528 0%, #5A0F1F 55%, #3B0813 100%);">
                <!-- Faint Gold Mandala Watermark -->
                <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.14]" viewBox="0 0 100 100" fill="none" stroke="#D4AF37">
                  <circle cx="50" cy="52" r="30" stroke-width="0.8"/>
                  <circle cx="50" cy="52" r="20" stroke-width="0.6" stroke-dasharray="2 1.5"/>
                  <circle cx="50" cy="52" r="8" stroke-width="0.8"/>
                  <path d="M 50,22 L 50,82 M 20,52 L 80,52 M 29,31 L 71,73 M 29,73 L 71,31" stroke-width="0.5"/>
                </svg>
                <!-- Revealed Details: Big Gold Gradient Serif -->
                <div class="relative z-10 flex flex-col items-center pt-5 sm:pt-6">
                  <span class="font-['Cinzel'] font-bold text-3xl sm:text-4xl md:text-5xl tracking-wider leading-none text-transparent bg-clip-text bg-gradient-to-b from-[#FFF5D6] via-[#DFB756] to-[#B8860B] drop-shadow-[0_2px_8px_rgba(212,175,55,0.4)]">DEC</span>
                  <span class="font-['Montserrat'] text-[9px] sm:text-[10px] tracking-[0.25em] uppercase text-[#E5C158] font-medium mt-1.5">December</span>
                  <span class="font-['Playfair_Display'] text-[11px] text-[#F3E5AB] italic mt-0.5">मार्गशीर्ष</span>
                  <span class="text-[#DFB756] text-[8px] sm:text-[9px] mt-2 opacity-80 tracking-widest">✦ ─ ❖ ─ ✦</span>
                </div>
              </div>

              <!-- Initial Foil Placeholder (zero flash before canvas initializes) -->
              <div class="card-foil-placeholder absolute inset-0 z-11 pointer-events-none" style="background:linear-gradient(135deg, #B8902F 0%, #F4E3B5 32%, #D4AF37 68%, #A87B22 100%);"></div>

              <!-- Canvas Scratch Foil Layer -->
              <canvas class="scratch-canvas absolute inset-0 w-full h-full z-10" width="150" height="225"></canvas>
              <!-- Soft Diagonal Shimmer Streak -->
              <div class="scratch-foil-shimmer" style="animation-delay:0s;"></div>
              <!-- Center Engraved Sparkle Icon Hint with Slow Pulse -->
              <div class="card-center-sparkle absolute z-15 pointer-events-none text-[#5A0F1F] text-xs font-serif" style="top:52%;left:50%;transform:translate(-50%,-50%);">✦</div>
            </div>

            <!-- Double Gold Arch Border Outline & Lotus Finial Overlay -->
            <svg class="absolute inset-0 w-full h-full pointer-events-none z-20" viewBox="0 0 100 100" preserveAspectRatio="none">
              <path d="M 1,99 L 1,28 C 1,18 12,14 25,13 C 38,12 44,3 50,1 C 56,3 62,12 75,13 C 88,14 99,18 99,28 L 99,99 Z" fill="none" stroke="#9A7420" stroke-width="2.2" />
              <path d="M 4,96 L 4,30 C 4,21 15,17 26,16 C 38,15 44,6 50,3.5 C 56,6 62,15 74,16 C 85,17 96,21 96,30 L 96,96 Z" fill="none" stroke="rgba(212,175,55,0.6)" stroke-width="1" />
            </svg>
            <div class="absolute -top-2 left-1/2 -translate-x-1/2 z-25 pointer-events-none text-[#9A7420] text-xs leading-none select-none drop-shadow-sm">🪷</div>
          </div>
        </div>

        <!-- DAY CARD (Jharokha Arch - Slightly Bigger & Raised) -->
        <div class="flex flex-col items-center">
          <span class="font-['Montserrat'] text-[10px] sm:text-xs tracking-[0.28em] uppercase text-[#A07828] font-normal mb-7 sm:mb-8 flex items-center gap-1.5">
            <span class="text-[#B8860B] text-[9px]">✦</span>
            <span>Day</span>
            <span class="text-[#B8860B] text-[9px]">✦</span>
          </span>
          <div class="scratch-card card-pulse-glow card-float-2 relative select-none w-[126px] h-[190px] sm:w-[148px] sm:h-[222px] md:w-[164px] md:h-[242px] -translate-y-2 sm:-translate-y-3 focus:outline-none transition-transform duration-300" tabindex="0" role="button" aria-label="Scratch card for Day. Press Space or Enter to scratch" data-card="day" style="filter:drop-shadow(0 12px 26px rgba(184,134,11,0.32)) drop-shadow(0 0 12px rgba(212,175,55,0.36));">
            <!-- Jharokha Arch Clipped Content -->
            <div class="relative w-full h-full overflow-hidden" style="clip-path:url(#jharokha-arch-clip);-webkit-clip-path:url(#jharokha-arch-clip);">
