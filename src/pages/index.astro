  // ── CEREMONIES TIMELINE ANIMATION (INTERSECTION OBSERVER & LINE DRAW) ──
  let ceremoniesObserver: IntersectionObserver | null = null;
  let updateCerLineProgress: (() => void) | null = null;

  const setupCeremoniesAnimation = () => {
    const eventsSection = document.getElementById('events');
    if (!eventsSection) return;

    if (ceremoniesObserver) {
      ceremoniesObserver.disconnect();
      ceremoniesObserver = null;
    }
    if (updateCerLineProgress) {
      window.removeEventListener('scroll', updateCerLineProgress);
      updateCerLineProgress = null;
    }

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    // Add animation-ready class (hidden states apply only when JS is enabled)
    eventsSection.classList.add('cer-animate-ready');
    const rows = eventsSection.querySelectorAll<HTMLElement>('.cer-row');

    ceremoniesObserver = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const row = entry.target as HTMLElement;
          row.classList.add('is-in-view');
          obs.unobserve(row); // Animate only once
        }
      });
    }, {
      threshold: 0.2,
      rootMargin: '0px 0px -20px 0px',
    });

    rows.forEach((row) => {
      const rect = row.getBoundingClientRect();
      if (rect.top < window.innerHeight * 0.85 && rect.bottom > 0) {
        row.classList.add('is-in-view');
      } else {
        ceremoniesObserver!.observe(row);
      }
    });

    // Gold vertical line smooth draw progress & sliding tracker dot on scroll
    const lineProgress = document.getElementById('cer-line-progress');
    const trackerDot = document.getElementById('cer-tracker-dot');
    const timeline = eventsSection.querySelector<HTMLElement>('.cer-timeline');

    if (lineProgress && timeline) {
      let cerProgressRaf: number | null = null;
      let cachedTimelineTop = 0;
      let cachedTimelineHeight = 1;

      const updateTimelineMetrics = () => {
        const rect = timeline.getBoundingClientRect();
        cachedTimelineTop = (window.scrollY || window.pageYOffset || 0) + rect.top;
        cachedTimelineHeight = rect.height || 1;
      };
      updateTimelineMetrics();
      window.addEventListener('resize', updateTimelineMetrics, { passive: true });

      updateCerLineProgress = () => {
        if (cerProgressRaf) return;
        cerProgressRaf = requestAnimationFrame(() => {
          const scrollY = window.scrollY || window.pageYOffset || 0;
          const vh = window.innerHeight;
          const current = scrollY + vh * 0.7 - cachedTimelineTop;
          const progress = Math.min(1, Math.max(0, current / cachedTimelineHeight));
          lineProgress.style.transform = `scaleY(${progress})`;
          if (trackerDot) {
            trackerDot.style.transform = `translate(-50%, ${progress * (cachedTimelineHeight - 9)}px)`;
          }
          cerProgressRaf = null;
        });
      };

      window.addEventListener('scroll', updateCerLineProgress, { passive: true });
      updateCerLineProgress();
    }
  };

  if (document.readyState === 'loading') {
