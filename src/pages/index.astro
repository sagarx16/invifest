          <svg class="w-5 h-5 text-[#FED467] drop-shadow-[0_0_8px_rgba(254,212,103,0.8)]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2c-.5 2-2 4-2 6a4 4 0 0 0 8 0c0-2-1.5-4-2-6h-4zm-9 14c0 3.3 4 6 9 6s9-2.7 9-6H3z"/>
