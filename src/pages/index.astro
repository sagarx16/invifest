}

.cer-dress-name {
  font-family: 'Montserrat', sans-serif;
  font-size: 10px;
  font-weight: 500;
  color: #3E2D24;
}

/* ========================================================
   SCROLL ANIMATIONS (Progressive Enhancement via html.js)
   ======================================================== */
/* By default without JS, everything is fully visible */
.cer-card,
.cer-node,
.cer-photo-wrap {
  opacity: 1;
  transform: none;
}

/* When JavaScript is active, set initial hidden states ready for scroll-in */
html.js .cer-animate-ready .cer-card {
  opacity: 0;
  transform: translateY(24px);
  transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.2s, opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.2s;
  will-change: transform, opacity;
}

html.js .cer-animate-ready .cer-node {
  opacity: 0;
  transform: scale(0.6);
  transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.35s, opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.35s;
  will-change: transform, opacity;
}

/* Even Rows (01 Haldi, 03 Sangeet, 05 Reception): Text LEFT, Photo RIGHT on desktop
   -> Photo slides in from RIGHT (translateX(80px) -> 0, opacity 0 -> 1, ~0.9s cubic-bezier(0.22, 1, 0.36, 1)) */
html.js .cer-animate-ready .cer-row--even .cer-photo-wrap {
  opacity: 0;
  transform: translateX(80px);
  transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  will-change: transform, opacity;
}

/* Odd Rows (02 Mehendi, 04 Vivah): Photo LEFT, Text RIGHT on desktop
   -> Photo slides in from LEFT (translateX(-80px) -> 0, opacity 0 -> 1, ~0.9s cubic-bezier(0.22, 1, 0.36, 1)) */
html.js .cer-animate-ready .cer-row--odd .cer-photo-wrap {
  opacity: 0;
  transform: translateX(-80px);
  transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  will-change: transform, opacity;
}

/* In-View States: Triggered once when row enters viewport */
html.js .cer-row.is-in-view .cer-card {
  opacity: 1 !important;
  transform: translateY(0) !important;
  will-change: auto !important;
}

html.js .cer-row.is-in-view .cer-node {
  opacity: 1 !important;
  transform: scale(1) !important;
  will-change: auto !important;
}

html.js .cer-row.is-in-view .cer-photo-wrap {
  opacity: 1 !important;
  transform: translateX(0) !important;
  will-change: auto !important;
}

/* ========================================================
   MOBILE RESPONSIVENESS: max-width 768px
   ======================================================== */
@media (max-width: 768px) {
  .cer-timeline {
    padding-left: 0;
  }

  /* Vertical line on left side (~24px from edge) */
  .cer-timeline-track {
    left: 24px;
    transform: translateX(-50%);
  }

  .cer-row {
    flex-direction: column;
    align-items: stretch;
    padding-left: 54px;
    margin-bottom: 56px;
    gap: 1.25rem;
  }

  /* Single column order: Center node at top-left, then Photo, then Text */
  .cer-center {
    position: absolute;
    left: 24px;
    top: 0;
    transform: translateX(-50%);
    width: auto;
    height: auto;
    order: 0 !important;
  }

  .cer-node {
    width: 38px;
    height: 38px;
  }

  .cer-node span {
    font-size: 12px;
  }

  .cer-col-photo {
    width: 100%;
    order: 1 !important;
  }

  .cer-photo-wrap {
    aspect-ratio: 16 / 13.5;
    border-width: 4px;
    border-radius: 16px;
  }

  .cer-col-text {
    width: 100%;
    order: 2 !important;
    text-align: left !important;
  }

  .cer-card {
    padding: 0.95rem 1.05rem;
    border-radius: 16px;
  }

  .cer-label {
    margin-left: 0 !important;
    margin-right: auto !important;
  }

  .cer-title {
    text-align: left !important;
    font-size: 1.08rem;
    margin-bottom: 0.25rem;
  }

  .cer-desc {
    text-align: left !important;
    font-size: 10.5px;
    line-height: 1.5;
    margin-bottom: 0.45rem;
  }

  .cer-divider {
    margin-left: 0 !important;
    margin-right: auto !important;
    margin-bottom: 0.45rem;
  }

  .cer-meta-row {
    justify-content: flex-start !important;
    text-align: left !important;
    font-size: 12.5px;
    gap: 0.5rem;
  }

  .cer-meta-row--date {
    font-size: 1.32rem; /* Significantly larger golden date on mobile */
    line-height: 1.25;
  }

  .cer-icon--calendar {
    width: 23px;
    height: 23px;
  }

  .cer-dress {
    margin-left: 0 !important;
    margin-right: auto !important;
    display: flex;
    width: 100%;
    border-radius: 12px;
    padding: 0.22rem 0.6rem;
  }

  .cer-dress-label {
    margin-right: auto;
  }

  /* Mobile photo animation: slides in from side */
  html.js .cer-animate-ready .cer-row--even .cer-photo-wrap {
    transform: translateX(40px);
  }

  html.js .cer-animate-ready .cer-row--odd .cer-photo-wrap {
    transform: translateX(-40px);
  }

  html.js .cer-row.is-in-view .cer-photo-wrap {
    opacity: 1 !important;
    transform: translateX(0) !important;
  }
}

/* Accessibility: Prefers Reduced Motion */
@media (prefers-reduced-motion: reduce) {
  html.js .cer-animate-ready .cer-card,
  html.js .cer-animate-ready .cer-node,
  html.js .cer-animate-ready .cer-photo-wrap,
  .cer-card,
  .cer-node,
  .cer-photo-wrap,
  .cer-timeline-line-progress {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }
}
</style>

<script>
  // ── GSAP + ScrollTrigger animations ──────────────────────────────
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';
  import { royalAudio } from '../lib/audio';
  import { initRitualsCarousel } from '../scripts/ritualsCarousel';

  gsap.registerPlugin(ScrollTrigger);

  // ── STATE-OF-THE-ART MODERN SMOOTH SCROLLING (LENIS + GSAP TICKER) ──
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isTouchDevice = window.matchMedia('(max-width: 768px)').matches || ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
  let lenis: any = null;

  // On touch/mobile devices, use native GPU 120Hz momentum scrolling. Use Lenis only for desktop mouse wheel.
  if (!prefersReducedMotion && !isTouchDevice) {
    lenis = new Lenis({
      duration: 1.15,
      // Studio Freight / Apple signature exponential ease-out curve for buttery deceleration
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      gestureOrientation: 'vertical',
      smoothWheel: true,
      wheelMultiplier: 1.0,
      autoRaf: false,
    });
    (window as any).lenis = lenis;

    // Connect Lenis to ScrollTrigger
    lenis.on('scroll', ScrollTrigger.update);

    // Hardware V-SYNC locked animation loop (adaptive to 60Hz and 120Hz ProMotion displays)
    let lenisRafId: number | null = null;
    function updateLenis(time: number) {
      if (!document.hidden && lenis) {
        lenis.raf(time);
      }
      lenisRafId = requestAnimationFrame(updateLenis);
    }
    lenisRafId = requestAnimationFrame(updateLenis);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        if (lenisRafId) cancelAnimationFrame(lenisRafId);
        lenisRafId = null;
      } else if (!lenisRafId) {
        lenisRafId = requestAnimationFrame(updateLenis);
      }
    }, { passive: true });

    // Smooth anchor link gliding
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const targetId = anchor.getAttribute('href');
        if (!targetId || targetId === '#' || targetId === '#!') return;
        if (!isScratchUnlocked && targetId !== '#hero' && targetId !== '#save-the-date') return;
        const targetEl = document.querySelector(targetId);
        if (targetEl) {
          e.preventDefault();
          lenis.scrollTo(targetEl, { offset: -10, duration: 1.25 });
        }
      });
    });
  }

  // ── LAZY OBSERVER HELPER FOR BELOW-THE-FOLD MODULES ─────────────
  function initWhenVisible(elementId: string, initFn: () => void, rootMargin = '250px 0px') {
    const el = document.getElementById(elementId);
    if (!el) {
      initFn();
      return;
    }
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries, obs) => {
        if (entries[0].isIntersecting) {
          obs.disconnect();
          initFn();
        }
      }, { rootMargin });
      observer.observe(el);
    } else {
      initFn();
    }
  }

  // ── GRAND OPENING ENVELOPE CINEMATIC & HERO REVEAL ────────────────
  const openingCinematic = document.getElementById('opening-cinematic');
  const openingVideo = document.getElementById('opening-video') as HTMLVideoElement | null;
  const openingVideoAmbient = document.getElementById('opening-video-ambient') as HTMLVideoElement | null;
  const videoCard = document.getElementById('video-card');

  let heroRevealed = false;
  let introDismissed = false;

  function triggerRevealHero() {
    if (heroRevealed) return;
    heroRevealed = true;
    revealHero();
  }

  function dismissIntro() {
    if (introDismissed) return;
    introDismissed = true;

    if (openingVideo) {
      openingVideo.pause();
      try {
        openingVideo.removeAttribute('src');
        openingVideo.load();
      } catch (e) {}
    }
    if (openingVideoAmbient) {
      openingVideoAmbient.pause();
      try {
        openingVideoAmbient.removeAttribute('src');
        openingVideoAmbient.load();
      } catch (e) {}
    }

    if (openingCinematic) {
      openingCinematic.style.transition = 'opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1)';
      openingCinematic.style.opacity = '0';
      openingCinematic.style.transform = 'scale(1.04)';
      openingCinematic.style.pointerEvents = 'none';
      setTimeout(() => {
        openingCinematic.style.display = 'none';
        openingCinematic.remove();
      }, 950);
    }

    // Immediately start playing the wedding song ("Aaj Sajeya") as soon as video closes
    royalAudio.playSong((isPlaying) => {
      updateAudioUI(isPlaying);
    });

    triggerRevealHero();
  }

  // Audio default ON for both landing video and inside wedding music
  let userManuallyMuted = false;
  royalAudio.setManuallyPaused(false);

  const handleUserInteraction = () => {
    if (openingVideo && !introDismissed && !openingVideo.paused) {
      try {
        openingVideo.muted = false;
        openingVideo.volume = 1.0;
      } catch (e) {}
    }
    if (introDismissed && !royalAudio.getIsPlaying() && !userManuallyMuted) {
      royalAudio.playSong((isPlaying) => updateAudioUI(isPlaying));
    }
  };

  ['click', 'touchstart', 'pointerdown', 'keydown'].forEach((evt) => {
    window.addEventListener(evt, handleUserInteraction, { once: true, passive: true });
  });

  let hasStartedVideoPlayback = false;

  function handleEnvelopeTap(e?: Event) {
    if (e) {
      try {
        e.preventDefault();
        e.stopPropagation();
      } catch (_) {}
    }
    if (introDismissed || hasStartedVideoPlayback) return;
    hasStartedVideoPlayback = true;

    // Disconnect click listener so accidental double-taps do not interrupt the video playback
    openingCinematic?.removeEventListener('click', handleEnvelopeTap);

    // Prime the inside wedding audio engine during this user gesture
    royalAudio.prime();

    // Animate out the tap prompt badge
    const tapPrompt = document.getElementById('envelope-tap-prompt');
    if (tapPrompt) {
      tapPrompt.style.transition = 'opacity 0.35s ease, transform 0.35s ease';
      tapPrompt.style.opacity = '0';
      tapPrompt.style.transform = 'translate(-50%, -50%) scale(0.85)';
      setTimeout(() => tapPrompt.remove(), 360);
    }

    if (openingVideo) {
      // Unmute video audio track and set full volume
      openingVideo.muted = false;
      openingVideo.volume = 1.0;
      openingVideo.currentTime = 0;

      const playPromise = openingVideo.play();
      if (playPromise !== undefined) {
        playPromise.then(() => {
          if (openingVideo) {
            openingVideo.muted = false;
            openingVideo.volume = 1.0;
          }
        }).catch(() => {
          // If browser restricted unmuted audio, play muted and immediately unmute
          if (openingVideo) {
            openingVideo.muted = true;
            openingVideo.play().then(() => {
              setTimeout(() => {
                if (openingVideo) {
                  openingVideo.muted = false;
                  openingVideo.volume = 1.0;
                }
              }, 40);
            }).catch(() => {});
          }
        });
      }

      if (openingVideoAmbient) {
        openingVideoAmbient.play().catch(() => {});
      }

      // When the video finishes playing once with its original music -> automatically enter the main website!
      let hasVideoCompleted = false;
      const onVideoFinished = () => {
        if (hasVideoCompleted) return;
        hasVideoCompleted = true;
        setTimeout(() => {
          dismissIntro();
        }, 200);
      };

      openingVideo.addEventListener('ended', onVideoFinished, { once: true });
      openingVideo.addEventListener('timeupdate', () => {
        if (openingVideo.duration && openingVideo.currentTime >= (openingVideo.duration - 0.2)) {
          onVideoFinished();
        }
      });
      // Safety fallback in case browser delays ended event (video duration is ~7.3s)
      setTimeout(onVideoFinished, 8200);
    } else {
      dismissIntro();
    }
  }

  // Single delegated listener on openingCinematic
  openingCinematic?.addEventListener('click', handleEnvelopeTap);

  // Mobile zero-latency touch tap
  let tapTouchStartY = 0;
  openingCinematic?.addEventListener('touchstart', (e: TouchEvent) => {
    if (e.touches && e.touches[0]) tapTouchStartY = e.touches[0].clientY;
  }, { passive: true });

  openingCinematic?.addEventListener('touchend', (e: TouchEvent) => {
    if (e.changedTouches && e.changedTouches[0]) {
      const dy = Math.abs(e.changedTouches[0].clientY - tapTouchStartY);
      if (dy < 15) {
        handleEnvelopeTap(e);
      }
    }
  }, { passive: false });


  function revealHero() {
    if (typeof window !== 'undefined' && window.location.search.includes('skipIntro')) {
      gsap.set(['#hero-tag','#hero-ganesha','#hero-subtitle','#hero-groom','#hero-amp','#hero-bride','#hero-invite','#hero-ctas','#scroll-indicator'], {
        opacity: 1, y: 0
      });
      return;
    }
    const tl = gsap.timeline();
    tl.to('#hero-tag', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' })
      .to('#hero-ganesha', { opacity: 1, y: 0, duration: 0.7, ease: 'power2.out' }, '-=0.4')
      .to('#hero-subtitle', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.3')
      .to('#hero-groom', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, '-=0.3')
      .fromTo('.hero-names-flash', { opacity: 0, scale: 0.85 }, { opacity: 0.85, scale: 1.08, duration: 0.28, yoyo: true, repeat: 1, ease: 'power2.inOut' }, '-=0.4')
      .to('#hero-amp', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.3')
      .to('#hero-bride', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, '-=0.3')
      .to('#hero-invite', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, '-=0.4')
      .to('#hero-ctas', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.3')
      .to('#scroll-indicator', { opacity: 1, duration: 0.6 }, '-=0.1');
  }

  // Set initial states
  gsap.set(['#hero-tag','#hero-ganesha','#hero-subtitle','#hero-groom','#hero-amp','#hero-bride','#hero-invite','#hero-ctas','#scroll-indicator'], {
    y: 30, opacity: 0
  });

  if (typeof window !== 'undefined' && window.location.search.includes('skipIntro')) {
    if (openingCinematic) openingCinematic.style.display = 'none';
    introDismissed = true;
    triggerRevealHero();
  }

  // Hero viewport observer to pause Ken Burns and particle animations when offscreen
  const heroSection = document.getElementById('hero');
  if (heroSection) {
    const heroObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !document.hidden) {
          heroSection.classList.remove('hero-paused');
        } else {
          heroSection.classList.add('hero-paused');
        }
      });
    }, { threshold: 0.05 });
    heroObserver.observe(heroSection);
  }


  // ── SCROLL-TO-TOP BUTTON (PASSIVE THROTTLED FADE & SMOOTH SCROLL) ──
  const scrollTopBtn = document.getElementById('scroll-top-btn');
  if (scrollTopBtn) {
    let isBtnVisible = false;
    let scrollTicking = false;

    const updateScrollTopVisibility = () => {
      const shouldShow = window.scrollY > 350;
      if (shouldShow !== isBtnVisible) {
        isBtnVisible = shouldShow;
        if (shouldShow) {
          scrollTopBtn.classList.add('is-visible');
        } else {
          scrollTopBtn.classList.remove('is-visible');
        }
      }
      scrollTicking = false;
    };

    window.addEventListener('scroll', () => {
      if (!scrollTicking) {
        scrollTicking = true;
        requestAnimationFrame(updateScrollTopVisibility);
      }
    }, { passive: true });

    scrollTopBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (typeof lenis !== 'undefined' && lenis) {
        lenis.scrollTo(0, { immediate: prefersReduced, duration: 1.25 });
      } else {
        window.scrollTo({
          top: 0,
          behavior: prefersReduced ? 'instant' : 'smooth'
        });
      }
    });
  }

  // ── REVEAL SECTIONS on scroll ─────────────────────────────────────
  document.querySelectorAll('.reveal-section').forEach(el => {
    gsap.fromTo(el,
      { opacity: 0, y: 60 },
      { opacity: 1, y: 0, duration: 1, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 80%', toggleActions: 'play none none reverse' }
      }
    );
  });

  const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const isMobilePhone = !isFinePointer || window.matchMedia('(max-width: 768px)').matches;

  // ── MEET THE COUPLE: 3D TILT, GLOW & TAP-TO-SWAP ────────────────

  // Desktop hover: glow + 3D tilt (throttled to rAF with cached rect)
  if (isFinePointer && !isReducedMotion) {
    document.querySelectorAll<HTMLElement>('.couple-card').forEach((el) => {
      const glow = el.querySelector('.couple-glow') as HTMLElement | null;
      let tiltRaf: number | null = null;
      let cachedRect: DOMRect | null = null;

      el.addEventListener('mouseenter', () => {
        cachedRect = el.getBoundingClientRect();
      }, { passive: true });

      el.addEventListener('mousemove', (e: MouseEvent) => {
        if (!cachedRect) cachedRect = el.getBoundingClientRect();
        const rect = cachedRect;
        const normX = (e.clientX - rect.left) / rect.width - 0.5;
        const normY = (e.clientY - rect.top) / rect.height - 0.5;
        
        if (tiltRaf) cancelAnimationFrame(tiltRaf);
        tiltRaf = requestAnimationFrame(() => {
          el.style.transform = `perspective(1000px) rotateX(${normY * -6}deg) rotateY(${normX * 6}deg) translateY(-4px)`;
          if (glow) {
            glow.style.setProperty('--mx', `${(normX + 0.5) * 100}%`);
            glow.style.setProperty('--my', `${(normY + 0.5) * 100}%`);
            glow.style.opacity = '1';
          }
        });
      }, { passive: true });

      el.addEventListener('mouseleave', () => {
        if (tiltRaf) cancelAnimationFrame(tiltRaf);
        cachedRect = null;
        el.style.transform = '';
        if (glow) glow.style.opacity = '0';
      });
    });
  }

  // ── MEET THE COUPLE: INDEPENDENT TAP & HOVER PHOTO TOGGLE ──
  const toggleButtons = document.querySelectorAll<HTMLButtonElement>('[data-couple-toggle]');

  toggleButtons.forEach((btn) => {
    const card = btn.closest<HTMLElement>('.couple-card');
    if (!card) return;

    const hint = btn.querySelector<HTMLElement>('.hint-text');
    let autoRevertTimeout: number | null = null;
    let touchStartX = 0;
    let touchStartY = 0;
    let touchMoved = false;
    let lastTouchTime = 0;

    const setSwappedState = (swapped: boolean, triggeredByTouch = false) => {
      if (swapped) {
        card.classList.add('is-swapped');
        btn.setAttribute('aria-pressed', 'true');
        if (hint) hint.textContent = 'TAP TO GO BACK';
        document.getElementById('couple')?.classList.add('has-tapped-thumb');

        // Requirement 8: Auto-revert to main photo after 6 seconds of no interaction, ONLY on touch devices
        if (triggeredByTouch || isTouchDevice) {
          if (autoRevertTimeout) clearTimeout(autoRevertTimeout);
          autoRevertTimeout = window.setTimeout(() => {
            setSwappedState(false, false);
          }, 6000);
        }
      } else {
        card.classList.remove('is-swapped');
        btn.setAttribute('aria-pressed', 'false');
        if (hint) hint.textContent = 'TAP TO SEE MORE';
        if (autoRevertTimeout) {
          clearTimeout(autoRevertTimeout);
          autoRevertTimeout = null;
        }
      }
    };

    const toggle = (triggeredByTouch = false) => {
      const willBeSwapped = !card.classList.contains('is-swapped');
      setSwappedState(willBeSwapped, triggeredByTouch);
    };

    // Touch events: track displacement to ensure scroll gestures never trigger toggle
    btn.addEventListener('touchstart', (e: TouchEvent) => {
      if (e.touches.length !== 1) return;
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
      touchMoved = false;
    }, { passive: true });

    btn.addEventListener('touchmove', (e: TouchEvent) => {
      if (e.touches.length !== 1) return;
      const dx = Math.abs(e.touches[0].clientX - touchStartX);
      const dy = Math.abs(e.touches[0].clientY - touchStartY);
      if (dx > 8 || dy > 8) {
        touchMoved = true;
      }
    }, { passive: true });

    btn.addEventListener('touchend', (e: TouchEvent) => {
      if (!touchMoved) {
        e.preventDefault(); // Eliminate 300ms touch delay and suppress synthetic click
        lastTouchTime = Date.now();
        toggle(true);
      }
    });

    // Desktop Mouse Click & Keyboard (Enter/Space)
    btn.addEventListener('click', () => {
      // Ignore synthetic click triggered right after touchend
      if (Date.now() - lastTouchTime < 650) return;
      toggle(false);
    });

    // Desktop hover state hint text update (when not locked/swapped)
    if (!isTouchDevice) {
      btn.addEventListener('mouseenter', () => {
        if (!card.classList.contains('is-swapped') && hint) {
          hint.textContent = 'TAP TO GO BACK';
        }
      });
      btn.addEventListener('mouseleave', () => {
        if (!card.classList.contains('is-swapped') && hint) {
          hint.textContent = 'TAP TO SEE MORE';
        }
      });
    }
  });

  // Preload and decode secondary images when #couple section nears viewport
  const preloadCoupleSecondaryImages = () => {
    const imagesToPrefetch = document.querySelectorAll<HTMLImageElement>(
      '#couple .arch-detail-img, #couple .ring-primary-img, #couple .aarsi-primary-img'
    );
    imagesToPrefetch.forEach((img) => {
      if (img.complete) {
        if ('decode' in img) img.decode().catch(() => {});
      } else {
        img.addEventListener('load', () => {
          if ('decode' in img) img.decode().catch(() => {});
        }, { once: true });
      }
    });
  };

  if (typeof IntersectionObserver !== 'undefined') {
    const coupleSectionEl = document.getElementById('couple');
    if (coupleSectionEl) {
      const prefetchObserver = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          preloadCoupleSecondaryImages();
          prefetchObserver.disconnect();
        }
      }, { rootMargin: '300px 0px 300px 0px' });
      prefetchObserver.observe(coupleSectionEl);
    }
  } else {
    preloadCoupleSecondaryImages();
  }

  // ── MEET THE BRIDE & GROOM: CONTINUOUS THREAD ──
  const coupleSection = document.getElementById('couple');
  const groomFloating = document.querySelector('.groom-detail-floating') as HTMLElement | null;
  const brideFloating = document.querySelector('.bride-detail-floating') as HTMLElement | null;
  const threadPath = document.getElementById('couple-thread-path') as SVGPathElement | null;
  const threadSvg = document.getElementById('couple-gold-thread-svg') as SVGSVGElement | null;
  const threadGrad = document.getElementById('coupleThreadGrad') as SVGLinearGradientElement | null;

  if (coupleSection && groomFloating && brideFloating && threadPath && threadSvg) {
    const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let totalLength = 0;
    let hasAnimatedIn = isReduced;

    const computeThreadGeometry = () => {
      const sectionRect = coupleSection.getBoundingClientRect();
      const gRect = groomFloating.getBoundingClientRect();
      const bRect = brideFloating.getBoundingClientRect();

      if (!sectionRect.width || !sectionRect.height) return;

      // Centers relative to section
      const gX = gRect.left + gRect.width / 2 - sectionRect.left;
      const gY = gRect.top + gRect.height / 2 - sectionRect.top;
      const bX = bRect.left + bRect.width / 2 - sectionRect.left;
      const bY = bRect.top + bRect.height / 2 - sectionRect.top;

      // Dynamic gold -> pink linear gradient coordinates
      if (threadGrad) {
        threadGrad.setAttribute('x1', `${gX}`);
        threadGrad.setAttribute('y1', `${gY}`);
        threadGrad.setAttribute('x2', `${bX}`);
        threadGrad.setAttribute('y2', `${bY}`);
      }

      // Check layout: desktop horizontal vs mobile stacked
      const isHorizontal = Math.abs(gX - bX) > 100 && (bX > gX);

      let d = '';
      if (isHorizontal) {
        const midX = (gX + bX) / 2;
        const sag = Math.min(45, Math.abs(bX - gX) * 0.08);
        const ctrlY = Math.max(gY, bY) + sag;
        d = `M ${gX.toFixed(1)} ${gY.toFixed(1)} Q ${midX.toFixed(1)} ${ctrlY.toFixed(1)} ${bX.toFixed(1)} ${bY.toFixed(1)}`;
      } else {
        const midY = (gY + bY) / 2;
        d = `M ${gX.toFixed(1)} ${gY.toFixed(1)} C ${(gX + 35).toFixed(1)} ${(gY + (midY - gY) * 0.5).toFixed(1)}, ${(bX - 35).toFixed(1)} ${(bY - (bY - midY) * 0.5).toFixed(1)}, ${bX.toFixed(1)} ${bY.toFixed(1)}`;
      }

      threadPath.setAttribute('d', d);
      totalLength = threadPath.getTotalLength() || 500;
      threadPath.style.strokeDasharray = `${totalLength}`;

      if (hasAnimatedIn || isReduced) {
        threadPath.style.strokeDashoffset = '0';
        threadPath.style.opacity = '1';
        coupleSection.classList.remove('couple-unconnected');
      }
    };

    if (!isReduced) {
      coupleSection.classList.add('couple-unconnected');
      computeThreadGeometry();

      const coupleObserver = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !hasAnimatedIn) {
            hasAnimatedIn = true;
            obs.unobserve(coupleSection);
            coupleSection.classList.remove('couple-unconnected');

            // Draw thread ~1.4s ease
            threadPath.style.transition = 'stroke-dashoffset 1.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s ease';
            threadPath.style.opacity = '1';
            threadPath.style.strokeDashoffset = '0';
          }
        });
      }, { threshold: 0.2 });

      coupleObserver.observe(coupleSection);
    } else {
      computeThreadGeometry();
    }

    // ResizeObserver debounced with rAF for responsive updates
    let threadRaf: number | null = null;
    const scheduleUpdate = () => {
      if (threadRaf) cancelAnimationFrame(threadRaf);
      threadRaf = requestAnimationFrame(computeThreadGeometry);
    };

    const ro = new ResizeObserver(scheduleUpdate);
    ro.observe(coupleSection);
    window.addEventListener('resize', scheduleUpdate, { passive: true });
  }

  // Parallax on mouse move - throttled to rAF & disabled on mobile touch devices
  if (isFinePointer && !isTouchDevice) {
    const parallaxLayers = Array.from(document.querySelectorAll<HTMLElement>('.parallax-layer'));
    const mandala = document.getElementById('hero-mandala');
    let pRaf: number | null = null;

    if (parallaxLayers.length > 0 || mandala) {
      document.addEventListener('mousemove', (e) => {
        if (pRaf) return;
        pRaf = requestAnimationFrame(() => {
          const xPct = (e.clientX / window.innerWidth - 0.5) * 2;
          const yPct = (e.clientY / window.innerHeight - 0.5) * 2;
          parallaxLayers.forEach(el => {
            const depth = parseFloat(el.dataset.depth || '0.1');
            el.style.transform = `translate3d(${(xPct * 25 * depth).toFixed(1)}px, ${(yPct * 25 * depth).toFixed(1)}px, 0)`;
          });
          if (mandala) {
            mandala.style.transform = `translate3d(${(xPct * 12).toFixed(1)}px, ${(yPct * 12).toFixed(1)}px, 0)`;
          }
          pRaf = null;
        });
      }, { passive: true });
    }
  }

  // ── REAL-TIME WEDDING COUNTDOWN ────────────────────────────────────
  let countdownInterval: any = null;
  let prevSecsVal = '';
  let cachedTargetWeddingTime = 0;

  function getTargetWeddingTime(): number {
    if (cachedTargetWeddingTime) return cachedTargetWeddingTime;
    const card = document.getElementById('locked-countdown-card');
    const targetStr = card?.getAttribute('data-target') || '2026-12-11T00:00:00+05:30';
    const parsed = new Date(targetStr).getTime();
    cachedTargetWeddingTime = isNaN(parsed) ? new Date('2026-12-11T00:00:00+05:30').getTime() : parsed;
    return cachedTargetWeddingTime;
  }

  function updateCountdown() {
    const target = getTargetWeddingTime();
    const now = Date.now();
    const diff = target - now;

    const timerGrid = document.getElementById('cd-timer-grid');
    const expiredMsg = document.getElementById('cd-expired-msg');
    const daysEl = document.getElementById('cd-days-val');
    const hoursEl = document.getElementById('cd-hours-val');
    const minsEl = document.getElementById('cd-minutes-val');
    const secsEl = document.getElementById('cd-seconds-val');

    if (diff <= 0) {
      if (timerGrid) timerGrid.style.display = 'none';
      if (expiredMsg) {
        expiredMsg.classList.remove('hidden');
        expiredMsg.style.display = 'block';
      }
      return;
    }

    if (timerGrid && timerGrid.style.display === 'none') {
      timerGrid.style.display = '';
    }
    if (expiredMsg && expiredMsg.style.display !== 'none') {
      expiredMsg.classList.add('hidden');
      expiredMsg.style.display = 'none';
    }

    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);

    const daysStr = String(d).padStart(2, '0');
    const hoursStr = String(h).padStart(2, '0');
    const minsStr = String(m).padStart(2, '0');
    const secsStr = String(s).padStart(2, '0');

    if (daysEl && daysEl.textContent !== daysStr) daysEl.textContent = daysStr;
    if (hoursEl && hoursEl.textContent !== hoursStr) hoursEl.textContent = hoursStr;
    if (minsEl && minsEl.textContent !== minsStr) minsEl.textContent = minsStr;
    if (secsEl && secsEl.textContent !== secsStr) {
      secsEl.textContent = secsStr;
      if (prevSecsVal !== '') {
        secsEl.classList.remove('second-tick');
        requestAnimationFrame(() => {
          secsEl?.classList.add('second-tick');
        });
      }
      prevSecsVal = secsStr;
    }
  }

  function initCountdown() {
    if (countdownInterval) clearInterval(countdownInterval);
    updateCountdown();
    countdownInterval = setInterval(updateCountdown, 1000);
  }

  // Pause countdown when tab hidden to save battery & CPU, resume immediately on focus
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      if (countdownInterval) {
        clearInterval(countdownInterval);
        countdownInterval = null;
      }
    } else {
      updateCountdown();
      if (!countdownInterval) {
        countdownInterval = setInterval(updateCountdown, 1000);
      }
    }
  });

  // Clear interval before Astro page swap, and re-init on page load
  document.addEventListener('astro:before-swap', () => {
    if (countdownInterval) {
      clearInterval(countdownInterval);
      countdownInterval = null;
    }
  });

  initWhenVisible('save-the-date', initCountdown);
  document.addEventListener('astro:page-load', () => initWhenVisible('save-the-date', initCountdown));

  // ── SAVE THE DATE INTERACTIVE SCRATCH CARDS & SCROLL GATE ─────────
  const STD_STORAGE_KEY = 'mukesh_puja_std_unlocked_v3';
  let isScratchUnlocked = false;

  // Always reset on page load / refresh so user gets scratch card every time!
  if (typeof window !== 'undefined') {
    try {
      localStorage.removeItem(STD_STORAGE_KEY);
      localStorage.removeItem('mukesh_puja_std_unlocked_v1');
      localStorage.removeItem('mukesh_puja_std_unlocked_v2');
      sessionStorage.removeItem(STD_STORAGE_KEY);
      sessionStorage.removeItem('mukesh_puja_std_unlocked_v1');
      sessionStorage.removeItem('mukesh_puja_std_unlocked_v2');
    } catch (e) {}

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('unlocked') === '1') {
      isScratchUnlocked = true;
    } else {
      isScratchUnlocked = false;
    }
  }

  const lockedContentWrapper = document.getElementById('locked-post-save-the-date');
  const lockedCountdownCard = document.getElementById('locked-countdown-card');
  const scratchProgressText = document.getElementById('scratch-progress-text');
  const scratchUnlockedContinue = document.getElementById('scratch-unlocked-continue');
  const scratchContinueBtn = document.getElementById('scratch-continue-btn');
  const scratchCardsContainer = document.getElementById('scratch-cards-container');
  const scratchLockToast = document.getElementById('scratch-lock-toast');

  let lockToastTimer: any = null;
  let isShakingCards = false;

  function triggerLockedFeedback() {
    if (isScratchUnlocked) return;
    if (scratchCardsContainer && !isShakingCards) {
      isShakingCards = true;
      scratchCardsContainer.classList.add('shake-anim');
      setTimeout(() => {
        scratchCardsContainer.classList.remove('shake-anim');
        isShakingCards = false;
      }, 500);
    }
    if (scratchLockToast) {
      scratchLockToast.classList.remove('opacity-0', 'translate-y-4');
      scratchLockToast.classList.add('opacity-100', 'translate-y-0');
      clearTimeout(lockToastTimer);
      lockToastTimer = setTimeout(() => {
        scratchLockToast.classList.remove('opacity-100', 'translate-y-0');
        scratchLockToast.classList.add('opacity-0', 'translate-y-4');
      }, 2400);
    }
  }

  let cachedStdLimit = 0;
  function updateSaveTheDateLimit() {
    if (isScratchUnlocked) {
      cachedStdLimit = Infinity;
      return;
    }
    const container = document.getElementById('scratch-cards-container');
    if (!container) {
      cachedStdLimit = Infinity;
      return;
    }
    const rect = container.getBoundingClientRect();
    const scrollY = window.scrollY || window.pageYOffset || 0;
    // Clamps exactly where the 3 cards and progress indicator are vertically centered
    cachedStdLimit = Math.max(0, scrollY + rect.top + rect.height / 2 - window.innerHeight / 2 + 25);
  }

  function getSaveTheDateLimit(): number {
    if (isScratchUnlocked) return Infinity;
    if (!cachedStdLimit) updateSaveTheDateLimit();
    return cachedStdLimit;
  }
  updateSaveTheDateLimit();
  window.addEventListener('resize', updateSaveTheDateLimit, { passive: true });

  // Locked feedback: if user reaches the bottom of the locked section and tries to scroll down further
  let lastLockedFeedbackTime = 0;
  const triggerLockedCooldown = () => {
    if (isScratchUnlocked) return;
    const now = Date.now();
    if (now - lastLockedFeedbackTime < 900) return;
    lastLockedFeedbackTime = now;
    triggerLockedFeedback();
  };

  const handleWheelLocked = (e: WheelEvent) => {
    if (!isScratchUnlocked && e.deltaY > 5) {
      const scrollY = window.scrollY || window.pageYOffset || 0;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollY >= maxScroll - 25) {
        triggerLockedCooldown();
      }
    }
  };

  let touchStartY = 0;
  const handleTouchStartLocked = (e: TouchEvent) => {
    if (e.touches && e.touches[0]) touchStartY = e.touches[0].clientY;
  };

  const handleTouchMoveLocked = (e: TouchEvent) => {
    if (!isScratchUnlocked && e.touches && e.touches[0]) {
      const dy = touchStartY - e.touches[0].clientY;
      if (dy > 25) {
        const scrollY = window.scrollY || window.pageYOffset || 0;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        if (scrollY >= maxScroll - 25) {
          triggerLockedCooldown();
        }
      }
    }
  };

  const handleKeyDownLocked = (e: KeyboardEvent) => {
    if (!isScratchUnlocked) {
      const isDownKey = ['PageDown', 'End', 'ArrowDown', ' '].includes(e.key);
      if (isDownKey && !(e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement)) {
        const scrollY = window.scrollY || window.pageYOffset || 0;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        if (scrollY >= maxScroll - 25) {
          e.preventDefault();
          triggerLockedCooldown();
        }
      }
    }
  };

  function removeLockEventListeners() {
    window.removeEventListener('wheel', handleWheelLocked);
    window.removeEventListener('touchstart', handleTouchStartLocked);
    window.removeEventListener('touchmove', handleTouchMoveLocked);
    window.removeEventListener('keydown', handleKeyDownLocked);
  }

  if (!isScratchUnlocked) {
    window.addEventListener('wheel', handleWheelLocked, { passive: true });
    window.addEventListener('touchstart', handleTouchStartLocked, { passive: true });
    window.addEventListener('touchmove', handleTouchMoveLocked, { passive: true });
    window.addEventListener('keydown', handleKeyDownLocked);
  }

  // Intercept anchor clicks to locked sections
  document.addEventListener('click', (e) => {
    const anchor = (e.target as HTMLElement)?.closest('a');
    if (anchor && !isScratchUnlocked) {
      const href = anchor.getAttribute('href');
      if (href && href.startsWith('#') && href !== '#' && href !== '#hero' && href !== '#save-the-date') {
        e.preventDefault();
        e.stopPropagation();
        const std = document.getElementById('save-the-date');
        if (std) {
          if (lenis) lenis.scrollTo(std, { duration: 0.8 });
          else std.scrollIntoView({ behavior: 'smooth' });
        }
        triggerLockedFeedback();
      }
    }
  }, true);

  // Prevent hash routing to locked sections
  function enforceHashGuard() {
    if (!isScratchUnlocked && window.location.hash && window.location.hash !== '#hero' && window.location.hash !== '#save-the-date') {
      window.location.hash = '#save-the-date';
      triggerLockedFeedback();
    }
  }
  window.addEventListener('hashchange', enforceHashGuard);
  enforceHashGuard();

  function updateProgress(count: number) {
    const diamonds = document.querySelectorAll('#scratch-progress-diamonds .scratch-diamond');
    diamonds.forEach((d, idx) => {
      if (idx < count) {
        d.className = 'scratch-diamond text-[11px] transition-colors duration-300 text-[#B8860B] drop-shadow-[0_0_6px_rgba(212,175,55,0.7)]';
      } else {
        d.className = 'scratch-diamond text-[11px] transition-colors duration-300 text-stone-300';
      }
    });
    if (scratchProgressText) {
      if (count >= 3) {
        scratchProgressText.textContent = '3 / 3 REVEALED · CELEBRATION UNLOCKED';
      } else {
        scratchProgressText.textContent = `${count} / 3 REVEALED`;
      }
    }
  }

  // Draw procedural embossed antique gold foil on canvas
  function drawAntiqueGoldFoil(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D, w: number, h: number) {
    ctx.save();
    // 1. Brushed antique-gold metallic gradient at 135deg
    const grad = ctx.createLinearGradient(0, 0, w, h);
    grad.addColorStop(0, '#B8902F');
    grad.addColorStop(0.32, '#F4E3B5');
    grad.addColorStop(0.68, '#D4AF37');
    grad.addColorStop(1, '#A87B22');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, w, h);

    // 2. Fine brushed metal micro-strokes
    for (let i = 0; i < 46; i++) {
      const y = (h / 46) * i + Math.sin(i) * 2;
      ctx.strokeStyle = i % 2 === 0 ? 'rgba(255, 255, 255, 0.08)' : 'rgba(90, 50, 10, 0.06)';
      ctx.lineWidth = 0.8;
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(w, y + (Math.sin(i * 1.5) * 3));
      ctx.stroke();
    }

    // 3. Fine glitter sparkle noise
    for (let i = 0; i < 85; i++) {
      const gx = Math.random() * w;
      const gy = Math.random() * h;
      const gr = Math.random() * 1.1 + 0.3;
      ctx.fillStyle = i % 3 === 0
        ? 'rgba(255, 255, 255, 0.5)'
        : (i % 3 === 1 ? 'rgba(255, 240, 190, 0.38)' : 'rgba(130, 85, 20, 0.28)');
      ctx.beginPath();
      ctx.arc(gx, gy, gr, 0, Math.PI * 2);
      ctx.fill();
    }

    // Emboss relief helper (stamped metallic coin effect)
    const drawEmboss = (drawFn: () => void, lineWidth = 1) => {
      // Shadow (shifted +0.8, +0.8)
      ctx.save();
      ctx.translate(0.8, 0.8);
      ctx.strokeStyle = 'rgba(95, 55, 10, 0.48)';
      ctx.fillStyle = 'rgba(95, 55, 10, 0.35)';
      ctx.lineWidth = lineWidth;
      drawFn();
      ctx.restore();

      // Highlight (shifted -0.8, -0.8)
      ctx.save();
      ctx.translate(-0.8, -0.8);
      ctx.strokeStyle = 'rgba(255, 250, 225, 0.65)';
      ctx.fillStyle = 'rgba(255, 250, 225, 0.45)';
      ctx.lineWidth = lineWidth;
      drawFn();
      ctx.restore();
    };

    // 4. Thin double border in relief
    drawEmboss(() => {
      ctx.strokeRect(5, 5, w - 10, h - 10);
    }, 1.2);
    drawEmboss(() => {
      ctx.strokeRect(9, 9, w - 18, h - 18);
    }, 0.8);

    // 5. Top arch lotus motif in relief
    const lx = w / 2;
    const ly = 22;
    drawEmboss(() => {
      ctx.beginPath();
      // Center petal
      ctx.moveTo(lx, ly - 8);
      ctx.quadraticCurveTo(lx + 4, ly, lx, ly + 6);
      ctx.quadraticCurveTo(lx - 4, ly, lx, ly - 8);
      // Left petal
      ctx.moveTo(lx, ly + 5);
      ctx.quadraticCurveTo(lx - 7, ly - 2, lx - 8, ly - 6);
      ctx.quadraticCurveTo(lx - 4, ly - 1, lx, ly + 5);
      // Right petal
      ctx.moveTo(lx, ly + 5);
      ctx.quadraticCurveTo(lx + 7, ly - 2, lx + 8, ly - 6);
      ctx.quadraticCurveTo(lx + 4, ly - 1, lx, ly + 5);
      ctx.stroke();
    }, 1);

    // 6. Embossed mandala in center
    const cx = w / 2;
    const cy = h * 0.52;

    // Concentric relief rings
    [38, 26, 15, 6].forEach((r) => {
      drawEmboss(() => {
        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, Math.PI * 2);
        ctx.stroke();
      }, 0.9);
    });

    // Dotted ring at r = 20.5
    drawEmboss(() => {
      ctx.save();
      ctx.setLineDash([2, 3]);
      ctx.beginPath();
      ctx.arc(cx, cy, 20.5, 0, Math.PI * 2);
      ctx.stroke();
      ctx.restore();
    }, 0.9);

    // Radiating 12 petals rosette
    drawEmboss(() => {
      for (let a = 0; a < 12; a++) {
        const angle = (a * Math.PI) / 6;
        const px1 = cx + Math.cos(angle) * 15;
        const py1 = cy + Math.sin(angle) * 15;
        const px2 = cx + Math.cos(angle) * 26;
        const py2 = cy + Math.sin(angle) * 26;
        ctx.beginPath();
        ctx.moveTo(px1, py1);
        ctx.lineTo(px2, py2);
        ctx.stroke();
      }
    }, 0.8);

    // 7. Fine paisley / floral vines along left and right edges
    drawEmboss(() => {
      // Left edge vine
      ctx.beginPath();
      ctx.moveTo(14, h * 0.3);
      ctx.bezierCurveTo(10, h * 0.42, 18, h * 0.58, 14, h * 0.72);
      ctx.stroke();
      // Right edge vine
      ctx.beginPath();
      ctx.moveTo(w - 14, h * 0.3);
      ctx.bezierCurveTo(w - 10, h * 0.42, w - 18, h * 0.58, w - 14, h * 0.72);
      ctx.stroke();
      // Delicate leaf florets
      [0.38, 0.5, 0.62].forEach((ratio) => {
        ctx.beginPath();
        ctx.arc(14, h * ratio, 2.5, 0, Math.PI * 2);
        ctx.arc(w - 14, h * ratio, 2.5, 0, Math.PI * 2);
        ctx.stroke();
      });
    }, 0.8);

    // 8. Tiny engraved sparkle icon at center of mandala (shadow & highlight)
    drawEmboss(() => {
      ctx.beginPath();
      ctx.moveTo(cx, cy - 4.5);
      ctx.lineTo(cx, cy + 4.5);
      ctx.moveTo(cx - 4.5, cy);
      ctx.lineTo(cx + 4.5, cy);
      ctx.stroke();
    }, 1.2);

    ctx.restore();
  }

  function spawnGoldDust(x: number, y: number, container: HTMLElement) {
    for (let i = 0; i < 3; i++) {
      const p = document.createElement('span');
      p.className = 'gold-dust-particle';
      const angle = Math.random() * Math.PI * 2;
      const dist = Math.random() * 24 + 8;
      p.style.left = `${x}px`;
      p.style.top = `${y}px`;
      p.style.setProperty('--dx', `${Math.cos(angle) * dist}px`);
      p.style.setProperty('--dy', `${Math.sin(angle) * dist}px`);
      container.appendChild(p);
      setTimeout(() => p.remove(), 450);
    }
  }

  function initScratchCards() {
    const scratchCanvases = document.querySelectorAll<HTMLCanvasElement>('.scratch-canvas');
    const revealedCards = new Set<string>();

    if (isScratchUnlocked) {
      if (lockedContentWrapper) lockedContentWrapper.classList.remove('is-locked');
      if (lockedCountdownCard) lockedCountdownCard.classList.remove('is-locked');
      if (scratchUnlockedContinue) scratchUnlockedContinue.classList.remove('is-locked');
      window.dispatchEvent(new Event('resize'));
      updateProgress(3);
      scratchCanvases.forEach((c) => {
        c.style.display = 'none';
        const card = c.closest('.scratch-card') as HTMLElement;
        if (card) {
          card.classList.remove('card-pulse-glow');
          const shimmer = card.querySelector('.scratch-foil-shimmer') as HTMLElement;
          if (shimmer) shimmer.style.display = 'none';
          const hint = card.querySelector('.card-center-sparkle') as HTMLElement;
          if (hint) hint.remove();
        }
      });
      document.querySelectorAll('.card-foil-placeholder').forEach(el => el.remove());
      scratchContinueBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        const nextSection = document.getElementById('couple');
        if (nextSection) {
          if (lenis) lenis.scrollTo(nextSection, { duration: 1.4 });
          else nextSection.scrollIntoView({ behavior: 'smooth' });
        }
      });
      return;
    }

    updateProgress(0);

    scratchCanvases.forEach((canvas, index) => {
      const card = canvas.closest('.scratch-card') as HTMLElement;
      const cardId = card?.dataset.card || `card-${index}`;
      const shimmerEl = card?.querySelector('.scratch-foil-shimmer') as HTMLElement | null;
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return;

      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = rect.width || canvas.width || 150;
      const h = rect.height || canvas.height || 225;

      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.scale(dpr, dpr);

      // Render antique gold embossed foil before removing placeholders
      drawAntiqueGoldFoil(canvas, ctx, w, h);

      let isScratching = false;
      let isRevealed = false;
      let hasStartedScratching = false;
      let lastX: number | null = null;
      let lastY: number | null = null;
      let lastSampleTime = 0;

      function scratchAt(clientX: number, clientY: number) {
        if (isRevealed || !ctx) return;
        hasStartedScratching = true;

        // Hide hint sparkle immediately upon scratching
        const hint = card?.querySelector('.card-center-sparkle') as HTMLElement | null;
        if (hint) {
          hint.style.transition = 'opacity 0.2s ease';
          hint.style.opacity = '0';
          setTimeout(() => hint.remove(), 220);
        }

        const cRect = canvas.getBoundingClientRect();
        const x = clientX - cRect.left;
        const y = clientY - cRect.top;

        // Big brush: ~44px desktop, ~40px mobile with soft round edges
        const isMobile = window.innerWidth < 640;
        const brushRadius = isMobile ? 40 : 44;

        ctx.globalCompositeOperation = 'destination-out';
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.lineWidth = brushRadius * 2;

        ctx.beginPath();
        if (lastX !== null && lastY !== null) {
          ctx.moveTo(lastX, lastY);
          ctx.lineTo(x, y);
          ctx.stroke();
        } else {
          ctx.arc(x, y, brushRadius, 0, Math.PI * 2);
          ctx.fill();
        }

        lastX = x;
        lastY = y;

        if (card) spawnGoldDust(x, y, card);

        // Throttled pixel checking (~100ms)
        const now = performance.now();
        if (now - lastSampleTime > 100) {
          lastSampleTime = now;
          checkCompletion();
        }
      }

      function checkCompletion() {
        if (isRevealed || !ctx) return;
        try {
          const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
          const data = imgData.data;
          let cleared = 0;
          let total = 0;
          // Grid sampling (sample alpha channel every 40 bytes)
          for (let i = 3; i < data.length; i += 40) {
            total++;
            if (data[i] === 0) cleared++;
          }
          const ratio = cleared / total;
          // Reveal threshold: 25-30% cleared (0.26)
          if (ratio >= 0.26) {
            revealCard();
          }
        } catch (e) {}
      }

      async function revealCard() {
        if (isRevealed) return;
        isRevealed = true;
        canvas.style.pointerEvents = 'none';
        if (card) {
          card.classList.remove('card-pulse-glow');
          const hint = card.querySelector('.card-center-sparkle') as HTMLElement | null;
          if (hint) hint.remove();
        }

        // Smooth fade out (~0.5s) for canvas and shimmer overlay
        gsap.to([canvas, shimmerEl], {
          opacity: 0,
          duration: 0.5,
          ease: 'power2.out',
          onComplete: () => {
            canvas.style.display = 'none';
            if (shimmerEl) shimmerEl.style.display = 'none';
          }
        });

        // Mobile haptic feedback on card reveal
        try {
          if ('vibrate' in navigator) navigator.vibrate(15);
        } catch (e) {}

        // 1x gold sparkle burst (8 particles desktop, 3 particles mobile, transform+opacity, 0.8s)
        const isMobileScreen = typeof window !== 'undefined' && window.innerWidth <= 768;
        const sparkleCount = isMobileScreen ? 3 : 8;
        if (card) {
          for (let p = 0; p < sparkleCount; p++) {
            const sparkle = document.createElement('span');
            sparkle.className = 'scratch-sparkle-particle';
            const angle = (p / sparkleCount) * Math.PI * 2;
            const dist = 28 + Math.random() * 26;
            sparkle.style.setProperty('--tx', `${Math.cos(angle) * dist}px`);
            sparkle.style.setProperty('--ty', `${Math.sin(angle) * dist}px`);
            sparkle.style.left = '50%';
            sparkle.style.top = '50%';
            card.appendChild(sparkle);
            setTimeout(() => sparkle.remove(), 850);
          }
        }

        // Small gold sparkle burst
        try {
          const confetti = (await import('canvas-confetti')).default;
          const cRect = canvas.getBoundingClientRect();
          confetti({
            particleCount: isMobileScreen ? 10 : 26,
            spread: 45,
            origin: {
              x: (cRect.left + cRect.width / 2) / window.innerWidth,
              y: (cRect.top + cRect.height / 2) / window.innerHeight
            },
            colors: ['#D4AF37', '#B8860B', '#FFFDF8']
          });
        } catch (e) {}

        revealedCards.add(cardId);
        updateProgress(revealedCards.size);

        if (revealedCards.size >= 3) {
          onAllCardsRevealed();
        }
      }

      // Pointer event handlers with pointer capture
      canvas.addEventListener('pointerdown', (e) => {
        isScratching = true;
        lastX = null;
        lastY = null;
        try { canvas.setPointerCapture(e.pointerId); } catch (err) {}
        scratchAt(e.clientX, e.clientY);
      });

      let scratchMoveRaf: number | null = null;
      let lastMoveX = 0, lastMoveY = 0;

      canvas.addEventListener('pointermove', (e) => {
        if (!isScratching) return;
        lastMoveX = e.clientX;
        lastMoveY = e.clientY;
        if (!scratchMoveRaf) {
          scratchMoveRaf = requestAnimationFrame(() => {
            if (isScratching) {
              scratchAt(lastMoveX, lastMoveY);
            }
            scratchMoveRaf = null;
          });
        }
      });

      const stopScratching = (e: PointerEvent) => {
        if (isScratching) {
          isScratching = false;
          lastX = null;
          lastY = null;
          try { canvas.releasePointerCapture(e.pointerId); } catch (err) {}
          checkCompletion();
        }
      };

      canvas.addEventListener('pointerup', stopScratching);
      canvas.addEventListener('pointercancel', stopScratching);

      // Prevent touch scrolling while scratching on mobile
      canvas.addEventListener('touchstart', (e) => {
        e.preventDefault();
      }, { passive: false });
      canvas.addEventListener('touchmove', (e) => {
        e.preventDefault();
      }, { passive: false });

      // Keyboard accessibility (Space / Enter triggers progressive scratch)
      if (card) {
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            e.stopPropagation();
            if (isRevealed || !ctx) return;

            const hint = card?.querySelector('.card-center-sparkle') as HTMLElement | null;
            if (hint) hint.remove();

            // Clear circular spots progressively across canvas
            ctx.globalCompositeOperation = 'destination-out';
            const spots = [
              { x: w * 0.35, y: h * 0.35 },
              { x: w * 0.65, y: h * 0.35 },
              { x: w * 0.5, y: h * 0.65 },
              { x: w * 0.5, y: h * 0.5 },
            ];
            spots.forEach(pt => {
              ctx.beginPath();
              ctx.arc(pt.x, pt.y, 44, 0, Math.PI * 2);
              ctx.fill();
            });
            checkCompletion();
          }
        });
      }

      // Handle window resize before card is scratched
      window.addEventListener('resize', () => {
        if (!isRevealed && !hasStartedScratching) {
          const r = canvas.getBoundingClientRect();
          const d = window.devicePixelRatio || 1;
          const rw = r.width || canvas.width;
          const rh = r.height || canvas.height;
          canvas.width = rw * d;
          canvas.height = rh * d;
          ctx.scale(d, d);
          drawAntiqueGoldFoil(canvas, ctx, rw, rh);
        }
      });
    });

    // Remove foil placeholder fallbacks now that canvases are rendered
    document.querySelectorAll('.card-foil-placeholder').forEach((el) => el.remove());

    async function onAllCardsRevealed() {
      isScratchUnlocked = true;
      removeLockEventListeners();
