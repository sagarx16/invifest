        <circle cx="0" cy="0" r="80" stroke-width="0.8" />
        <circle cx="0" cy="0" r="50" stroke-width="0.6" stroke-dasharray="2 2" />
        <path d="M 0,0 L 70,70 M 0,0 L 80,30 M 0,0 L 30,80" stroke-width="0.5" />
