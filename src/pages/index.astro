                    <!-- English Title in Playfair Display with Last Word in Gold on Active -->
                    <h3 class="font-['Playfair_Display'] font-bold text-xl sm:text-2xl md:text-[25px] text-[#FFF9F0] tracking-wide leading-tight drop-shadow-md ritual-card-title">
                      {hasMultipleWords ? (
                        <>
                          <span>{firstPart} </span>
                          <span class="ritual-title-gold text-[#DFB756]">{lastWord}</span>
                        </>
                      ) : (
                        <span>{slide.title}</span>
                      )}
                    </h3>

                    <!-- Gold Flourish -->
                    <div class="flex items-center gap-1.5 my-1.5 text-[#DFB756]/80 text-[9px] sm:text-[10px]">
                      <span class="w-5 h-[1px] bg-gradient-to-r from-transparent to-[#DFB756]"></span>
                      <span>✦</span>
                      <span class="w-5 h-[1px] bg-gradient-to-l from-transparent to-[#DFB756]"></span>
                    </div>

                    <!-- Italic Tagline in Champagne -->
                    <p class="font-['Playfair_Display'] italic text-xs sm:text-sm text-[#F7E7CE] font-normal leading-snug mb-1.5">
                      {slide.tagline}
                    </p>

                    <!-- Thin Gold Divider -->
                    <div class="w-full h-[1px] bg-gradient-to-r from-[#D4AF37]/60 via-[#F3E5AB]/40 to-transparent my-1 sm:my-1.5"></div>

                    <!-- Paragraph in Soft Ivory (High Contrast >= 4.5:1) with Mobile Read More Support -->
                    <div class="ritual-desc-container w-full">
                      <p class="ritual-desc font-['Montserrat'] font-light text-[12px] sm:text-[13px] md:text-[13.5px] text-[#FFF5EB]/95 leading-[1.6] drop-shadow-sm">
                        {slide.text}
