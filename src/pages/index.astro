  // ── AUDIO CONTROLS (ROYAL AUDIO ENGINE & SYNCED MUSIC WIDGET) ─────
  const musicWidget = document.getElementById('music-widget');
  const musicCircleBtn = document.getElementById('music-circle-btn');
  const widgetSongStatus = document.getElementById('widget-song-status');
  const widgetBars = document.getElementById('widget-bars');

  function updateAudioUI(isPlaying: boolean) {
    // 1. Music Pill synchronization
    if (musicWidget) {
      if (isPlaying) {
        musicWidget.classList.remove('is-paused', 'music-widget-paused');
        musicWidget.classList.add('is-playing');
        musicWidget.setAttribute('aria-pressed', 'true');
        musicWidget.setAttribute('aria-label', 'Pause wedding music Aaj Sajeya');
        musicWidget.style.borderColor = 'rgba(212,175,55,0.6)';
        musicWidget.style.opacity = '1';
      } else {
        musicWidget.classList.add('is-paused', 'music-widget-paused');
        musicWidget.classList.remove('is-playing');
        musicWidget.setAttribute('aria-pressed', 'false');
        musicWidget.setAttribute('aria-label', 'Play wedding music Aaj Sajeya');
        musicWidget.style.borderColor = 'rgba(212,175,55,0.25)';
        musicWidget.style.opacity = '0.85';
      }
    }

    if (widgetSongStatus) {
      widgetSongStatus.textContent = isPlaying ? 'Click to Pause' : 'Click to Play';
    }

    // 2. Circle Button synchronization & floating notes toggle
    if (musicCircleBtn) {
      if (isPlaying) {
        musicCircleBtn.classList.remove('is-paused');
        musicCircleBtn.classList.add('is-playing', 'music-playing');
        musicCircleBtn.setAttribute('aria-pressed', 'true');
        musicCircleBtn.setAttribute('aria-label', 'Pause music');
      } else {
        musicCircleBtn.classList.add('is-paused');
        musicCircleBtn.classList.remove('is-playing', 'music-playing');
        musicCircleBtn.setAttribute('aria-pressed', 'false');
        musicCircleBtn.setAttribute('aria-label', 'Play music');
      }
    }

    // 3. Equalizer bars synchronization
    if (widgetBars) {
      widgetBars.style.opacity = isPlaying ? '1' : '0.4';
    }
  }

  // Subscribe to audio engine state updates so any play/pause source syncs UI immediately
  royalAudio.subscribe((isPlaying) => {
    updateAudioUI(isPlaying);
  });

  const handleToggleMusic = (e?: Event) => {
    if (e) {
      e.stopPropagation();
      e.preventDefault();
    }
    const isPlaying = royalAudio.getIsPlaying();
    if (isPlaying) {
      userManuallyMuted = true;
      try {
        localStorage.setItem('musicMuted', 'true');
      } catch (err) {}
      royalAudio.setManuallyPaused(true);
      royalAudio.pauseSong((playing) => updateAudioUI(playing));
    } else {
      userManuallyMuted = false;
      try {
        localStorage.setItem('musicMuted', 'false');
      } catch (err) {}
      royalAudio.setManuallyPaused(false);
      royalAudio.playSong((playing) => updateAudioUI(playing));
    }
  };

  musicWidget?.addEventListener('click', handleToggleMusic);
  musicCircleBtn?.addEventListener('click', handleToggleMusic);

